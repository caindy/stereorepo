#!/usr/bin/env python3
"""Queries and displays authenticated GitHub account identity and repository access permissions.

Usage:
    .meta/say/whoami [--role R]

Verifies active credentials, displaying authenticated login, email,
configured role, SSH signing key path, and repository access permission level.
"""
import argparse
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import channel


def whoami() -> None:
    """Displays authenticated user login, email, active role, signing key, and repo permissions."""
    who = channel.gh("api", "user", "--jq", ".login,.id", parse=False).split("\n")
    print("login:", who[0])
    print("email:", f"{who[1]}+{who[0]}@users.noreply.github.com")
    print("role: ", channel.ROLE_ENV.stem if channel.role_credential() else "none, the solo's own auth")
    key = channel.role_signing_key()
    print("sign: ", key if key else "none")
    try:
        print("repo: ", channel.gh("repo", "view", "--json", "nameWithOwner,viewerPermission",
                                   "--jq", '"\\(.nameWithOwner), \\(.viewerPermission)"', parse=False))
    except SystemExit as exc:
        print("repo:  cannot see it —", exc.code)
        print("       a private repository is invisible rather than forbidden, so this "
              "is either no collaborator invite accepted, or a token whose repository "
              "selection does not include it.")


def build_parser() -> argparse.ArgumentParser:
    """Builds the argument parser for whoami."""
    return channel.parser(__doc__)


def main() -> None:
    """Parses arguments and displays role and account identity."""
    args = build_parser().parse_args()
    channel.speak_as(args.role)
    whoami()


if __name__ == "__main__":
    main()
