#!/usr/bin/env python3
"""Speak on GitHub as this Actor, or not at all.

Every comment an agent writes here is posted under its Role's account, so which
Job wrote it is carried by an `Actor:` Trailer and by nothing else. A Trailer that
the writer types is a Trailer the writer can forget — and one was forgotten on
this repository's own pull request, where it read as the solo and manufactured
the second party A16 asks for. That defect is not an oversight to remember
harder about; it is what happens when signing is an act rather than a property
of the channel.

So this is the channel (DR-069). It appends the Trailer itself, from the
environment, and refuses to speak when the environment does not say who is
speaking. There is no
argument for the identity, deliberately: what a caller can pass, a caller can
pass wrongly.

The verbs are the steps of the Disciplines, one each, and not the nouns of `gh`
(DR-116). A step that was two verbs with an order between them — file, then
label; reply, then resolve; open, then link — was a composition a caller could
get wrong, and #113 did. Each is one verb now, and the pieces are not verbs.

    .meta/say file     --title T --difficulty D|--roadmap < body.md
                                               file a Challenge, the form's way: `challenge`
                                               and the difficulty land in one act
    .meta/say triage   <issue> <level>         make an Issue a Challenge at a level: one that
                                               arrived without the form, or a roadmap Issue
                                               whose blocker has closed
    .meta/say difficulty <issue> <level>       move a Challenge's level: easy, medium, hard, human
    .meta/say claim    <issue>                 take an Issue: assign it to this Role's account
    .meta/say stop     <issue> < body.md       where this Job stopped and why; the Issue
                                               goes to the solo as `human`, unclaimed
    .meta/say open     --title T [--base B|--on <pr>] < body.md
                                               open a pull request; --on opens a layer on
                                               that one and links the stack
    .meta/say layer    <pr> --on <pr>          make an open pull request a layer on another
    .meta/say revise   <n> [--title T] [< body.md]   replace a pull request's or an Issue's
                                               body, or its title
    .meta/say commit   -m <subject> [< body]   commit as this Actor, Trailers composed here
    .meta/say comment  <n> < body.md           a comment on a pull request or an Issue
    .meta/say raise    <pr> <path> <line> < body.md    open a thread on the diff
    .meta/say notice   <pr> <path> <line> < body.md    noticed and not done: the marker and
                                               the mention supplied, held open for the solo
    .meta/say reply    <thread-id> < body.md   argue: a reply that leaves the thread open
    .meta/say answer   <thread-id> < body.md   answer: reply, then resolve
    .meta/say promote  <thread-id> --title T --difficulty D < issue-body.md
                                               at merge: file the Issue, with the Issue
                                               form's body, reply with the link, resolve
    .meta/say landed   <pr>                    post what landed for every Challenge the
                                               body closes, rendered from the record
    .meta/say request-review <pr> [--to R]     hand off: request review from Role R's account
    .meta/say --role reviewer review <pr> --approve|--request-changes|--comment < body.md
    .meta/say merge    <pr> [--stack|--auto]    merge; a layer merges everything below it;
                                               --auto arms GitHub to merge when green
    .meta/say advance  [<pr>]                  rebase every armed pull request that has
                                               fallen behind its base back onto it
    .meta/say milestone <issue> --set T|--clear  put an Issue in a Milestone, creating it if new
    .meta/say whoami                           which login this channel speaks as

`--role` names which Role speaks, coder by default: its credential is
`~/.config/solorepo/<role>.env`, and its login is `<owner>-<repo>-<role>`, so a
Role is one word said once (DR-107). `SOLOREPO_ROLE_ENV` names a file outright
and wins.

Bodies come from stdin rather than the command line: the text is usually long,
often has quotes in it, and a shell is the wrong place to keep an artifact.

`answer` and `promote` resolve, and refuse to when this Actor is the sole author
of the thread. PR First says never to, because A16 counts the resolver as a
party (DR-068) and that only holds while the resolver is somebody else. A step
is a rule an agent has to remember; this refuses, which is the same rule with
the remembering taken out — and it refuses before it replies, so the step is
never left half done.
"""
import argparse
import json
import os
import pathlib
import re
import select
import subprocess
import sys

# The pull request gate's rules, held once. `landed` reads *What it closes* by
# the same alternation `check_pr.py` blesses a body with, or a body the gate
# passed is one the channel then calls wrong (#117).
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import check_pr  # noqa: E402

# Outside the tree, per role and per machine (DR-073). `main` points ROLE_ENV at
# the Role named by --role; the environment variable names a file and wins.
ROLE_DIR = pathlib.Path("~/.config/solorepo").expanduser()
ROLE_ENV = pathlib.Path(os.environ.get("SOLOREPO_ROLE_ENV", ROLE_DIR / "coder.env")).expanduser()

ENV_AGENT = ("AI_AGENT",)
ENV_SESSION = ("CLAUDE_CODE_SESSION_ID", "ACTOR_SESSION")


def actor():
    """**Who** is speaking: the session, and nothing else.

    A workload identity, attested for one run (DR-086). A Role account will hold
    the principal identity and say which Role acted; it cannot say which run did
    the work, because one account serves many sessions. The key reads `Actor:`
    because it names the entity, not the identity it carries.

    One Job is one thread, and the session is what identifies it. The harness
    build used to be part of this and was doing a different job badly — it
    changes at every upgrade, so one Actor across an update read as two, while
    the part that actually distinguishes never moved.

    Fail closed. An unsigned comment should be unrepresentable, not discouraged.
    """
    session = next((os.environ[k] for k in ENV_SESSION if os.environ.get(k)), None)
    if not session:
        sys.exit("say: the environment does not say who is speaking "
                 f"(need one of {ENV_SESSION}); refusing to post")
    return session


def agent():
    """**What** is speaking: the harness build, verbatim.

    A different question from `actor`, and a different class — this is a
    Component of a Bill of Materials, which is *supposed* to change when the
    build changes. It is recorded exactly as the environment gives it, because
    `AI_AGENT`'s format is undocumented and prettifying it would be inventing
    structure that nothing attests.

    The model is not here, and not because it was forgotten. Nothing in this
    environment attests it, and configuring it would put a confident falsehood
    in the record the first time a session switches models. A missing identity
    is recoverable; a wrong one is not.
    """
    who = next((os.environ[k] for k in ENV_AGENT if os.environ.get(k)), None)
    if not who:
        sys.exit(f"say: the environment does not say what is speaking "
                 f"(need one of {ENV_AGENT}); refusing to post")
    return who


def role_identity():
    """The Role's git identity, or nothing at all.

    Only when a Role credential is in use. Without one the channel is speaking
    as the solo, and overriding his configured identity to say so would be the
    channel asserting something it was not given.
    """
    if not role_credential():
        return {}
    login, ident = gh("api", "user", "--jq", ".login,.id", parse=False).split("\n")
    email = f"{ident}+{login}@users.noreply.github.com"
    return {"GIT_AUTHOR_NAME": login, "GIT_AUTHOR_EMAIL": email,
            "GIT_COMMITTER_NAME": login, "GIT_COMMITTER_EMAIL": email}


def commit(subject):
    """Commit as this Actor, with the Trailers composed here rather than by a hook.

    The branch nominates the Job, the Trailer nominates the Actor, and the squash
    carries both (DR-062).

    A `prepare-commit-msg` hook did this until DR-074, and it worked by reading
    variables the harness happened to put in the environment. That is inherited
    process ancestry, not a design: it discriminated correctly only because the
    solo's own shell had never been given those variables, which was luck rather
    than a boundary — and had it gone the other way, his commits would have
    carried an `Actor` naming a session he was not part of. A false attestation
    is worse than none, and it looks identical to a real one.

    So the channel composes what it knows. A commit made outside it is unsigned,
    which is honest, and A19 catches it on the pull request — which was always
    where the guarantee lived.
    """
    body = piped()
    message = f"{subject}\n\n{body}\n" if body else f"{subject}\n"
    message += f"\nActor: {actor()}\nAgent: {agent()}\n"
    out = subprocess.run(["git", "commit", "-F", "-"], input=message, text=True,
                         env={**os.environ, **role_identity()})
    sys.exit(out.returncode)


def stacked(pr):
    """Whether a pull request is a layer of a stack, read from GitHub.

    The pull request payload carries a `stack` object on a layer and nothing
    otherwise. `gh pr view` does not expose it, so the endpoint is read.
    """
    return bool(gh("api", f"repos/{repo()}/pulls/{pr}").get("stack"))


def link(below, above):
    """Link one pull request onto another as the layer above it, as the Role.

    Linking is an act GitHub records, like a merge (DR-075), so it goes through
    here, and it is not a verb: a layer is opened linked, `open --on`, or made
    one, `layer --on`, and the link is half of either. Open, then link, was a
    composition a caller assembled by hand and could leave half done (DR-116).
    `gh stack submit` opens pull requests unsigned and stays blocked. After a
    layer merges, GitHub rebases the layers above it, which is the whole reason
    for a stack over a hand-built one (DR-100).
    """
    print(gh("stack", "link", str(below), str(above), parse=False))


def head_branch(pr):
    return gh("pr", "view", str(pr), "--json", "headRefName")["headRefName"]


def layer(pr, below):
    """Make an open pull request a layer on another: retarget its base onto the
    lower layer's branch, and link the two.

    A pull request opened against trunk and found to wait on another (DR-100)
    is retargeted rather than closed and reopened: it is merged, never
    abandoned, and the edit is an act GitHub records. Retargeting without
    linking left a pull request whose base was a branch GitHub would not
    rebase it over when that branch merged; both halves are one verb now.
    """
    base = head_branch(below)
    gh("pr", "edit", str(pr), "--base", base, parse=False)
    now = gh("pr", "view", str(pr), "--json", "baseRefName")["baseRefName"]
    if now != base:
        sys.exit(f"say: GitHub shows #{pr} based on {now} after the call, not {base}")
    link(below, pr)
    print(f"#{pr} is a layer on #{below} ({base})")


def open_pull_request(title, body, base="main", on=None):
    """Open a pull request, signed; with `on`, open it as a layer on that one.

    The base is the lower layer's branch, read from GitHub rather than typed,
    and the link follows the creation, so a layer is never open and unlinked.
    """
    if on:
        base = head_branch(on)
    url = gh("pr", "create", "--title", title, "--base", base, "--body", body, parse=False)
    print(url)
    if on:
        link(on, url.rstrip("/").rsplit("/", 1)[-1])


DIFFICULTIES = ("easy", "medium", "hard", "human")


def labels_of(issue):
    return [l["name"] for l in gh("issue", "view", str(issue), "--json", "labels")["labels"]]


def relabel(issue, add=(), remove=()):
    """Move an Issue's labels, and read back what it carries.

    Not a verb. The labels an agent moves are the difficulty and nothing else,
    and `difficulty` says what a legal move is; a verb that took any label
    took `medium` without `challenge`, which is #113 (DR-116).
    """
    cmd = ["issue", "edit", str(issue)]
    for name in add:
        cmd += ["--add-label", name]
    for name in remove:
        cmd += ["--remove-label", name]
    gh(*cmd, parse=False)
    now = labels_of(issue)
    missing = [n for n in add if n not in now] + [n for n in remove if n in now]
    if missing:
        sys.exit(f"say: GitHub shows #{issue} labelled {now} after the call; {missing} did not take")
    return now


def challenge_labels(issue):
    """An Issue's labels, if it is a Challenge; a refusal if it is not.

    Asked before anything is posted or moved, by every verb whose second half
    needs it: a difficulty on anything but a Challenge is a label no loop will
    ever read, and a comment posted before the refusal is a step half done.
    """
    now = labels_of(issue)
    if "challenge" not in now:
        sys.exit(f"say: #{issue} is not a Challenge (labelled {now or 'nothing'}); a difficulty "
                 "is a Challenge's, and a loop reads it only beside `challenge`. "
                 "`say triage` makes it one, at a level, in one act.")
    return now


def difficulty(issue, level):
    """Set a Challenge's difficulty: the raiser's estimate, moved by the raiser
    downward or by a loop to `human` (DR-112).

    One level at a time, so the Issue never carries two, and never on an Issue
    that is not a Challenge: the coder loop takes an Issue on the event of its
    difficulty landing and only when `challenge` is already there.
    """
    now = challenge_labels(issue)
    others = [l for l in now if l in DIFFICULTIES and l != level]
    now = relabel(issue, add=[level], remove=others)
    print(f"#{issue} is labelled {', '.join(now)}")


def triage(issue, level):
    """Make an Issue a Challenge at a level: `challenge` and the difficulty in
    one act, and `roadmap` off it.

    The door `file` opens at creation, for an Issue that exists already: one
    the solo opened from the web with no form and no labels, which `just next`
    lists as neither kind; or a roadmap Issue whose blocker has closed, which
    the roadmap form says is usually a Challenge and which closing and refiling
    would strip of its number, its thread and the reason it was deferred.

    A difficulty already on the Issue — #113's state, the level with no
    `challenge` beside it — is taken off first and put back with `challenge`,
    so the event the coder loop reads fires: GitHub emits nothing for a label
    an Issue already carries.
    """
    now = labels_of(issue)
    if "challenge" in now:
        sys.exit(f"say: #{issue} is a Challenge already (labelled {now}); "
                 "`say difficulty` moves its level")
    if level in now:
        relabel(issue, remove=[level])
    stale = [l for l in now if l == "roadmap" or (l in DIFFICULTIES and l != level)]
    now = relabel(issue, add=["challenge", level], remove=stale)
    print(f"#{issue} is a Challenge, labelled {', '.join(now)}")


def file_issue(title, body, level=None, roadmap=False):
    """File a Challenge or a roadmap Issue the way the form does.

    The form's front matter applies `challenge` at creation and the raiser adds
    a difficulty; through the channel both land in one `create`, so there is
    no moment when the difficulty is on an Issue that is not yet a Challenge —
    the moment the coder loop's event fell into on #113. A roadmap Issue takes
    `roadmap` and no difficulty, since it is deferred by definition.

    A label supplied at creation fires `labeled` like any other, one delivery
    per label beside `opened` — GitHub's workflow reference says so in as many
    words — so one act here is the one event `coder.yml` watches.

    The first line is read before anything is created. `just next` reads
    `**Waits on.**` from the first line of both forms (DR-114), and an Issue
    filed without it waits on nothing anyone can see.
    """
    first = body.lstrip().split("\n", 1)[0]
    if not first.startswith("**Waits on.**"):
        sys.exit("say: the body does not open with `**Waits on.**`, which is the line "
                 f"`just next` reads; it opens with {first[:60]!r}. Both forms begin there.")
    labels = ["roadmap"] if roadmap else ["challenge", level]
    cmd = ["issue", "create", "--title", title, "--body", body]
    for name in labels:
        cmd += ["--label", name]
    url = gh(*cmd, parse=False)
    number = url.rstrip("/").rsplit("/", 1)[-1]
    now = labels_of(number)
    if any(l not in now for l in labels):
        sys.exit(f"say: GitHub shows #{number} labelled {now} after the call, not {labels}")
    print(url)
    return number, url


def stop(issue, body):
    """Where a loop stopped and why, handed to the solo (DR-112): the refusal,
    the comment, the release, the move to `human`.

    The order is by what a failure after each act leaves behind. The refusal
    before anything is posted, or a retry posts the comment twice. The comment
    before the rest, so the Issue carries an account of where the loop stopped
    whatever fails next. The release before the move: a failed move leaves an
    unclaimed Issue at its old level, which the comment explains and a raiser
    can re-deliver; a failed release after the move would leave `human` and
    claimed, the one state the coder loop's guard reads as a run still
    standing (#117). The pull request stays open — merged, never abandoned —
    for the run that takes the Issue up again.
    """
    challenge_labels(issue)
    conversation_comment(issue, body)
    release(issue)
    difficulty(issue, "human")


def release(issue):
    """Take this Role's assignment off an Issue, and read back.

    The claim says a run is standing on this. The coder loop's guard reads it
    beside the open pull request to tell a level moved under a run from a
    hand-back the solo has answered (#117); a claim left standing after a
    hand-back is the loop saying it has stopped and is still working at once.
    """
    login = gh("api", "user", "--jq", ".login", parse=False)
    gh("issue", "edit", str(issue), "--remove-assignee", login, parse=False)
    who = [a["login"] for a in gh("issue", "view", str(issue), "--json", "assignees")["assignees"]]
    if login in who:
        sys.exit(f"say: GitHub shows #{issue} still assigned to {login} after the call")
    print(f"released #{issue}; it is assigned to {', '.join(who) or 'nobody'}")


def kind(number):
    """Pull request or Issue, asked of GitHub. The numbers are one sequence and
    the verbs that take either — `comment`, `revise` — should not make a
    caller say which."""
    found = gh("api", f"repos/{repo()}/issues/{number}")
    return "pull request" if found.get("pull_request") else "issue"


def conversation_comment(number, body):
    """A comment on a pull request's conversation or an Issue's — the same
    endpoint on GitHub, which is why one verb serves both."""
    made = gh("api", f"repos/{repo()}/issues/{number}/comments", "-f", f"body={body}")
    print(made["html_url"])


def revise(number, body=None, title=None):
    """Replace a body or a title, on a pull request or an Issue.

    A body is signed at creation and nowhere afterwards, so an edit that
    bypassed the channel would leave a Trailer naming the wrong Actor under
    prose that Actor never wrote. The title is what the index is worth, and
    changing it is an act GitHub records.
    """
    if body is None and title is None:
        sys.exit("say: nothing to revise — pipe a body in, or pass --title")
    what = kind(number)
    noun = "pr" if what == "pull request" else "issue"
    cmd = [noun, "edit", str(number)]
    if title is not None:
        cmd += ["--title", title]
    if body is not None:
        cmd += ["--body", body]
    gh(*cmd, parse=False)
    print(f"{what} #{number}: {' and '.join(w for w, v in (('body', body), ('title', title)) if v is not None)} set")


NOTICED = "**Noticed and not done.**"


def solo():
    """The account the repository belongs to: the party a parked conversation
    is addressed to."""
    return gh("repo", "view", "--json", "owner")["owner"]["login"]


def raise_thread(pr, path, line, body):
    """Open a thread on a line of the diff, at the pull request's head.

    The pull request's head, not this worktree's. They are usually the same
    and the failure when they are not is opaque: GitHub rejects a comment
    whose commit is not part of the pull request.
    """
    head = gh("pr", "view", str(pr), "--json", "headRefOid", "--jq", ".headRefOid", parse=False)
    made = gh("api", f"repos/{repo()}/pulls/{pr}/comments",
              "-f", f"body={body}", "-f", f"commit_id={head}",
              "-f", f"path={path}", "-F", f"line={line}")
    print(made["html_url"])


def notice(pr, path, line, text):
    """Work noticed and not done, as a conversation on the diff (A15).

    PR First's step: raise it where it was noticed, tagging the solo and
    opening with the marker. The marker is what tells a thread held open on
    purpose from one owed an answer, and `check_pr.py` reads it from the
    *last* comment; the mention is who decides what it is. Both are supplied
    here rather than typed, so a notice is never one a reader mistakes for a
    question (DR-116).
    """
    raise_thread(pr, path, line, signed(f"{NOTICED} @{solo()}\n\n{text}"))


def refuse_if_sole_author(thread_id):
    bodies = thread_comments(thread_id)
    if bodies is None:
        sys.exit(f"say: GitHub has no review thread {thread_id}")
    if sole_author(bodies):
        sys.exit("say: refusing — you are the sole author of this thread, and a reply from you "
                 "would not change that. A16 counts the resolver as a party, which means "
                 "nothing when it is you. Ask the solo to resolve it, or leave it for the next "
                 "Job, whose Trailer differs.")


def reply(thread_id, body):
    print(graphql(REPLY, t=thread_id, b=body)
          ["data"]["addPullRequestReviewThreadReply"]["comment"]["url"])


def resolve(thread_id):
    graphql(RESOLVE, t=thread_id)
    print("resolved")


def answer(thread_id, body):
    """Reply, then resolve: PR First's step, whole.

    A thread answered and left open reads as one still owed something, and
    one resolved without an answer is A16's defect; the step is both, and
    the verb is both. The sole-author refusal is asked before anything is
    posted: a reply that goes out and a resolve that then refuses is the step
    half done, which is the shape this verb exists to make untypeable.
    """
    refuse_if_sole_author(thread_id)
    reply(thread_id, body)
    resolve(thread_id)


def promote(thread_id, title, body, level):
    """At merge: what survived the argument earns an Issue, and the thread is
    resolved with a link to it (PR First).

    File, reply, resolve, in that order and with the refusal first, so the
    Issue exists before the thread says it does and nothing is filed for a
    thread this Actor could not close. The body is the Issue form's, not the
    thread's: it opens with `**Waits on.**` like anything `file` takes, since
    what is promoted is an Issue and the thread is where it was found.
    """
    refuse_if_sole_author(thread_id)
    # The link, not the number: `check_pr.py` reads a promotion in the one
    # form it can check, the Issue's URL, and a bare `#n` is what someone types
    # when referring to an Issue rather than when filing one.
    _, url = file_issue(title, body, level=level)
    reply(thread_id, signed(f"Promoted to {url}."))
    resolve(thread_id)


def closed_by(pr):
    """The Challenges a pull request's body closes, by the gate's own rule.

    `check_pr.py` blesses the heading: one bullet per item, each carrying a
    closing keyword and one of the three references GitHub closes on, or an
    explicit `None.`. The same objects read it here, so a body the required
    check passed is never one this verb calls wrong. `None` is the answer for a
    body that says it closes nothing, and an empty list is a body that named
    nothing the gate would accept.

    The near-miss is the heading present and its section empty, since
    `check_pr.check()` guards its closing rule on `closing` being truthy and
    that rule would pass it. It fails the gate one rule earlier, as a required
    section left blank — the form submitted with nothing in it — so the parity
    holds through that body too and the refusal in `landed` is not reached on
    one the gate blessed (#117).
    """
    body = gh("pr", "view", str(pr), "--json", "body")["body"] or ""
    found = check_pr.sections(body)
    if check_pr.CLOSES not in found:
        sys.exit(f"say: #{pr}'s body has no **{check_pr.CLOSES}.**; the form has one")
    closing = found[check_pr.CLOSES]
    if check_pr.NONE.match(closing):
        return None
    numbers = []
    for item in check_pr.BULLET.finditer(closing):
        ref = check_pr.KEYWORD.search(item.group(1))
        if ref:
            numbers.append(re.search(r"(\d+)$", ref.group(0)).group(1))
    return list(dict.fromkeys(numbers))


def landed(pr):
    """Post what landed for every Challenge the pull request closes, rendered
    from the record and never typed (PR First, DR-084).

    One comment per Challenge the record asserts. A body that says `None.`
    closes nothing and has nothing to post, which is allowed and is a question
    the form asks; a Challenge with no `assertions/challenges/<n>.yaml` has
    nothing to post either, and is the common case rather than the rare one,
    so it is said here and not posted — the renderer's line for it is about
    the assertion directory, not the work, and on a pull request it reads as
    a tool error. Neither is a refusal, since the coder loop runs this on
    every pull request and every pass. `render.py --landed` is run rather
    than imported: it needs `yaml`, which this interpreter may not have, and
    `uvx` is how the rest of the tree runs it.
    """
    numbers = closed_by(pr)
    if numbers is None:
        print(f"#{pr} closes nothing, and says so; nothing to post")
        return
    if not numbers:
        sys.exit(f"say: nothing under #{pr}'s **{check_pr.CLOSES}.** carries a closing keyword "
                 "and a reference; the gate would say the same")
    root = pathlib.Path(__file__).resolve().parent.parent
    for number in numbers:
        if not (root / ".meta" / "assertions" / "challenges" / f"{number}.yaml").exists():
            print(f"#{number} is not asserted as a Challenge; nothing to post for it")
            continue
        out = subprocess.run(["uvx", "--with", "pyyaml", "python", ".meta/render.py", "--landed", number],
                             cwd=root, capture_output=True, text=True)
        if out.returncode:
            sys.exit(f"say: render.py --landed {number} failed: {out.stderr.strip()}")
        conversation_comment(pr, signed(out.stdout))


def arm(pr, subject):
    """Hand GitHub the intent to merge when the ruleset is satisfied.

    One call, and two callers: the merge verb arming for the first time, and
    `advance` arming again where moving the branch dropped it.
    """
    gh("pr", "merge", pr, "--squash", "--auto", "--subject", subject, parse=False)


def behind_by(pull):
    """How many commits of its base a pull request's head is missing.

    `mergeStateStatus` is the obvious question and answers a different one.
    GitHub computes it when it is asked for, so the first read after a push to
    trunk is `UNKNOWN`; and `BLOCKED` outranks `BEHIND`, so a pull request
    waiting on a review reports the review and hides the fact that it is also
    out of date — which is every `medium` pull request (DR-112), and the case
    where nobody is watching. A comparison answers what is actually being
    decided: whether the head is missing commits the base has. GitHub answers
    that the same way whatever else is outstanding.
    """
    return gh("api", f"repos/{repo()}/compare/"
                     f"{pull['baseRefName']}...{pull['headRefOid']}")["behind_by"]


ADVANCE = "number,title,baseRefName,headRefOid,autoMergeRequest"


def advance(pr=None, held=False):
    """Bring armed pull requests that have fallen behind their base back onto it.

    An armed merge does not update its own branch, and `main` requires a pull
    request to be current before it merges. So when two are green at once the
    first lands and the second goes behind, armed, waiting for a Job that ended
    when it armed — and nobody is told, because there is nobody left to tell
    (#93). This is the step that moves it. `merge --auto` runs it before
    arming, since a branch can be behind before it is armed as easily as
    after; the other edge is `.github/workflows/advance.yml`, which runs this
    on every push to trunk, the one event that puts a pull request in that
    state (DR-113). Both edges are covered, so nobody should have to type this
    — it takes a pull request number for the day one is behind for a reason
    neither edge saw.

    **Armed, and nothing else**, whether one pull request was named or none.
    A pull request nobody has asked to land is not waiting on anything, and the
    rebase below rewrites commits under whatever session still holds the branch.
    Arming is the last act of the Job that did the work (DR-112), so an armed
    branch is one nobody is still standing on. The filter used to be the sweep's
    alone and the explicit argument rebased whatever it was handed — which left
    the property holding on the path nothing calls and not on the one
    `merge --auto` uses (#98).

    `held` is the one exemption, and it is the caller saying which branch it is
    standing on: `merge --auto` is the Job that did the work, arming in a moment,
    so for that call the question the arming answers is already answered. It is
    an argument of the function and not of the verb, because what a caller can
    pass a typed command can pass wrongly, and by hand this is only ever wanted
    for a pull request that stalled — which is to say an armed one.

    **By rebase, not by a merge commit.** GitHub authors the merge commit
    itself and it carries no `Actor` Trailer, so A19 would turn the required
    check red on the very branch this is unblocking — the fix would be the
    defect wearing a new coat. A rebase writes no new commit: the branch's own
    commits move onto the base with their messages, and so with their Trailers,
    intact.

    Read back, per A6: the outcome is what GitHub holds afterwards, not what
    `gh` returned. Three things are asked, and they are asked independently.
    Whether the head is current now — the base can move again while this runs,
    and a second push is a second run's business, not a silent pass. Whether
    the arming survived the head moving: GitHub drops auto-merge on some pushes
    to a head branch, and an update that disarmed what it was unblocking would
    leave the pull request exactly where it was found, with the sole witness
    gone. The second used to hang off the first as an `elif`, so the one state
    it exists to repair — moved, disarmed, and behind again — was the one state
    it never looked at (#98). And whether re-arming took, which is the same
    question `merge --auto` asks of its own arming and the one this path was
    still answering from an exit code.

    **One pull request's refusal is not the sweep's.** `gh()` reports by ending
    the process, so a branch GitHub will not rebase, or will not arm, used to
    take every other pull request down with it and swallow what had already been
    collected. Each is caught where it happens and joins `failed`, which is what
    the accumulator was for.
    """
    if pr is not None:
        found = [gh("pr", "view", pr, "--json", ADVANCE)]
    else:
        found = gh("pr", "list", "--state", "open", "--json", ADVANCE)
    if not held:
        found = [p for p in found if p.get("autoMergeRequest")]
    if not found:
        # Two answers, and only one of them is "nothing to do". A sweep with
        # nothing armed open did its whole job and exits 0. A named pull request
        # that is not armed is a *refusal* — the caller asked for one thing and
        # the verb declined it — and every other refusal in this file exits
        # non-zero. `main()` passes no `held`, so for a typed `advance <pr>`
        # this is the terminal answer; sharing an exit code with the sweep is
        # how `.meta/say advance 92 && <next>` carries on as though the branch
        # had moved.
        if pr is not None:
            sys.exit(f"say: #{pr} is not armed; nothing has asked it to land")
        print("advance: nothing armed is open")
        return
    moved, failed = 0, []
    for pull in found:
        number = str(pull["number"])
        try:
            behind = behind_by(pull)
            if not behind:
                continue
            gh("pr", "update-branch", number, "--rebase", parse=False)
            moved += 1
            print(f"advanced #{number}: {behind} commit(s) behind {pull['baseRefName']} "
                  f"— {pull['title']}")
            after = gh("pr", "view", number, "--json", ADVANCE)
            if behind_by(after):
                failed.append(f"#{number} is still behind {pull['baseRefName']} after the update")
            if pull.get("autoMergeRequest") and not after.get("autoMergeRequest"):
                arm(number, f"{pull['title']} (#{number})")
                # Read back, like the two above and for the same reason. This
                # was the one act in the function whose outcome was `gh`'s exit
                # status: `gh pr merge --auto` exits 0, the enablement does not
                # stick, and the line below claimed an arming GitHub does not
                # hold. That leaves the pull request rebased and unarmed, which
                # is #93 — and unreachable by any later sweep, because the sweep
                # filters on `autoMergeRequest` and there is no longer one to
                # filter on.
                if not gh("pr", "view", number, "--json", ADVANCE).get("autoMergeRequest"):
                    failed.append(f"#{number} lost its arming to the update and GitHub does not "
                                  "show it armed after the call that re-armed it")
                else:
                    print(f"armed #{number} again: moving the head had dropped it")
        except SystemExit as exc:
            failed.append(f"#{number}: {exc.code}")
    if not moved and not failed:
        print(f"advance: {len(found)} pull request(s) current with their base")
    if failed:
        sys.exit("say: " + "; ".join(failed))


def merge(pr, stack=False, auto=False):
    """Merge as the Role, label trunk with the pull request's title, and report
    what GitHub holds afterwards. With `stack`, merge every layer up to and
    including this one, atomically, and let GitHub rebase the rest.

    Not an utterance, and still the channel's. Merging is an act by the Role —
    DR-072 puts it in an agent's hands and DR-075 puts the act through here — so
    it is the Role that GitHub should record as having done it, and the squash
    commit that lands on trunk carries that account rather than the solo's.

    The subject is passed rather than left to GitHub. Left to it, GitHub labels
    the squash from the commits, and #27 landed on `main` under a subject that
    was not its title (#26), which is the label the index carries — and a label
    on trunk cannot be rewritten. The body is left to GitHub, so the Trailers on
    the branch's commits ride into the squash as before (DR-062).

    `--delete-branch` is not used. It makes `gh` check out `main` locally after
    the merge, which fails from a worktree because `main` is already checked out
    elsewhere — and it fails *after* the merge, so the exit code said the act
    had failed when it had not. The remote branch is deleted here instead, and
    the local checkout is left alone — unless the repository deletes head
    branches itself, which this one does. The first run of this verb (#46)
    deleted a ref GitHub had already removed, and exited 1 on a merge that had
    landed, which is the defect it was written to remove wearing a new coat. So
    the setting is read, and the verb deletes nothing the repository will.

    The outcome is read back from GitHub, per A6: a step's result is what it
    found, not what its last subprocess returned.

    `--auto` is "when green" (#79). A merge refused for pending checks was one
    somebody had to remember to retry, and on #76 the retry came thirty-six
    minutes after the checks passed. GitHub holds the intent instead: the
    squash and its subject are handed over now, and the merge happens the
    moment the ruleset is satisfied, watched or not. Not on a layer of a stack:
    a layer's base is the layer below, and armed early it would merge into
    that branch the moment it was green rather than into trunk after it.
    """
    before = gh("pr", "view", pr, "--json", "title,state,headRefName")
    if before["state"] != "OPEN":
        sys.exit(f"say: #{pr} is {before['state'].lower()}, not open")
    subject = f"{before['title']} (#{pr})"
    if auto:
        if stack or stacked(pr):
            # The bottom included: GitHub refuses auto-merge on any stacked
            # pull request ("Auto-merge is not supported for stacked pull
            # requests"), so a stack lands by `merge --stack`, by hand, when
            # its bottom is green (#117).
            sys.exit(f"say: #{pr} is in a stack, and GitHub does not arm a stacked pull request, "
                     "bottom included. Merge it with --stack when it is green, and GitHub "
                     "retargets the layers above as it lands.")
        if not gh("api", f"repos/{repo()}").get("allow_auto_merge"):
            sys.exit("say: this repository does not allow auto-merge; that is a setting on "
                     "GitHub, not a line here")
        # Arming a branch that is already behind arms something that cannot
        # merge, and the push to trunk that would have advanced it has already
        # happened (#93). The other edge — falling behind after arming — is
        # the workflow's. `held`, because this is the Job that did the work and
        # the branch is its own; nothing else may rebase an unarmed branch.
        #
        # And the arming happens whether or not that worked. `advance` ends in
        # `sys.exit` on a read-back that failed and on any refusal `gh` made,
        # and outside this `try` every one of those exits left the branch
        # rebased and never armed — #93's state, reached by the fix for it, with
        # no second run coming because arming is where the Job ends (#98).
        # Armed and behind is the recoverable half: the next push to trunk
        # sweeps it up, precisely because it is armed. So the stall is carried
        # to the end and reported there, after the arming it must not prevent —
        # and it is carried as a *reason*, not as a state. What state the pull
        # request ended in is asked of GitHub at each of the three places
        # below, because the stall is the exit code of a verb that makes four
        # or five calls and says nothing about which of them refused.
        stalled = None
        try:
            advance(pr, held=True)
        except SystemExit as exc:
            stalled = str(exc.code)
        try:
            arm(pr, subject)
        except SystemExit as exc:
            # Already mergeable: GitHub refuses to arm what it could just do,
            # in these words, and the plain merge below is the right act. A
            # stall recorded above goes no further from here, and cannot
            # survive: clean is GitHub saying the branch is current, which is
            # the opposite of what stalled would claim.
            if "clean status" not in str(exc.code):
                raise
        else:
            after = gh("pr", "view", pr, "--json", "state,mergeCommit,autoMergeRequest")
            if after["state"] == "MERGED":
                # A stall recorded above is moot here and dies with this branch.
                # Not every refusal `advance` collects is a branch that is
                # genuinely behind — an API blip on a `pr view` or a `compare`
                # is one too — and GitHub having merged the pull request is the
                # end of the question either way. Reported here it would print
                # `merged #<n> as <sha>` and then exit 1 saying the pull request
                # is armed and not current with its base, both clauses false:
                # #46's defect wearing a new coat, which is what this verb was
                # written to remove.
                print(f"merged #{pr} as {after['mergeCommit']['oid'][:7]} — {before['title']}")
            elif after.get("autoMergeRequest"):
                print(f"armed: #{pr} merges as a squash when green — {before['title']}")
                # Armed and behind is the one state the message describes, and
                # reaching this branch establishes only its first half:
                # `after.get("autoMergeRequest")` is GitHub saying it is armed,
                # and nothing since `advance` failed has asked whether the head
                # is current. `stalled` cannot answer it — it is every refusal
                # `advance` collected, and most of them say nothing about the
                # head: a `gh` blip on the read-back `compare`, one HTTP error
                # away out of the four or five calls that verb makes, or an
                # arming that did not stick and that the `arm` above has since
                # made take. Both leave the branch armed and current, and the
                # exit code here is the last thing the Job says — a non-zero
                # over a pull request GitHub is holding correctly armed tells
                # the loop the landing failed when it did not. So the currency
                # is re-asked, one `compare`, and the exit is conditional on
                # the answer rather than on how the stall was reached.
                if stalled:
                    try:
                        current = gh("pr", "view", pr, "--json", ADVANCE)
                        behind = behind_by(current)
                    except SystemExit as exc:
                        sys.exit(f"say: #{pr} is armed, and advancing it did not finish — "
                                 f"{stalled}. GitHub would not say whether it is current "
                                 f"either — {exc.code}")
                    if behind:
                        sys.exit(f"say: #{pr} is armed and {behind} commit(s) behind "
                                 f"{current['baseRefName']} — {stalled}")
                    # Armed and current is the state the Job was for, so the
                    # stall is reported and not exited on: it is a reason
                    # something took two attempts, not a landing that failed.
                    print(f"#{pr} is armed and current with {current['baseRefName']}; "
                          f"advancing it did not finish — {stalled}")
            else:
                sys.exit(f"say: GitHub shows #{pr} neither merged nor armed after the call")
            return
    if stack:
        # GitHub's stack merge: everything up to and including this layer, all
        # or nothing, and the layers above are rebased by GitHub rather than by
        # hand (DR-100). It takes no subject; trunk's label rests on the
        # repository's squash-title setting, which is why the label is read
        # back below rather than assumed.
        gh("stack", "merge", pr, "--squash", "--yes", parse=False)
    elif stacked(pr):
        sys.exit(f"say: #{pr} is a layer of a stack; the legacy merge cannot take it. "
                 "Pass --stack to merge everything up to it.")
    else:
        gh("pr", "merge", pr, "--squash", "--subject", subject, parse=False)
    after = gh("pr", "view", pr, "--json", "state,mergeCommit")
    if after["state"] != "MERGED":
        sys.exit(f"say: #{pr} is {after['state'].lower()} after the merge call; not deleting the branch")
    print(f"merged #{pr} as {after['mergeCommit']['oid'][:7]} — {before['title']}")
    branch = before["headRefName"]
    if gh("repo", "view", "--json", "deleteBranchOnMerge")["deleteBranchOnMerge"]:
        print(f"GitHub deletes origin/{branch} on merge; nothing to do here")
    else:
        gh("api", "-X", "DELETE", f"repos/{repo()}/git/refs/heads/{branch}", parse=False)
        print(f"deleted origin/{branch}")


def role_login(role):
    """The account a Role holds, by name and not by reading anything.

    `<owner>-<repo>-<role>` is DR-107's convention, and it is what lets the
    coder name the reviewer without touching the reviewer's token — which on
    this machine it could read, and must not.
    """
    return f"{repo().replace('/', '-')}-{role}"


def request_review(pr, to):
    """The handoff: request review from the next Role's account.

    A semaphore, not a message. GitHub holds the request and reports it, so the
    arriving Job finds its work by asking what has been requested of its login.
    Read back afterwards, per A6: the act is what GitHub shows, not what `gh`
    returned.

    A request already pending is withdrawn first. GitHub emits no event for
    a reviewer it already lists, so a Job whose run answered nothing left the
    request standing and a second ask went nowhere (#87). Withdrawing and
    asking again is the same semaphore raised twice, and the event fires.
    """
    login = role_login(to)

    def asked():
        return [r.get("login") for r in gh("pr", "view", pr, "--json", "reviewRequests")["reviewRequests"]]

    again = login in asked()
    if again:
        gh("pr", "edit", pr, "--remove-reviewer", login, parse=False)
    gh("pr", "edit", pr, "--add-reviewer", login, parse=False)
    if login not in asked():
        sys.exit(f"say: GitHub shows {asked() or 'nobody'} requested on #{pr} after the call, not {login}")
    print(f"{'requested again' if again else 'requested'} review of #{pr} from {login}")


def review(pr, verdict):
    """The reviewer's answer, as the Role: approve, request changes, or comment.

    An approval may carry no body — the act is the answer — and the other two
    cannot, which GitHub enforces and this does not repeat. Whatever body there
    is arrives signed like every other utterance.
    """
    body = piped()
    if not body and verdict != "approve":
        sys.exit("say: nothing on stdin — a review that is not an approval says why")
    cmd = ["pr", "review", pr, f"--{verdict}"]
    if body:
        cmd += ["--body", signed(body)]
    gh(*cmd, parse=False)
    latest = gh("pr", "view", pr, "--json", "reviews")["reviews"]
    print(f"reviewed #{pr}: {latest[-1]['state'].lower() if latest else 'GitHub shows no review'}")


def claim(issue):
    """Take an Issue: assign it to this Role's account, and read back.

    A loop claims by assignment (DR-112). It is an act GitHub records, so it
    goes through here, as the Role whose token this is.
    """
    login = gh("api", "user", "--jq", ".login", parse=False)
    gh("issue", "edit", issue, "--add-assignee", login, parse=False)
    who = [a["login"] for a in gh("issue", "view", issue, "--json", "assignees")["assignees"]]
    if login not in who:
        sys.exit(f"say: GitHub shows #{issue} assigned to {who or 'nobody'} after the call, not {login}")
    print(f"claimed #{issue} as {login}")


def milestone(issue, title, clear=False):
    """Put an Issue in a Milestone, creating the Milestone when it is new, and
    read back.

    A Milestone is where the priority between Issues is written once (DR-114);
    `just next` lists the lowest-numbered open one as next. Creating one is an
    act GitHub records against an account, and `gh` has no verb for it, so it
    goes through here like every other write.
    """
    if clear:
        gh("issue", "edit", issue, "--milestone", "", parse=False)
        now = gh("issue", "view", issue, "--json", "milestone")["milestone"]
        if now:
            sys.exit(f"say: GitHub shows #{issue} still in {now['title']!r} after the call")
        print(f"#{issue} is in no Milestone")
        return
    existing = [m["title"] for m in gh("api", "repos/{owner}/{repo}/milestones?state=all&per_page=100")]
    if title not in existing:
        gh("api", "repos/{owner}/{repo}/milestones", "-f", f"title={title}", parse=False)
        print(f"created Milestone {title!r}")
    gh("issue", "edit", issue, "--milestone", title, parse=False)
    now = gh("issue", "view", issue, "--json", "milestone")["milestone"]
    if not now or now["title"] != title:
        sys.exit(f"say: GitHub shows #{issue} in {now and now['title']!r} after the call, not {title!r}")
    print(f"#{issue} is in Milestone {title!r}")


def trailers():
    """The block this channel signs with, defined once because two readers need
    it: the one that writes it, and the one that recognises it."""
    return f"Actor: {actor()}\nAgent: {agent()}"


def signed(text):
    body = text.rstrip("\n")
    block = trailers()
    return body if body.endswith(block) else f"{body}\n\n{block}\n"


def piped(timeout=0.5):
    """Whatever was piped in, or nothing — but never a wait for input that will
    not come.

    A plain `sys.stdin.read()` hangs forever when this is run by a tool harness:
    stdin is neither a terminal nor closed, so `isatty()` says pipe and the read
    blocks on a pipe nobody is writing to. Five minutes of a session went that
    way. Ask whether anything is actually readable first.
    """
    if sys.stdin.isatty():
        return ""
    ready, _, _ = select.select([sys.stdin], [], [], timeout)
    return sys.stdin.read().strip() if ready else ""


def stdin_body():
    text = piped()
    if not text:
        sys.exit("say: nothing on stdin — pipe the body in, or redirect a file")
    return text


def role_credential():
    """The token for the Role this machine holds, from outside the working tree.

    Outside because a token in the tree is one `git add -A` from being published,
    and per role and per machine because that is what the credential is: a Remit
    bound where the work happens. It is read here and handed to one child
    process, so nothing exports it into the environment of every other command.

    It is not a boundary on this machine. Anything with a shell can read this
    file, so the wrapper is the only path by convention until an agent runs
    somewhere it cannot reach the solo's credentials at all. What it does buy is
    that GitHub can tell the Role from the solo, and that the fallback is
    visible rather than silent.
    """
    if not ROLE_ENV.exists():
        print(f"say: no {ROLE_ENV}; speaking with ambient auth, which is the solo",
              file=sys.stderr)
        return {}
    mode = ROLE_ENV.stat().st_mode
    if mode & 0o077:
        sys.exit(f"say: {ROLE_ENV} is readable by others (mode {mode & 0o777:o}); "
                 f"refusing to use it. chmod 600 it.")
    found = {}
    for line in ROLE_ENV.read_text().splitlines():
        line = line.strip().removeprefix("export ").strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        found[key.strip()] = value.strip().strip("\"'")
    if not found.get("GH_TOKEN"):
        # Empty counts as missing. A secret that was never set arrives as an
        # empty string, and the first run of review.yml (#84) passed this
        # check with one and failed further down, in gh's words rather than
        # this file's.
        sys.exit(f"say: {ROLE_ENV} has no GH_TOKEN")
    print(f"say: speaking with the credential in {ROLE_ENV}", file=sys.stderr)
    return {"GH_TOKEN": found["GH_TOKEN"]}


def gh(*args, parse=True):
    out = subprocess.run(["gh", *args], capture_output=True, text=True,
                         env={**os.environ, **role_credential()})
    if out.returncode:
        sys.exit(f"gh: {out.stderr.strip()}")
    return json.loads(out.stdout) if parse and out.stdout.strip() else out.stdout.strip()


def graphql(query, **variables):
    args = ["api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        args += ["-F", f"{key}={value}"]
    return gh(*args)


def repo():
    return gh("repo", "view", "--json", "nameWithOwner")["nameWithOwner"]


THREAD = """
query($id: ID!) {
  node(id: $id) {
    ... on PullRequestReviewThread { comments(first: 100) { nodes { body } } }
  }
}
"""

REPLY = """
mutation($t: ID!, $b: String!) {
  addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $t, body: $b}) {
    comment { url }
  }
}
"""

RESOLVE = """
mutation($t: ID!) { resolveReviewThread(input: {threadId: $t}) { thread { isResolved } } }
"""


def thread_comments(thread_id):
    """Every comment in one thread, asked for by id.

    The first version scanned every open pull request looking for the id, on the
    belief that GitHub had no by-id query. It has: a review thread is a `node`
    like anything else. Scanning was several calls, and it silently depended on
    the thread being in the first hundred of a pull request that was still open.
    """
    node = graphql(THREAD, id=thread_id)["data"]["node"]
    if not node:
        return None
    return [c["body"] or "" for c in node["comments"]["nodes"]]


def sole_author(bodies):
    """True when every comment *ends with* this Actor's Trailer and no other voice.

    Ends with, rather than contains: a comment quoting the Trailer — a reply
    discussing attribution, say, which this repository produces constantly —
    would otherwise be read as having been written by whoever it quoted.

    An unsigned comment counts as somebody else — that is the human, who signs
    nothing. The false pass this rule exists to prevent went the other way: an
    agent's *own* unsigned comment read as the human and made a second party out
    of nothing. Here that failure is impossible, because everything this channel
    posts is signed by construction.
    """
    block = trailers()
    return bool(bodies) and all(b.rstrip().endswith(block) for b in bodies)


def build_parser():
    """The parser alone, so a probe can check what each verb accepts without
    running what it dispatches to (#95: the mutually exclusive verdict group
    landed on the wrong verb because both reused the loop variable `p`, and
    nothing parsed a verb without also calling `gh`)."""
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--role", default="coder",
                    help="which Role speaks: ~/.config/solorepo/<role>.env (default coder)")
    sub = ap.add_subparsers(dest="verb", required=True)

    # An Issue's life: filed, its difficulty moved, claimed, or handed back.
    p = sub.add_parser("file"); p.add_argument("--title", required=True)
    what = p.add_mutually_exclusive_group(required=True)
    what.add_argument("--difficulty", choices=DIFFICULTIES, dest="level", help="a Challenge, at this level")
    what.add_argument("--roadmap", action="store_true", help="a roadmap Issue: intended and deferred")
    p = sub.add_parser("triage"); p.add_argument("issue"); p.add_argument("level", choices=DIFFICULTIES)
    p = sub.add_parser("difficulty"); p.add_argument("issue"); p.add_argument("level", choices=DIFFICULTIES)
    p = sub.add_parser("claim"); p.add_argument("issue")
    p = sub.add_parser("stop"); p.add_argument("issue")

    # A pull request's: opened, layered, revised, committed to, merged.
    p = sub.add_parser("open"); p.add_argument("--title", required=True)
    where = p.add_mutually_exclusive_group()
    where.add_argument("--base", default="main")
    where.add_argument("--on", help="open as a layer on this pull request, and link the stack")
    p = sub.add_parser("layer"); p.add_argument("pr"); p.add_argument("--on", required=True)
    p = sub.add_parser("revise"); p.add_argument("number"); p.add_argument("--title")
    p = sub.add_parser("commit"); p.add_argument("-m", "--message", required=True)
    p = sub.add_parser("merge"); p.add_argument("pr"); p.add_argument("--stack", action="store_true")
    p.add_argument("--auto", action="store_true", help="arm GitHub to merge when green")
    p = sub.add_parser("advance")
    p.add_argument("pr", nargs="?", help="one pull request; every armed one by default")

    # The argument: comment, raise, notice, reply, answer, promote, landed.
    p = sub.add_parser("comment"); p.add_argument("number")
    p = sub.add_parser("raise"); p.add_argument("pr"); p.add_argument("path"); p.add_argument("line", type=int)
    p = sub.add_parser("notice"); p.add_argument("pr"); p.add_argument("path"); p.add_argument("line", type=int)
    p = sub.add_parser("reply"); p.add_argument("thread")
    p = sub.add_parser("answer"); p.add_argument("thread")
    p = sub.add_parser("promote"); p.add_argument("thread"); p.add_argument("--title", required=True)
    p.add_argument("--difficulty", choices=DIFFICULTIES, dest="level", required=True)
    p = sub.add_parser("landed"); p.add_argument("pr")

    # The handoff, and its answer.
    p = sub.add_parser("request-review"); p.add_argument("pr"); p.add_argument("--to", default="reviewer")
    p = sub.add_parser("review"); p.add_argument("pr")
    verdict = p.add_mutually_exclusive_group(required=True)
    verdict.add_argument("--approve", action="store_const", const="approve", dest="verdict")
    verdict.add_argument("--request-changes", action="store_const", const="request-changes", dest="verdict")
    verdict.add_argument("--comment", action="store_const", const="comment", dest="verdict")

    p = sub.add_parser("milestone"); p.add_argument("issue")
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--set", dest="title", help="the Milestone's title; created if new")
    target.add_argument("--clear", action="store_true", help="take the Issue out of its Milestone")
    sub.add_parser("whoami")
    return ap


def main():
    args = build_parser().parse_args()

    global ROLE_ENV
    if not os.environ.get("SOLOREPO_ROLE_ENV"):
        ROLE_ENV = ROLE_DIR / f"{args.role}.env"

    if args.verb == "commit":
        commit(args.message)

    if args.verb == "merge":
        merge(args.pr, stack=args.stack, auto=args.auto)
        return

    if args.verb == "advance":
        advance(args.pr)
        return

    if args.verb == "claim":
        claim(args.issue)
        return

    if args.verb == "difficulty":
        difficulty(args.issue, args.level)
        return

    if args.verb == "triage":
        triage(args.issue, args.level)
        return

    if args.verb == "layer":
        layer(args.pr, args.on)
        return

    if args.verb == "landed":
        landed(args.pr)
        return

    if args.verb == "milestone":
        milestone(args.issue, args.title, clear=args.clear)
        return

    if args.verb == "request-review":
        request_review(args.pr, args.to)
        return

    if args.verb == "review":
        review(args.pr, args.verdict)
        return

    if args.verb == "whoami":
        """Which login this channel speaks as, and what it can reach.

        The wrapper says on stderr where the credential came from; this says who
        that credential *is*, which is the other half and the one that fails
        interestingly. A Role account that cannot see the repository looks
        exactly like a repository that does not exist.
        """
        who = gh("api", "user", "--jq", ".login,.id", parse=False).split("\n")
        print("login:", who[0])
        print("email:", f"{who[1]}+{who[0]}@users.noreply.github.com")
        print("role: ", ROLE_ENV.stem if role_credential() else "none, the solo's own auth")
        try:
            print("repo: ", gh("repo", "view", "--json", "nameWithOwner,viewerPermission",
                               "--jq", '"\\(.nameWithOwner), \\(.viewerPermission)"', parse=False))
        except SystemExit as exc:
            print("repo:  cannot see it —", exc.code)
            print("       a private repository is invisible rather than forbidden, so this "
                  "is either no collaborator invite accepted, or a token whose repository "
                  "selection does not include it.")
        return

    if args.verb == "revise":
        # A title says everything it has to say in an argument, so the body
        # is optional here and nowhere else; reading a body a rename will not
        # use turned a rename into a refusal, twice.
        text = piped()
        revise(args.number, body=signed(text) if text else None, title=args.title)
        return

    if args.verb == "notice":
        # Signed inside, after the marker and the mention are put in front.
        notice(args.pr, args.path, args.line, stdin_body())
        return

    body = signed(stdin_body())

    if args.verb == "file":
        file_issue(args.title, body, level=args.level, roadmap=args.roadmap)
    elif args.verb == "stop":
        stop(args.issue, body)
    elif args.verb == "open":
        open_pull_request(args.title, body, base=args.base, on=args.on)
    elif args.verb == "comment":
        conversation_comment(args.number, body)
    elif args.verb == "raise":
        raise_thread(args.pr, args.path, args.line, body)
    elif args.verb == "reply":
        reply(args.thread, body)
    elif args.verb == "answer":
        answer(args.thread, body)
    elif args.verb == "promote":
        promote(args.thread, args.title, body, args.level)


if __name__ == "__main__":
    main()
