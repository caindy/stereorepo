#!/usr/bin/env python3
"""What is said on GitHub, under the Trailer: the utterances (solorepo's DR-117).

A comment, a thread on the diff, a reply, an answer, a promotion, what landed, and the reviewer's
verdict. Each is one step of a Discipline and refuses its own misuse (solorepo's DR-116): `answer`
replies and resolves, and refuses when this Actor is the thread's sole author unless the reply
links an Issue, which is what a promotion looks like (solorepo's DR-127) — and then replies
without resolving, a thread with one voice being a second Job's to close (solorepo's DR-224);
`notice` supplies the marker and the mention; `promote` files the Issue before the thread says
it did, and refuses a level and a mandate given apart (solorepo's DR-278); `landed` is rendered
from the record and never typed; `review`, `raise`, and `notice` refuse when the head moved
under the run (solorepo's #566, solorepo's #572, solorepo's DR-253), filed otherwise against a
commit never read; `correct` replaces the body of a comment this account posted, or withdraws it,
which is the only reach any Role has into a sentence already said (solorepo's DR-286). Every body
typed here is read before it is signed, and one carrying a Trailer of its own is refused rather
than posted beside the Trailer the channel composes: `signed` declined a body *ending* in one
(solorepo's DR-260), and the refusal now reads all of a body but its own attribution block, which
is where the form gate's audit was already looking (solorepo's DR-286). What changes state
without saying anything — a claim, a level, a layer, a merge — is `move`'s. The refusals are in
`.meta/lib/post/correction.py` (solorepo's DR-217). History in post.history.md (solorepo's DR-171).
"""
import argparse
import os
import pathlib
import re
import subprocess
import sys
from typing import Any

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import channel

# The pull request gate's rules, held once. `landed` reads *What it closes* by
# the same alternation `check_pr.py` blesses a body with, or a body the gate
# passed is one the channel then calls wrong (solorepo's #117).
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
import check_pr
from lib.post.correction import (
    NOTICED,
    correct,
    corrected_body,
    refuse_a_typed_marker,
    refuse_a_typed_trailer,
    refuse_if_unpromoted_notices,
)

REVIEW_HEAD = "SOLOREPO_REVIEW_HEAD"
"""The environment variable naming the head a review run was given to read.

`review.yml` writes it; a verdict from elsewhere is held to no head.
"""

THREAD = """
query($id: ID!) {
  node(id: $id) {
    ... on PullRequestReviewThread {
      comments(first: 100) {
        nodes {
          body
          author { login }
        }
      }
    }
  }
}
"""

REPLY = """
mutation($t: ID!, $b: String!) {
  addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $t, body: $b}) {
    comment { url }
  }
}
"""

RESOLVE = """
mutation($t: ID!) { resolveReviewThread(input: {threadId: $t}) { thread { isResolved } } }
"""


def solo() -> str:
    """Retrieves the GitHub login of the repository owner."""
    return str(channel.gh("repo", "view", "--json", "owner")["owner"]["login"])


def conversation_comment(number: int | str, body: str) -> None:
    """Posts a comment to an Issue or pull request conversation timeline.

    Parameters:
        number: The issue or pull request number.
        body: The markdown body text to post.
    """
    made = channel.gh("api", f"repos/{channel.repo()}/issues/{number}/comments", "-f", f"body={body}")
    print(made["html_url"])


def raise_thread(pr: int | str, path: str, line: int | str, body: str) -> None:
    """Opens a review thread on a specific diff line at the pull request's current head.

    Resolves the remote head commit OID from GitHub rather than the local
    worktree to ensure the comment attaches to a commit recognized by GitHub.

    Parameters:
        pr: The pull request number.
        path: Relative path to the modified file.
        line: Line number in the diff to comment on.
        body: The markdown comment text.
    """
    head = refuse_if_head_moved(pr, action="thread")
    made = channel.gh("api", f"repos/{channel.repo()}/pulls/{pr}/comments",
                      "-f", f"body={body}", "-f", f"commit_id={head}",
                      "-f", f"path={path}", "-F", f"line={line}")
    print(made["html_url"])


def notice(pr: int | str, path: str, line: int | str, text: str) -> None:
    """Opens a diff conversation for work noticed and not done (solorepo's Article 15, solorepo's DR-116).

    Formats the comment with the standard NOTICED marker, mentions the repository
    owner, and signs with attribution trailers.

    Parameters:
        pr: Pull request number to attach the notice to.
        path: File path where the unaddressed work was noticed.
        line: Line number in the diff.
        text: Description of the work noticed and left unaddressed.
    """
    raise_thread(pr, path, line, channel.signed(f"{NOTICED} @{solo()}\n\n{text}"))


def thread_nodes(thread_id: str) -> list[dict[str, Any]] | None:
    """Fetches comment nodes belonging to a pull request review thread.

    Parameters:
        thread_id: GraphQL node ID of the review thread.

    Returns:
        List of comment node dictionaries, or None if the thread does not exist.
    """
    node = channel.graphql(THREAD, id=thread_id)["data"]["node"]
    if not node:
        return None
    return list(node["comments"]["nodes"])


def thread_comments(thread_id: str) -> list[str] | None:
    """Retrieves all comment bodies in a pull request review thread by node ID.

    Parameters:
        thread_id: The GraphQL node ID of the review thread.

    Returns:
        A list of comment body strings in chronological order, or None if the
        thread node cannot be resolved.
    """
    nodes = thread_nodes(thread_id)
    if nodes is None:
        return None
    return [str(c["body"] or "") for c in nodes]


def sole_author(bodies: list[str]) -> bool:
    """Returns True if every comment in the thread was authored exclusively by this Actor.

    Evaluates whether every comment ends with the current Actor's attribution
    trailer. Unsigned comments or comments with differing trailers indicate
    participation by other parties.

    Parameters:
        bodies: List of comment body strings from the thread.

    Returns:
        bool: True if non-empty and all comments end with this Actor's trailer.
    """
    block = channel.trailers()
    return bool(bodies) and all(b.rstrip().endswith(block) for b in bodies)


PROMOTION = re.compile(r"Promoted to (https://github\.com/[\w.-]+/[\w.-]+/issues/\d+)")
"""A promotion this channel performed, as `promote` writes it, capturing the Issue's URL (solorepo's DR-221)."""


def promotes(body: str) -> bool:
    """Checks whether a reply body contains an Issue promotion link.

    Uses `check_pr.PROMOTED` to detect issue links matching the promotion
    criteria required by pull request gate verification (solorepo's Article 16, solorepo's #117).

    Parameters:
        body: Comment body text to inspect.

    Returns:
        bool: True if an issue reference pattern is found in the body.
    """
    return bool(check_pr.PROMOTED.search(body))


def refuse_if_sole_author(thread_id: str, promotion: bool = False) -> list[str]:
    """Enforces two-party review by preventing sole authors from self-resolving threads (solorepo's Article 16, solorepo's DR-127).

    Permits replies that promote the item to an Issue. Fetches the thread's
    comments and aborts execution if the current Actor is the sole author and
    the action is not an issue promotion.

    Parameters:
        thread_id: GraphQL node ID of the thread.
        promotion: Whether the caller is posting an issue promotion.

    Returns:
        list[str]: The list of comment body strings in chronological order.

    Raises:
        SystemExit: If the thread does not exist or sole-author resolution is attempted.
    """
    bodies = thread_comments(thread_id)
    if bodies is None:
        sys.exit(f"say: GitHub has no review thread {thread_id}")
    if promotion:
        return bodies
    if sole_author(bodies):
        sys.exit("say: refusing — you are the sole author of this thread, and a reply from you "
                 "would not change that. A16 counts the resolver as a party, which means "
                 "nothing when it is you. Promote it, if it survived the argument, and answer "
                 "with the Issue's link — that stands aside from this rule, and posts the reply "
                 "without resolving. Closing it is the next Job's, whose Trailer differs: "
                 "`move request-review <pr>` summons one.")
    return bodies


def reply(thread_id: str, body: str) -> None:
    """Posts a reply to a pull request review thread."""
    print(channel.graphql(REPLY, t=thread_id, b=body)
          ["data"]["addPullRequestReviewThreadReply"]["comment"]["url"])


def resolve(thread_id: str) -> None:
    """Resolves a pull request review thread."""
    channel.graphql(RESOLVE, t=thread_id)
    print("resolved")


def comment_party(c: dict[str, Any]) -> str:
    """Identifies the author and optional actor trailer of a thread comment."""
    login = str((c.get("author") or {}).get("login", "someone"))
    actor = check_pr.ACTOR.search(c.get("body") or "")
    return f"{login}/{actor.group(1)}" if actor else login


def resolve_verb(thread_id: str) -> None:
    """Resolves an answered or promoted review thread (solorepo's Article 16, solorepo's DR-224).

    Validates that the thread has received a response from a second party or
    contains an issue promotion link before executing resolution. Refuses
    resolution if every comment on the thread belongs exclusively to the current
    Actor.

    Parameters:
        thread_id: GraphQL node ID of the thread to resolve.

    Raises:
        SystemExit: If the thread is missing, sole-authored by the caller, or
            unanswered.
    """
    nodes = thread_nodes(thread_id)
    if nodes is None:
        sys.exit(f"say: GitHub has no review thread {thread_id}")
    bodies = [str(c.get("body") or "") for c in nodes]
    if sole_author(bodies):
        sys.exit("say: refusing — every comment on this thread is yours, promotion link "
                 "included, and a resolve from you would not change that. A16 asks for a "
                 "reply from a second party or a link, and this thread has the link with no "
                 "second party. `--role` will not make one — it picks a credential, not a "
                 "Trailer. A later Job resolves this; `move request-review <pr>` summons "
                 "one.")
    has_promo = any(check_pr.PROMOTED.search(b) for b in bodies)
    parties = {comment_party(c) for c in nodes}
    if not has_promo and len(parties) < 2:
        sys.exit("say: refusing — this thread has neither an answer from a second party nor a "
                 "promotion link. A16 requires every thread to be answered or promoted before resolving.")
    resolve(thread_id)


def left_open(thread_id: str) -> str:
    """Generates the notification text appended when a sole-authored thread is left open (solorepo's DR-224).

    Parameters:
        thread_id: GraphQL node ID of the unresolved thread.

    Returns:
        str: Notification message indicating the thread awaits second-job resolution.
    """
    return ("Left open: this thread has had one voice, mine. A16 accepts a second party's "
            "reply or a link, and solorepo's DR-224 narrows the link limb, so a thread carrying "
            "one Trailer waits for a second Job even with the link on it. "
            f"`move request-review <pr>` summons one, and `post resolve {thread_id}` is what it "
            "runs.")


def answer(thread_id: str, text: str) -> None:
    """Replies to a review thread and resolves it if multi-party criteria are met (solorepo's DR-127, solorepo's DR-224).

    Posts the reply text. Resolves the thread immediately if another party has
    participated. If the thread is sole-authored, leaves the thread open with an
    explanatory notice for subsequent review handoff.

    Parameters:
        thread_id: GraphQL node ID of the review thread.
        text: Markdown content for the reply.
    """
    bodies = refuse_if_sole_author(thread_id, promotion=promotes(text))
    if sole_author(bodies):
        reply(thread_id, channel.signed(f"{text}\n\n{left_open(thread_id)}"))
        print(f"left open ({thread_id}): this thread has had one voice, yours. A later Job "
              "resolves it; `move request-review <pr>` summons one.")
        return
    reply(thread_id, channel.signed(text))
    resolve(thread_id)


def promote(thread_id: str, title: str, body: str, level: str | None, resolve_thread: bool = True) -> None:
    """Promotes a review thread discussion into a tracked GitHub Issue (solorepo's DR-159, solorepo's DR-221).

    Files a new Issue using the provided title and body, posts a reply linking
    to the created Issue, and resolves the thread if multi-party criteria and
    `resolve_thread` permit. Refuses if the thread already contains a promotion.

    Parameters:
        thread_id: GraphQL node ID of the thread.
        title: Title for the newly created Issue.
        body: Body text for the Issue following the Issue form.
        level: Optional difficulty level (solo mandate only).
        resolve_thread: Whether to attempt resolving the thread upon reply.

    Raises:
        SystemExit: If the thread does not exist or was already promoted.
    """
    bodies = refuse_if_sole_author(thread_id, promotion=True)
    already = next((found for found in map(PROMOTION.search, bodies) if found), None)
    if already:
        sys.exit(f"say: this thread was already promoted to {already.group(1)}, so repeating "
                 "`promote` would file a second Issue for one thread.\n"
                 "     Nothing was filed. The thread is what is unfinished: "
                 f"`post resolve {thread_id}` closes it on the link already posted, from a "
                 "second Job where every comment on it is yours.")
    first_line = body.lstrip().split("\n", 1)[0]
    blocked_by = [int(n) for n in re.findall(r"#(\d+)", first_line)]
    _, url = channel.sibling("move").file_issue(title, body, level=level, blocked_by=blocked_by)
    if sole_author(bodies):
        reply(thread_id, channel.signed(f"Promoted to {url}. {left_open(thread_id)}"))
        return
    reply(thread_id, channel.signed(f"Promoted to {url}."))
    if resolve_thread:
        resolve(thread_id)


def closed_by(pr: int | str) -> list[str] | None:
    """Extracts Challenge issue numbers closed by a pull request body (solorepo's #117).

    Parses the `**What it closes.**` section of the pull request description
    according to pull request gate closing keyword requirements.

    Parameters:
        pr: Pull request number to inspect.

    Returns:
        List of closed issue number strings, or None if the PR explicitly closes nothing.

    Raises:
        SystemExit: If the required section is missing or contains invalid entries.
    """
    body = channel.gh("pr", "view", str(pr), "--json", "body")["body"] or ""
    found = check_pr.sections(body)
    if check_pr.CLOSES not in found:
        sys.exit(f"say: #{pr}'s body has no **{check_pr.CLOSES}.**; the form has one")
    closing = found[check_pr.CLOSES]
    if check_pr.NONE.match(closing):
        return None
    numbers = []
    for item in check_pr.BULLET.finditer(closing):
        ref = check_pr.KEYWORD.search(item.group(1))
        if ref:
            match = re.search(r"(\d+)$", ref.group(0))
            if match:
                numbers.append(match.group(1))
    return list(dict.fromkeys(numbers))


def landed(pr: int | str) -> None:
    """Renders and posts landed summaries for challenges closed by a pull request (solorepo's DR-084, solorepo's #281).

    Reads closed Challenge numbers from the PR body, invokes `render.py --landed`
    for asserted challenges, and posts the resulting markdown as a PR comment.

    Parameters:
        pr: Pull request number whose closed challenges are to be reported.
    """
    import importlib.util

    numbers = closed_by(pr)
    if numbers is None:
        print(f"#{pr} closes nothing, and says so; nothing to post")
        return
    if not numbers:
        sys.exit(f"say: nothing under #{pr}'s **{check_pr.CLOSES}.** carries a closing keyword "
                 "and a reference; the gate would say the same")
    root = channel.HERE.parent.parent
    if importlib.util.find_spec("yaml") is not None:
        command = [sys.executable, ".meta/render.py", "--landed"]
    else:
        command = ["uvx", "--python", "3.13", "--with", "pyyaml", "python",
                   ".meta/render.py", "--landed"]
    for number in numbers:
        if not (root / ".meta" / "assertions" / "challenges" / f"{number}.yaml").exists():
            print(f"#{number} is not asserted as a Challenge; nothing to post for it")
            continue
        try:
            out = subprocess.run([*command, number], check=False, cwd=root,
                                 capture_output=True, text=True)
        except FileNotFoundError:
            sys.exit(f"say: render.py --landed {number} failed: `{command[0]}` is not on PATH")
        if out.returncode:
            sys.exit(f"say: render.py --landed {number} failed: {out.stderr.strip()}")
        conversation_comment(pr, channel.signed(out.stdout))


def refuse_if_head_moved(pr: int | str, action: str = "verdict") -> str | None:
    """Refuses to record a review utterance if the pull request head moved during execution (solorepo's #566, solorepo's #572).

    Compares the head commit OID recorded in `SOLOREPO_REVIEW_HEAD` against the
    current head reported by GitHub. Prevents submitting reviews or diff threads
    against commits different from those evaluated by the review run.

    Parameters:
        pr: The pull request number under review.
        action: The kind of utterance being posted ('verdict', 'thread').

    Returns:
        str | None: Current head commit OID if verified, or None if no head was pinned.

    Raises:
        SystemExit: If `SOLOREPO_REVIEW_HEAD` is set and does not match GitHub's current head.
    """
    read = (os.environ.get(REVIEW_HEAD) or "").strip()
    if not read and action != "thread":
        return None
    now = str(channel.gh("pr", "view", str(pr), "--json", "headRefOid", "--jq", ".headRefOid", parse=False))
    if read and now != read:
        sys.exit(f"say: refusing — this run read {read} and GitHub has #{pr} at {now}. A {action} is "
                 f"recorded against the head current when it lands, so this one would be filed "
                 f"against a commit it never read.\n"
                 f"     Nothing was posted, and nothing is owed here: the push that moved the head "
                 f"left the review request standing, so the run that reads {now} answers it.")
    return now


def raise_verb(pr: int | str, path: str, line: int | str, text: str) -> None:
    """Opens a review thread on a specific diff line at the pull request's current head.

    Signs the body text with attribution trailers before opening the thread.

    Parameters:
        pr: The pull request number.
        path: Relative path to the modified file.
        line: Line number in the diff to comment on.
        text: Description of the finding.
    """
    raise_thread(pr, path, line, channel.signed(text))


def review(pr: int | str, verdict: str) -> None:
    """Submits a pull request review verdict under the active role identity.

    Verifies head commit currency, reads review body text from standard input
    if required, signs the body, and posts the review to GitHub.

    Parameters:
        pr: The pull request number being reviewed.
        verdict: Review verdict type ('approve', 'request-changes', or 'comment').

    Raises:
        SystemExit: If the head commit moved or a non-approval lacks body text.
    """
    refuse_if_head_moved(pr, action="verdict")
    body = channel.piped()
    if not body and verdict != "approve":
        sys.exit("say: nothing on stdin — a review that is not an approval says why")
    if verdict == "approve":
        refuse_if_unpromoted_notices(pr)
    body_args = ["--body", channel.signed(refuse_a_typed_trailer(body))] if body else []
    channel.gh("pr", "review", str(pr), f"--{verdict}", *body_args, parse=False)
    latest = channel.gh("pr", "view", str(pr), "--json", "reviews")["reviews"]
    print(f"reviewed #{pr}: {latest[-1]['state'].lower() if latest else 'GitHub shows no review'}")


def build_parser() -> argparse.ArgumentParser:
    """Constructs the argument parser for `post` CLI commands (solorepo's #95).

    Returns:
        argparse.ArgumentParser: Configured parser supporting post subcommands.
    """
    ap = channel.parser(__doc__)
    sub = ap.add_subparsers(dest="verb", required=True)
    p = sub.add_parser("comment")
    p.add_argument("number")
    for verb in ("raise", "notice"):
        p = sub.add_parser(verb)
        p.add_argument("pr")
        p.add_argument("path")
        p.add_argument("line", type=int)
    for verb in ("reply", "answer", "resolve"):
        sub.add_parser(verb).add_argument("thread")
    p = sub.add_parser("promote")
    p.add_argument("thread")
    p.add_argument("--title", required=True)
    p.add_argument("--difficulty", choices=channel.sibling("move").DIFFICULTIES, dest="level",
                   help="the solo's verdict given in advance, which skips the reviewer; every "
                        "level but `human` needs `--mandate`; without it, `challenge` alone "
                        "(solorepo's DR-230, solorepo's DR-235, solorepo's DR-278)")
    p.add_argument("--mandate", help="the solo's own words asking for `--difficulty`, never alone")
    p.add_argument("--no-resolve", action="store_true", help="file and reply, but do not resolve the thread")
    p = sub.add_parser("correct")
    p.add_argument("comment")
    p.add_argument("--withdraw", action="store_true",
                   help="delete the comment rather than replace its body; takes no body; deletes "
                        "the comment alone, preserving child replies on a review thread")
    p = sub.add_parser("landed")
    p.add_argument("pr")
    p = sub.add_parser("review")
    p.add_argument("pr")
    verdict = p.add_mutually_exclusive_group(required=True)
    verdict.add_argument("--approve", action="store_const", const="approve", dest="verdict")
    verdict.add_argument("--request-changes", action="store_const", const="request-changes", dest="verdict")
    verdict.add_argument("--comment", action="store_const", const="comment", dest="verdict")
    return ap


def main() -> None:
    """Parses arguments and dispatches commenting and thread verbs on GitHub."""
    args = build_parser().parse_args()
    channel.speak_as(args.role)

    if args.verb == "landed":
        landed(args.pr)
        return
    if args.verb == "review":
        review(args.pr, args.verdict)
        return
    if args.verb == "correct":
        correct(args.comment, corrected_body(args.withdraw, channel.piped()))
        return
    if args.verb == "notice":
        # Signed inside, after the marker and the mention are put in front.
        notice(args.pr, args.path, args.line,
               refuse_a_typed_marker(refuse_a_typed_trailer(channel.stdin_body())))
        return
    if args.verb == "raise":
        raise_verb(args.pr, args.path, args.line, refuse_a_typed_trailer(channel.stdin_body()))
        return
    if args.verb == "resolve":
        resolve_verb(args.thread)
        return
    if args.verb == "answer":
        # Signed inside, after the sentence that leaves a sole-authored thread
        # open is put behind the caller's words.
        answer(args.thread, refuse_a_typed_trailer(channel.stdin_body()))
        return

    body = channel.signed(refuse_a_typed_trailer(channel.stdin_body()))
    if args.verb == "comment":
        conversation_comment(args.number, body)
    elif args.verb == "reply":
        reply(args.thread, body)
    elif args.verb == "promote":
        channel.sibling("move").common.refuse_a_level_and_a_mandate_apart(args.level, args.mandate)
        promote(args.thread, args.title, body, args.level, resolve_thread=not args.no_resolve)


if __name__ == "__main__":
    main()
