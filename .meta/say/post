#!/usr/bin/env python3
"""What is said on GitHub, under the Trailer: the utterances (solorepo's DR-117).

A comment, a thread on the diff, a reply, an answer, a promotion, what landed,
and the reviewer's verdict. Each is one step of a Discipline and refuses its own
misuse (solorepo's DR-116): `answer` replies and resolves, and refuses when this Actor is
the thread's sole author unless the reply links an Issue, which is what a
promotion looks like (solorepo's DR-127) — and then replies without resolving, a thread
with one voice being a second Job's to close (solorepo's DR-224); `notice` supplies the
marker and the mention;
`promote` files the Issue before the thread says it did; `landed` is rendered
from the record and never typed; `review` refuses a verdict whose head moved
under the run, which GitHub would otherwise file against a commit the run never
read (solorepo's #566). What changes state without saying anything — a claim, a
level, a layer, a merge — is `move`'s. History in post.history.md
(solorepo's DR-171).
"""
import argparse
import os
import pathlib
import re
import sys
from typing import Any

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import channel  # noqa: E402

# The pull request gate's rules, held once. `landed` reads *What it closes* by
# the same alternation `check_pr.py` blesses a body with, or a body the gate
# passed is one the channel then calls wrong (solorepo's #117).
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
import check_pr  # noqa: E402

NOTICED = "**Noticed and not done.**"

REVIEW_HEAD = "SOLOREPO_REVIEW_HEAD"
"""The environment variable naming the head a review run was given to read.

`review.yml` writes it and nothing else does, so a verdict posted from anywhere
else finds it unset and is held to no head.
"""

THREAD = """
query($id: ID!) {
  node(id: $id) {
    ... on PullRequestReviewThread {
      comments(first: 100) {
        nodes {
          body
          author { login }
        }
      }
    }
  }
}
"""

REPLY = """
mutation($t: ID!, $b: String!) {
  addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $t, body: $b}) {
    comment { url }
  }
}
"""

RESOLVE = """
mutation($t: ID!) { resolveReviewThread(input: {threadId: $t}) { thread { isResolved } } }
"""


def solo() -> str:
    """The account the repository belongs to: the party a parked conversation
    is addressed to."""
    return str(channel.gh("repo", "view", "--json", "owner")["owner"]["login"])


def conversation_comment(number: int | str, body: str) -> None:
    """A comment on a pull request's conversation or an Issue's — the same
    endpoint on GitHub, which is why one verb serves both."""
    made = channel.gh("api", f"repos/{channel.repo()}/issues/{number}/comments", "-f", f"body={body}")
    print(made["html_url"])


def raise_thread(pr: int | str, path: str, line: int | str, body: str) -> None:
    """Open a thread on a line of the diff, at the pull request's head.

    The pull request's head, not this worktree's. They are usually the same
    and the failure when they are not is opaque: GitHub rejects a comment
    whose commit is not part of the pull request.
    """
    head = channel.gh("pr", "view", str(pr), "--json", "headRefOid", "--jq", ".headRefOid", parse=False)
    made = channel.gh("api", f"repos/{channel.repo()}/pulls/{pr}/comments",
                      "-f", f"body={body}", "-f", f"commit_id={head}",
                      "-f", f"path={path}", "-F", f"line={line}")
    print(made["html_url"])


def notice(pr: int | str, path: str, line: int | str, text: str) -> None:
    """Work noticed and not done, as a conversation on the diff (A15).

    PR First's step: raise it where it was noticed, tagging the solo and
    opening with the marker. The marker is what tells a thread held open on
    purpose from one owed an answer, and `check_pr.py` reads it from the
    *last* comment; the mention is who decides what it is. Both are supplied
    here rather than typed, so a notice is never one a reader mistakes for a
    question (solorepo's DR-116).
    """
    raise_thread(pr, path, line, channel.signed(f"{NOTICED} @{solo()}\n\n{text}"))


def thread_nodes(thread_id: str) -> list[dict[str, Any]] | None:
    """Every comment node in one thread, asked for by id."""
    node = channel.graphql(THREAD, id=thread_id)["data"]["node"]
    if not node:
        return None
    return list(node["comments"]["nodes"])


def thread_comments(thread_id: str) -> list[str] | None:
    """Every comment body in one thread, asked for by id.

    The first version scanned every open pull request looking for the id, on the
    belief that GitHub had no by-id query. It has: a review thread is a `node`
    like anything else. Scanning was several calls, and it silently depended on
    the thread being in the first hundred of a pull request that was still open.
    """
    nodes = thread_nodes(thread_id)
    if nodes is None:
        return None
    return [str(c["body"] or "") for c in nodes]


def sole_author(bodies: list[str]) -> bool:
    """True when every comment *ends with* this Actor's Trailer and no other voice.

    Ends with, rather than contains: a comment quoting the Trailer — a reply
    discussing attribution, say, which this repository produces constantly —
    would otherwise be read as having been written by whoever it quoted.

    An unsigned comment counts as somebody else — that is the human, who signs
    nothing. The false pass this rule exists to prevent went the other way: an
    agent's *own* unsigned comment read as the human and made a second party out
    of nothing. Here that failure is impossible, because everything this channel
    posts is signed by construction.
    """
    block = channel.trailers()
    return bool(bodies) and all(b.rstrip().endswith(block) for b in bodies)


PROMOTION = re.compile(r"Promoted to (https://github\.com/[\w.-]+/[\w.-]+/issues/\d+)")
"""A promotion this channel performed, as `promote` writes it, capturing the Issue's URL.

Narrower than `check_pr.PROMOTED`, which matches any Issue URL in any
repository written by anyone. The gate wants the broad reading: a thread
carrying a link to an Issue has its item recorded somewhere, whoever wrote the
link. A refusal to file wants the narrow one, because its false positive costs
the Challenge rather than a repeated URL (solorepo's DR-221).
"""


def promotes(body: str) -> bool:
    """True when a reply links an Issue, which is what a promotion looks like.

    `check_pr.PROMOTED` rather than a pattern of this program's, so the verb
    never stands aside where the gate would go on calling the thread resolved
    without an answer — the one direction A16 depends on, and the same parity
    `landed` keeps with the gate's sections (solorepo's #117).

    The other direction does not hold and is not wanted. The gate scans every
    comment on the thread; this scans the one body about to be posted. So a
    sole-authored thread that already carries a link from a promotion whose
    resolve failed is refused here and passed there, and the way through is to
    repeat the URL — the conservative side, and the refusal names it. Dropping
    either scan to make the two equal is the reading that would break A16.
    """
    return bool(check_pr.PROMOTED.search(body))


def refuse_if_sole_author(thread_id: str, promotion: bool = False) -> list[str]:
    """The sole-author refusal, and the one case it stands aside for (solorepo's DR-127).

    A promotion is an answer: PR First's eighth step gives it to the coder, and
    the thread it closes is one the coder wrote every word of, so a rule that
    counts parties refuses the act the step assigns. A16 is not weakened by
    standing aside, because what the reply carries is an Issue — the item
    survives with a state of its own, which is the opposite of walking past it.
    A reply with no link stays refused: that is the self-resolution solorepo's DR-068 and
    solorepo's DR-072 put the control on the thread for.

    What stands aside is the reply, not the resolve. Its two callers, `promote`
    and `answer`, ask `sole_author` again on the bodies this returns, and a
    sole-authored thread is left open for a second Job however the link got
    there (solorepo's DR-224). `resolve_verb` asks the same question of its own
    fetch, having no reply to stand aside for.

    The thread is fetched whether or not the rule can bite, so a bad id stops
    the verb before anything is filed or posted rather than after. The bodies
    are returned so that a caller needing them again does not fetch twice.

    Returns:
        list[str]: The thread's comment bodies, in the order GitHub reports them.
    """
    bodies = thread_comments(thread_id)
    if bodies is None:
        sys.exit(f"say: GitHub has no review thread {thread_id}")
    if promotion:
        return bodies
    if sole_author(bodies):
        sys.exit("say: refusing — you are the sole author of this thread, and a reply from you "
                 "would not change that. A16 counts the resolver as a party, which means "
                 "nothing when it is you. Promote it, if it survived the argument, and answer "
                 "with the Issue's link — that stands aside from this rule, and posts the reply "
                 "without resolving. Closing it is the next Job's, whose Trailer differs: "
                 "`move request-review <pr>` summons one.")
    return bodies


def reply(thread_id: str, body: str) -> None:
    """Posts a reply to a pull request review thread."""
    print(channel.graphql(REPLY, t=thread_id, b=body)
          ["data"]["addPullRequestReviewThreadReply"]["comment"]["url"])


def resolve(thread_id: str) -> None:
    """Resolves a pull request review thread."""
    channel.graphql(RESOLVE, t=thread_id)
    print("resolved")


def comment_party(c: dict[str, Any]) -> str:
    """Identifies the author and optional actor trailer of a thread comment."""
    login = str((c.get("author") or {}).get("login", "someone"))
    actor = check_pr.ACTOR.search(c.get("body") or "")
    return f"{login}/{actor.group(1)}" if actor else login


def resolve_verb(thread_id: str) -> None:
    """Resolve a review thread whose answer or promotion link is already posted (A16).

    Refuse first where every comment is this Actor's own — the promotion link
    included, per `sole_author` (solorepo's DR-224). A16's falsifier is a thread only the
    Actor who raised it can resolve, and a resolve only its sole author could
    type is that thread. A second Job resolves it: `sole_author` reads
    `channel.trailers()`, so a later run reads a different Trailer on the same
    bodies and stands aside.

    Otherwise stand aside when the thread already carries a promotion link or
    a comment from a party other than whoever opened it; refuse otherwise, so
    resolving without either cannot clear the gate.
    """
    nodes = thread_nodes(thread_id)
    if nodes is None:
        sys.exit(f"say: GitHub has no review thread {thread_id}")
    bodies = [str(c.get("body") or "") for c in nodes]
    if sole_author(bodies):
        sys.exit("say: refusing — every comment on this thread is yours, promotion link "
                 "included, and a resolve from you would not change that. A16 asks for a "
                 "reply from a second party or a link, and this thread has the link with no "
                 "second party. `--role` will not make one — it picks a credential, not a "
                 "Trailer. A later Job resolves this; `move request-review <pr>` summons "
                 "one.")
    has_promo = any(check_pr.PROMOTED.search(b) for b in bodies)
    parties = {comment_party(c) for c in nodes}
    if not has_promo and len(parties) < 2:
        sys.exit("say: refusing — this thread has neither an answer from a second party nor a "
                 "promotion link. A16 requires every thread to be answered or promoted before resolving.")
    resolve(thread_id)


def left_open(thread_id: str) -> str:
    """The sentence a reply carries when the thread it answers is left open (solorepo's DR-224).

    One wording for both doors, `promote` and `answer`, because what tells the
    arriving reviewer which unresolved thread is its to close is a string it
    reads: `review.yml`'s prompts say resolve only where the last comment
    carries the Issue's URL and the words `Left open:`. A second wording is a
    thread the arriving run is instructed to walk past, and the merge waits on
    a thread with no one left to close it.

    It goes in front of the Trailer rather than after, since `sole_author`
    reads a comment by what it ends with: appended after, the marker would make
    this Actor's own reply read as somebody else's and hand the thread the
    second party it is waiting for.
    """
    return ("Left open: this thread has had one voice, mine. A16 accepts a second party's "
            "reply or a link, and solorepo's DR-224 narrows the link limb, so a thread carrying "
            "one Trailer waits for a second Job even with the link on it. "
            f"`move request-review <pr>` summons one, and `post resolve {thread_id}` is what it "
            "runs.")


def answer(thread_id: str, text: str) -> None:
    """Reply, then resolve: PR First's step, whole — except on a thread this
    Actor is the sole author of, which is replied to and left open (solorepo's DR-224).

    A thread answered and left open reads as one still owed something, and
    one resolved without an answer is A16's defect; the step is both, and so
    is the verb wherever the thread has two voices. The sole-author refusal is
    asked before anything is posted: a reply that goes out and a resolve that
    then refuses is the step half done, which is the shape this verb exists to
    make untypeable.

    The body decides whether that refusal applies: one linking an Issue is the
    promotion PR First's eighth step names (solorepo's DR-127). `promote` below does the
    whole step in one act and is the coder's ordinary door to it; this verb is
    what closes the thread when the two came apart — a promotion whose resolve
    failed, or an Issue filed for the thread before it was answered. The link is
    what says the Issue exists, so a thread is never closed on a promotion that
    did not happen.

    The reply goes out either way; the resolve waits where `sole_author` holds
    on the bodies read before posting (solorepo's DR-224). The stand-aside above is why the
    link reaches the thread at all, and it is about the reply: a thread every
    word of which is this Actor's is left open for a second Job, the same as
    `promote` leaves it — and carrying `left_open`'s sentence for the same
    reason, so the arriving run reads one marker whichever door left the thread
    open. The caller's words are signed here rather than in `main`, since that
    sentence goes between them and the Trailer.
    """
    bodies = refuse_if_sole_author(thread_id, promotion=promotes(text))
    if sole_author(bodies):
        reply(thread_id, channel.signed(f"{text}\n\n{left_open(thread_id)}"))
        print(f"left open ({thread_id}): this thread has had one voice, yours. A later Job "
              "resolves it; `move request-review <pr>` summons one.")
        return
    reply(thread_id, channel.signed(text))
    resolve(thread_id)


def promote(thread_id: str, title: str, body: str, level: str | None, resolve_thread: bool = True) -> None:
    """At approval: what survived the argument earns an Issue, and the thread is
    resolved with a link to it (PR First, solorepo's DR-159).

    Where `sole_author` holds on the thread's bodies, the Issue is filed and
    the link posted and the thread is left open, whatever `resolve_thread`
    asked for; the reply names what closes it (solorepo's DR-224). Where it does not, the
    order is file, reply, resolve, so the Issue exists before the thread says
    it does.

    The body is the Issue form's, not the thread's: it opens with
    `**Waits on.**` like anything `file` takes, since what is promoted is an
    Issue and the thread is where it was found. `--no-resolve` replies and
    leaves the thread open so the pull request's body and what landed can be
    finalized first; a sole-authored thread is left open whether or not it was
    passed.

    The sole-author refusal cannot bite here and is asked as `promotion=True`
    rather than dropped: this verb's reply carries the Issue's link by
    construction, which is the case solorepo's DR-127 has it stand aside for, and the call
    is still what proves the thread exists before an Issue is filed for it. The
    bodies it returns are then read twice, for the standing promotion and for
    `sole_author`.

    The Issue lands `challenge` alone unless a level is given: the level is the
    reviewer's verdict, and a raiser at approval proposes one in the body. A
    level given here is the solo's mandate (solorepo's DR-230), which a run
    cannot hold and `file_issue` refuses it (solorepo's DR-235) — the promotion
    pass after a review is where the mandate was invented and every Challenge
    it filed went to the solo unread.

    A thread already carrying this channel's own promotion is refused, so
    that repeating the verb on a thread already promoted does not file a second
    Issue for one Challenge (solorepo's DR-221). The evidence is `PROMOTION` and
    not `promotes()`: the gate's pattern matches any Issue URL any party wrote,
    and a thread citing an Issue is a thread this verb must still be able to
    promote.

    Raises:
        SystemExit: If GitHub has no such thread, or the thread already carries a
            promotion link.
    """
    bodies = refuse_if_sole_author(thread_id, promotion=True)
    already = next((found for found in map(PROMOTION.search, bodies) if found), None)
    if already:
        sys.exit(f"say: this thread was already promoted to {already.group(1)}, so repeating "
                 "`promote` would file a second Issue for one thread.\n"
                 "     Nothing was filed. The thread is what is unfinished: "
                 f"`post resolve {thread_id}` closes it on the link already posted, from a "
                 "second Job where every comment on it is yours.")
    first_line = body.lstrip().split("\n", 1)[0]
    blocked_by = [int(n) for n in re.findall(r"#(\d+)", first_line)]
    _, url = channel.sibling("move").file_issue(title, body, level=level, blocked_by=blocked_by)
    if sole_author(bodies):
        reply(thread_id, channel.signed(f"Promoted to {url}. {left_open(thread_id)}"))
        return
    reply(thread_id, channel.signed(f"Promoted to {url}."))
    if resolve_thread:
        resolve(thread_id)


def closed_by(pr: int | str) -> list[str] | None:
    """The Challenges a pull request's body closes, by the gate's own rule.

    `check_pr.py` blesses the heading: one bullet per item, each carrying a
    closing keyword and one of the three references GitHub closes on, or an
    explicit `None.`. The same objects read it here, so a body the required
    check passed is never one this verb calls wrong. `None` is the answer for a
    body that says it closes nothing, and an empty list is a body that named
    nothing the gate would accept.

    The near-miss is the heading present and its section empty, since
    `check_pr.check()` guards its closing rule on `closing` being truthy and
    that rule would pass it. It fails the gate one rule earlier, as a required
    section left blank — the form submitted with nothing in it — so the parity
    holds through that body too and the refusal in `landed` is not reached on
    one the gate blessed (solorepo's #117).
    """
    body = channel.gh("pr", "view", str(pr), "--json", "body")["body"] or ""
    found = check_pr.sections(body)
    if check_pr.CLOSES not in found:
        sys.exit(f"say: #{pr}'s body has no **{check_pr.CLOSES}.**; the form has one")
    closing = found[check_pr.CLOSES]
    if check_pr.NONE.match(closing):
        return None
    numbers = []
    for item in check_pr.BULLET.finditer(closing):
        ref = check_pr.KEYWORD.search(item.group(1))
        if ref:
            match = re.search(r"(\d+)$", ref.group(0))
            if match:
                numbers.append(match.group(1))
    return list(dict.fromkeys(numbers))


def landed(pr: int | str) -> None:
    """Post what landed for every Challenge the pull request closes, rendered
    from the record and never typed (PR First, solorepo's DR-084).

    One comment per Challenge the record asserts. A body that says `None.`
    closes nothing and has nothing to post, which is allowed and is a question
    the form asks; a Challenge with no `assertions/challenges/<n>.yaml` has
    nothing to post either, and is the common case rather than the rare one,
    so it is said here and not posted — the renderer's line for it is about
    the assertion directory, not the work, and on a pull request it reads as
    a tool error. Neither is a refusal, since the coder loop runs this on
    every pull request and every pass. `render.py --landed` is run rather
    than imported: it needs `yaml`, which this interpreter may not have. The
    interpreter already running this script is tried first, and `uvx` only
    when `yaml` does not import under it — a laptop session with plain
    `python3` and `pyyaml` installed has no `uvx` to fall back to
    (solorepo's #281).
    """
    import importlib.util
    import subprocess

    numbers = closed_by(pr)
    if numbers is None:
        print(f"#{pr} closes nothing, and says so; nothing to post")
        return
    if not numbers:
        sys.exit(f"say: nothing under #{pr}'s **{check_pr.CLOSES}.** carries a closing keyword "
                 "and a reference; the gate would say the same")
    root = channel.HERE.parent.parent
    if importlib.util.find_spec("yaml") is not None:
        command = [sys.executable, ".meta/render.py", "--landed"]
    else:
        command = ["uvx", "--with", "pyyaml", "python", ".meta/render.py", "--landed"]
    for number in numbers:
        if not (root / ".meta" / "assertions" / "challenges" / f"{number}.yaml").exists():
            print(f"#{number} is not asserted as a Challenge; nothing to post for it")
            continue
        try:
            out = subprocess.run(command + [number], cwd=root, capture_output=True, text=True)
        except FileNotFoundError:
            sys.exit(f"say: render.py --landed {number} failed: `{command[0]}` is not on PATH")
        if out.returncode:
            sys.exit(f"say: render.py --landed {number} failed: {out.stderr.strip()}")
        conversation_comment(pr, channel.signed(out.stdout))


def refuse_if_head_moved(pr: int | str) -> None:
    """Refuse a verdict whose head moved under the run (solorepo's #566).

    GitHub records a review against whatever the pull request's head is when the
    review lands, and not against the commit the run read, so a verdict posted
    across a push is filed against a commit it never read.

    `REVIEW_HEAD` names the head the run was given, and where it is unset there
    is nothing to compare and the verdict posts. Nothing is re-triggered: the
    push that moved the head is a `synchronize` on a pull request whose review
    request still stands, which is an event `review.yml` runs on.

    Args:
        pr: The pull request the verdict is for.

    Raises:
        SystemExit: If the environment names a head and GitHub reports another.
    """
    read = (os.environ.get(REVIEW_HEAD) or "").strip()
    if not read:
        return
    now = channel.gh("pr", "view", str(pr), "--json", "headRefOid", "--jq", ".headRefOid", parse=False)
    if now == read:
        return
    sys.exit(f"say: refusing — this run read {read} and GitHub has #{pr} at {now}. A verdict is "
             f"recorded against the head current when it lands, so this one would be filed "
             f"against a commit it never read.\n"
             f"     Nothing was posted, and nothing is owed here: the push that moved the head "
             f"left the review request standing, so the run that reads {now} answers it.")


def review(pr: int | str, verdict: str) -> None:
    """The reviewer's answer, as the Role: approve, request changes, or comment.

    An approval may carry no body — the act is the answer — and the other two
    cannot, which GitHub enforces and this does not repeat. Whatever body there
    is arrives signed like every other utterance. The head is asked about first,
    so a run whose head moved hears that rather than a complaint about its body.

    Raises:
        SystemExit: If the head moved under the run, or a verdict that is not an
            approval arrives with nothing on stdin.
    """
    refuse_if_head_moved(pr)
    body = channel.piped()
    if not body and verdict != "approve":
        sys.exit("say: nothing on stdin — a review that is not an approval says why")
    cmd = ["pr", "review", str(pr), f"--{verdict}"]
    if body:
        cmd += ["--body", channel.signed(body)]
    channel.gh(*cmd, parse=False)
    latest = channel.gh("pr", "view", str(pr), "--json", "reviews")["reviews"]
    print(f"reviewed #{pr}: {latest[-1]['state'].lower() if latest else 'GitHub shows no review'}")


def build_parser() -> argparse.ArgumentParser:
    """The parser alone, so a probe can check what each verb accepts without
    running what it dispatches to (solorepo's #95: the mutually exclusive verdict group
    landed on the wrong verb because both reused the loop variable `p`, and
    nothing parsed a verb without also calling `gh`)."""
    ap = channel.parser(__doc__)
    sub = ap.add_subparsers(dest="verb", required=True)
    p = sub.add_parser("comment"); p.add_argument("number")
    p = sub.add_parser("raise"); p.add_argument("pr"); p.add_argument("path"); p.add_argument("line", type=int)
    p = sub.add_parser("notice"); p.add_argument("pr"); p.add_argument("path"); p.add_argument("line", type=int)
    p = sub.add_parser("reply"); p.add_argument("thread")
    p = sub.add_parser("answer"); p.add_argument("thread")
    p = sub.add_parser("resolve"); p.add_argument("thread")
    p = sub.add_parser("promote"); p.add_argument("thread"); p.add_argument("--title", required=True)
    p.add_argument("--difficulty", choices=channel.sibling("move").DIFFICULTIES, dest="level",
                   help="the solo's verdict given in advance, which skips the reviewer; without it, "
                        "`challenge` alone, for the reviewer to read (solorepo's DR-230). A run "
                        "lands `human` and no other (solorepo's DR-235)")
    p.add_argument("--no-resolve", action="store_true", help="file and reply, but do not resolve the thread")
    p = sub.add_parser("landed"); p.add_argument("pr")
    p = sub.add_parser("review"); p.add_argument("pr")
    verdict = p.add_mutually_exclusive_group(required=True)
    verdict.add_argument("--approve", action="store_const", const="approve", dest="verdict")
    verdict.add_argument("--request-changes", action="store_const", const="request-changes", dest="verdict")
    verdict.add_argument("--comment", action="store_const", const="comment", dest="verdict")
    return ap


def main() -> None:
    """Parses arguments and dispatches commenting and thread verbs on GitHub."""
    args = build_parser().parse_args()
    channel.speak_as(args.role)

    if args.verb == "landed":
        landed(args.pr)
        return
    if args.verb == "review":
        review(args.pr, args.verdict)
        return
    if args.verb == "notice":
        # Signed inside, after the marker and the mention are put in front.
        notice(args.pr, args.path, args.line, channel.stdin_body())
        return
    if args.verb == "resolve":
        resolve_verb(args.thread)
        return
    if args.verb == "answer":
        # Signed inside, after the sentence that leaves a sole-authored thread
        # open is put behind the caller's words.
        answer(args.thread, channel.stdin_body())
        return

    body = channel.signed(channel.stdin_body())
    if args.verb == "comment":
        conversation_comment(args.number, body)
    elif args.verb == "raise":
        raise_thread(args.pr, args.path, args.line, body)
    elif args.verb == "reply":
        reply(args.thread, body)
    elif args.verb == "promote":
        promote(args.thread, args.title, body, args.level, resolve_thread=not args.no_resolve)


if __name__ == "__main__":
    main()
