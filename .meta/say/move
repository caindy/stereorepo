#!/usr/bin/env python3
"""What changes state on GitHub: the transitions (solorepo's DR-117).

An Issue filed, triaged, moved between levels, claimed or handed back; a pull
request opened, layered, revised, merged, superseded or advanced; a review
requested; a coder pass dispatched; a Milestone set; a Decision's number
reserved. Each is one step of a Discipline
and refuses its own misuse, which solorepo's DR-116 asked of the verbs it then
had and every verb since has been written to: `file` lands `challenge` and the
difficulty in one act, `stop` asks its refusal before it posts, `claim` refuses
a session at a level a loop takes, `open --on` links the layer it opens, `merge
--auto` advances before it arms, `supersede` refuses unless the body closes a
Challenge and that Challenge is closed, `mint` takes no number to reserve. Every
outcome is read back from GitHub to verify it took effect on the remote: the act is what GitHub shows
afterwards, not what `gh` returned. What is *said* — a comment, a thread, an
answer, a verdict — is `post`'s.
"""
import datetime
import pathlib
import re
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
import channel  # noqa: E402
import check_pr  # noqa: E402

DIFFICULTIES = ("easy", "medium", "hard", "human")

# The two levels a loop takes on the label's own event (solorepo's DR-112), which is what
# makes a Challenge at either one a run's rather than a session's.
LOOP_LEVELS = ("easy", "medium")


# --- An Issue's life: filed, triaged, its level moved, claimed, handed back.

def labels_of(issue):
    return [l["name"] for l in channel.gh("issue", "view", str(issue), "--json", "labels")["labels"]]


def relabel(issue, add=(), remove=()):
    """Move an Issue's labels, and read back what it carries.

    Not a verb. The labels an agent moves are the difficulty and nothing else,
    and `difficulty` says what a legal move is; a verb that took any label
    took `medium` without `challenge`, which is solorepo's #113 (solorepo's DR-116).
    """
    cmd = ["issue", "edit", str(issue)]
    for name in add:
        cmd += ["--add-label", name]
    for name in remove:
        cmd += ["--remove-label", name]
    channel.gh(*cmd, parse=False)
    now = labels_of(issue)
    missing = [n for n in add if n not in now] + [n for n in remove if n in now]
    if missing:
        sys.exit(f"say: GitHub shows #{issue} labelled {now} after the call; {missing} did not take")
    return now


def challenge_labels(issue):
    """An Issue's labels, if it is a Challenge; a refusal if it is not.

    Asked before anything is posted or moved, by every verb whose second half
    needs it: a difficulty on anything but a Challenge is a label no loop will
    ever read, and a comment posted before the refusal is a step half done.
    """
    now = labels_of(issue)
    if "challenge" not in now:
        sys.exit(f"say: #{issue} is not a Challenge (labelled {now or 'nothing'}); a difficulty "
                 "is a Challenge's, and a loop reads it only beside `challenge`. "
                 "`move triage` makes it one, at a level, in one act.")
    return now


def difficulty(issue, level):
    """Set a Challenge's difficulty: the raiser's estimate, moved by the raiser
    downward or by a loop to `human` (solorepo's DR-112).

    One level at a time, so the Issue never carries two, and never on an Issue
    that is not a Challenge: the coder loop takes an Issue on the event of its
    difficulty landing and reads `challenge` beside it, so a difficulty on
    anything else is a label nothing will ever read (solorepo's #113).
    """
    now = challenge_labels(issue)
    stale = [l for l in now if l in DIFFICULTIES and l != level]
    now = relabel(issue, add=[level], remove=stale)
    print(f"#{issue} is labelled {', '.join(now)}")


def triage(issue, level):
    """Make an Issue a Challenge at a level: `challenge` and the difficulty in
    one act, and `roadmap` off it.

    The door `file` opens at creation, for an Issue that exists already: one
    the solo opened from the web with no form and no labels, which `just next`
    lists as neither kind; or a roadmap Issue whose blocker has closed, which
    the roadmap form says is usually a Challenge and which closing and refiling
    would strip of its number, its thread and the reason it was deferred.

    A difficulty already on the Issue — the state of solorepo's #113, the level with no
    `challenge` beside it — is taken off first and put back with `challenge`,
    so the event the coder loop reads fires: GitHub emits nothing for a label
    an Issue already carries.
    """
    now = labels_of(issue)
    if "challenge" in now:
        sys.exit(f"say: #{issue} is a Challenge already (labelled {now}); "
                 "`move difficulty` moves its level")
    if level in now:
        relabel(issue, remove=[level])
    stale = [l for l in now if l == "roadmap" or (l in DIFFICULTIES and l != level)]
    now = relabel(issue, add=["challenge", level], remove=stale)
    print(f"#{issue} is a Challenge, labelled {', '.join(now)}")


def file_issue(title, body, level=None, roadmap=False):
    """File a Challenge or a roadmap Issue the way the form does.

    The form's front matter applies `challenge` at creation and the raiser adds
    a difficulty; through the channel both land in one `create`, so there is
    no moment when the difficulty is on an Issue that is not yet a Challenge —
    the moment the coder loop's event fell into on solorepo's #113. A roadmap Issue takes
    `roadmap` and no difficulty, since it is deferred by definition.

    A label supplied at creation fires `labeled` like any other, one delivery
    per label beside `opened` — GitHub's workflow reference says so in as many
    words — so one act here is the one event `coder.yml` watches.

    The first line is read before anything is created. `just next` reads
    `**Waits on.**` from the first line of both forms (solorepo's DR-114), and an Issue
    filed without it waits on nothing anyone can see. Any `#<n>` blockers seed
    GitHub's native blocked-by relationship (solorepo's DR-170).
    """
    first = body.lstrip().split("\n", 1)[0]
    if not first.startswith("**Waits on.**"):
        sys.exit("say: the body does not open with `**Waits on.**`, which is the line "
                 f"`just next` reads; it opens with {first[:60]!r}. Both forms begin there.")
    labels = ["roadmap"] if roadmap else ["challenge", level]
    cmd = ["issue", "create", "--title", title, "--body", body]
    for name in labels:
        cmd += ["--label", name]
    refs = sorted(set(int(n) for n in re.findall(r"#(\d+)", first)))
    if refs:
        cmd += ["--blocked-by", ",".join(str(n) for n in refs)]
    url = channel.gh(*cmd, parse=False)
    number = url.rstrip("/").rsplit("/", 1)[-1]
    now = labels_of(number)
    if any(l not in now for l in labels):
        sys.exit(f"say: GitHub shows #{number} labelled {now} after the call, not {labels}")
    if refs:
        view = channel.gh("issue", "view", str(number), "--json", "blockedBy")
        recorded = {n["number"] for n in (view.get("blockedBy") or {}).get("nodes", []) if "number" in n}
        missing = set(refs) - recorded
        if missing:
            sys.exit(f"say: GitHub shows #{number} missing blocked-by relationship for {sorted(missing)}")
    print(url)
    return number, url


def claim(issue):
    """Take an Issue: assign it to this Role's account, and read back.

    A loop claims by assignment (solorepo's DR-112). It is an act GitHub records, so it
    goes through here, as the Role whose token this is.

    Refused to a session at `easy` or `medium` (solorepo's DR-148). Those levels are the
    loop's from the moment the label lands, so a session that claims one is
    standing beside a run that was started for it — the collision solorepo's #115 recorded
    on solorepo's #110, where six threads were answered twice and a push dismissed the
    other coder's approval. The act that makes such a Challenge a session's is
    moving it to `hard`, which is the fact the loop's own guard reads, so the
    refusal names that move rather than a way round itself.

    Only a Challenge is refused: the level the loop takes an Issue on is read
    beside `challenge` (solorepo's #113), and a bare `medium` starts no run. The labels
    are read only where the refusal could apply, so the loop's own claim is the
    one call it always was.
    """
    if not channel.in_a_run():
        now = labels_of(issue)
        taken = next((l for l in now if l in LOOP_LEVELS), None)
        if taken and "challenge" in now:
            sys.exit(f"say: #{issue} is labelled `{taken}`, which is a loop's from the moment "
                     "the label landed, and this is a session: a claim here stands beside the "
                     f"run that was started for it. `move difficulty {issue} hard` takes the "
                     "Challenge from the loop — the level is what says whose a branch is — and "
                     "it can be claimed then.")
    login = channel.login()
    channel.gh("issue", "edit", issue, "--add-assignee", login, parse=False)
    who = [a["login"] for a in channel.gh("issue", "view", issue, "--json", "assignees")["assignees"]]
    if login not in who:
        sys.exit(f"say: GitHub shows #{issue} assigned to {who or 'nobody'} after the call, not {login}")
    print(f"claimed #{issue} as {login}")


def release(issue):
    """Take this Role's assignment off an Issue, and read back.

    The claim says a run is standing on this. The coder loop's guard reads it
    beside the open pull request to tell a level moved under a run from a
    hand-back the solo has answered (solorepo's #117); a claim left standing after a
    hand-back is the loop saying it has stopped and is still working at once.
    """
    login = channel.login()
    channel.gh("issue", "edit", str(issue), "--remove-assignee", login, parse=False)
    who = [a["login"] for a in channel.gh("issue", "view", str(issue), "--json", "assignees")["assignees"]]
    if login in who:
        sys.exit(f"say: GitHub shows #{issue} still assigned to {login} after the call")
    print(f"released #{issue}; it is assigned to {', '.join(who) or 'nobody'}")


def stop(issue, body):
    """Where a loop stopped and why, handed to the solo (solorepo's DR-112): the refusal,
    the comment, the release, the move to `human`.

    The order is by what a failure after each act leaves behind. The refusal
    before anything is posted, or a retry posts the comment twice. The comment
    before the rest, so the Issue carries an account of where the loop stopped
    whatever fails next. The release before the move: a failed move leaves an
    unclaimed Issue at its old level, which the comment explains and a raiser
    can re-deliver; a failed release after the move would leave `human` and
    claimed, the one state the coder loop's guard reads as a run still
    standing (solorepo's #117). The pull request stays open — merged, never abandoned —
    for the run that takes the Issue up again.
    """
    challenge_labels(issue)
    channel.sibling("post").conversation_comment(issue, body)
    release(issue)
    difficulty(issue, "human")


def milestone(issue, title, clear=False):
    """Put an Issue in a Milestone, creating the Milestone when it is new, and
    read back.

    A Milestone is where the priority between Issues is written once (solorepo's DR-114);
    `just next` lists the lowest-numbered open one as next. Creating one is an
    act GitHub records against an account, and `gh` has no verb for it, so it
    goes through here like every other write.
    """
    if clear:
        channel.gh("issue", "edit", issue, "--milestone", "", parse=False)
        now = channel.gh("issue", "view", issue, "--json", "milestone")["milestone"]
        if now:
            sys.exit(f"say: GitHub shows #{issue} still in {now['title']!r} after the call")
        print(f"#{issue} is in no Milestone")
        return
    existing = [m["title"] for m in channel.gh("api", "repos/{owner}/{repo}/milestones?state=all&per_page=100")]
    if title not in existing:
        channel.gh("api", "repos/{owner}/{repo}/milestones", "-f", f"title={title}", parse=False)
        print(f"created Milestone {title!r}")
    channel.gh("issue", "edit", issue, "--milestone", title, parse=False)
    now = channel.gh("issue", "view", issue, "--json", "milestone")["milestone"]
    if not now or now["title"] != title:
        sys.exit(f"say: GitHub shows #{issue} in {now and now['title']!r} after the call, not {title!r}")
    print(f"#{issue} is in Milestone {title!r}")


# --- A pull request's: opened, layered, revised, merged, advanced, handed off.

def kind(number):
    """Pull request or Issue, asked of GitHub. The numbers are one sequence and
    the verbs that take either — `comment`, `revise` — should not make a
    caller say which."""
    found = channel.gh("api", f"repos/{channel.repo()}/issues/{number}")
    return "pull request" if found.get("pull_request") else "issue"


def revise(number, body=None, title=None):
    """Replace a body or a title, on a pull request or an Issue.

    A body is signed at creation and nowhere afterwards, so an edit that
    bypassed the channel would leave a Trailer naming the wrong Actor under
    prose that Actor never wrote. The title is what the index is worth, and
    changing it is an act GitHub records.
    """
    if body is None and title is None:
        sys.exit("say: nothing to revise — pipe a body in, or pass --title")
    what = kind(number)
    if what == "pull request":
        pr_data = None
        t, b = title, body
        if t is None or b is None:
            pr_data = channel.gh("pr", "view", str(number), "--json", "title,body")
            if t is None:
                t = pr_data["title"]
            if b is None:
                b = pr_data["body"]
        problems = check_pr.check(t, b)
        if problems:
            formatted = "\n".join(f"  - {p}" for p in problems)
            sys.exit(f"say: revised {'title and body' if body and title else 'title' if title else 'body'} "
                     f"does not satisfy the form (solorepo's A15):\n{formatted}\n"
                     "Fix the form before revising the pull request.")
    noun = "pr" if what == "pull request" else "issue"
    cmd = [noun, "edit", str(number)]
    if title is not None:
        cmd += ["--title", title]
    if body is not None:
        cmd += ["--body", body]
    channel.gh(*cmd, parse=False)
    print(f"{what} #{number}: {' and '.join(w for w, v in (('body', body), ('title', title)) if v is not None)} set")


def stacked(pr):
    """Whether a pull request is a layer of a stack, read from GitHub.

    The pull request payload carries a `stack` object on a layer and nothing
    otherwise. `gh pr view` does not expose it, so the endpoint is read.
    """
    return bool(channel.gh("api", f"repos/{channel.repo()}/pulls/{pr}").get("stack"))


def link(below, above):
    """Link one pull request onto another as the layer above it, as the Role.

    Linking is an act GitHub records, like a merge (solorepo's DR-075), so it goes through
    here, and it is not a verb: a layer is opened linked, `open --on`, or made
    one, `layer --on`, and the link is half of either. Open, then link, was a
    composition a caller assembled by hand and could leave half done (solorepo's DR-116).
    `gh stack submit` opens pull requests unsigned and stays blocked. After a
    layer merges, GitHub rebases the layers above it, which is the whole reason
    for a stack over a hand-built one (solorepo's DR-100).
    """
    print(channel.gh("stack", "link", str(below), str(above), parse=False))


def head_branch(pr):
    return channel.gh("pr", "view", str(pr), "--json", "headRefName")["headRefName"]


def layer(pr, below):
    """Make an open pull request a layer on another: retarget its base onto the
    lower layer's branch, and link the two.

    A pull request opened against trunk and found to wait on another (solorepo's DR-100)
    is retargeted rather than closed and reopened: it is merged, never
    abandoned, and the edit is an act GitHub records. Retargeting without
    linking left a pull request whose base was a branch GitHub would not
    rebase it over when that branch merged; both halves are one verb now.
    """
    base = head_branch(below)
    channel.gh("pr", "edit", str(pr), "--base", base, parse=False)
    now = channel.gh("pr", "view", str(pr), "--json", "baseRefName")["baseRefName"]
    if now != base:
        sys.exit(f"say: GitHub shows #{pr} based on {now} after the call, not {base}")
    link(below, pr)
    print(f"#{pr} is a layer on #{below} ({base})")


def open_pull_request(title, body, base="main", on=None):
    """Open a pull request, signed; with `on`, open it as a layer on that one.

    The base is the lower layer's branch, read from GitHub rather than typed,
    and the link follows the creation, so a layer is never open and unlinked.
    """
    problems = check_pr.check(title, body)
    if problems:
        formatted = "\n".join(f"  - {p}" for p in problems)
        sys.exit(f"say: pull request body does not satisfy the form (solorepo's A15):\n{formatted}\n"
                 "Fix the form before opening the pull request.")
    if on:
        base = head_branch(on)
    url = channel.gh("pr", "create", "--title", title, "--base", base, "--body", body, parse=False)
    print(url)
    if on:
        link(on, url.rstrip("/").rsplit("/", 1)[-1])


def arm(pr, subject):
    """Hand GitHub the intent to merge when the ruleset is satisfied.

    One call, and two callers: the merge verb arming for the first time, and
    `advance` arming again where moving the branch dropped it.
    """
    channel.gh("pr", "merge", pr, "--squash", "--auto", "--subject", subject, parse=False)


def behind_by(pull):
    """How many commits of its base a pull request's head is missing.

    `mergeStateStatus` is the obvious question and answers a different one.
    GitHub computes it when it is asked for, so the first read after a push to
    trunk is `UNKNOWN`; and `BLOCKED` outranks `BEHIND`, so a pull request
    waiting on a review reports the review and hides the fact that it is also
    out of date — which is every `medium` pull request (solorepo's DR-112), and the case
    where nobody is watching. A comparison answers what is actually being
    decided: whether the head is missing commits the base has. GitHub answers
    that the same way whatever else is outstanding.
    """
    return channel.gh("api", f"repos/{channel.repo()}/compare/"
                             f"{pull['baseRefName']}...{pull['headRefOid']}")["behind_by"]


ADVANCE = ("number,title,state,baseRefName,headRefName,headRefOid,autoMergeRequest,"
           "reviewRequests,mergeable,latestReviews,updatedAt")


def head_now(number):
    """The commit GitHub has a pull request on, and what that commit is behind
    its base by — the two read beside each other, in that order.

    One question in two parts: whether there is a rebase to ask for, and which
    commit it would be asked against. `advance` asks it twice — once to find
    out there is work, and again when the waiting is over and the call is the
    next thing that happens — and the pair is written here so that the second
    asking cannot anchor the compare to a different reading than the first did.
    """
    before = channel.gh("pr", "view", str(number), "--json", ADVANCE)
    return before, behind_by(before)


is_approved_pull = check_pr.is_approved_pull
is_changes_requested_pull = check_pr.is_changes_requested_pull


# A loop's branch, and nothing else. `(claude|gemini|codex)/issue-<n>` is the shape `coder.yml`
# cuts, so it is the shape a dispatched coder can be sent back to; the solo's
# own pull request is the solo's to rebase, whatever it looks like from here.
LOOPS_BRANCH = re.compile(r"^(?:claude|gemini|codex)/issue-\d+$")
# How long to wait for GitHub to say whether a branch still merges. `mergeable`
# is computed in the background when it is asked for, and GitHub's reference
# for it says to poll until the value is no longer null — which `gh` spells
# `UNKNOWN`. This runs on the push that invalidated every cached answer, which
# is exactly the read the reference warns about: asked once, every waiting pull
# request would report `UNKNOWN` and nothing would ever be dispatched.
MERGEABILITY = (6, 5)


def mergeability(pull):
    """Whether GitHub can still merge this branch into its base.

    Waited for rather than read once, for the reason above. The first read is
    the one already in hand, so a pull request GitHub has an answer for costs
    nothing; only an `UNKNOWN` pays, and it pays in a sleep rather than in a
    wrong answer. Bounded, because a value that is still unknown after half a
    minute is one the next push to trunk will ask about again — and a sweep
    that waited forever on one branch would hold up the rest.
    """
    tries, wait = MERGEABILITY
    answer = pull.get("mergeable")
    for _ in range(tries):
        if answer != "UNKNOWN":
            break
        time.sleep(wait)
        answer = channel.gh("pr", "view", str(pull["number"]),
                            "--json", ADVANCE).get("mergeable")
    # Settled onto the pull request the caller holds, so the sweep's two
    # readings of one branch cost one question (solorepo's DR-149). `advance`
    # asks before it rebases and `dispatch` asks again about the same object —
    # `found` is filtered out of `open_now`, not copied — and the only thing
    # that moves between the two is a rebase this run performed, which GitHub
    # would not have performed on a branch that conflicts.
    pull["mergeable"] = answer
    return answer


# How long to wait for GitHub to *show* an act it has accepted. The sibling of
# `MERGEABILITY` above and a different question: that one waits on a value
# GitHub computes when asked, this one on work GitHub queues and performs.
# `gh pr update-branch --rebase` returns when GitHub has taken the rebase, not
# when it has done it — measured on runs 34593386083 and 34594139086, where the
# branch heads were rewritten one to two seconds after the call and a `pr view`
# half a second later still answered with the head they had before. Same bound
# as the other, because a branch GitHub has not moved after half a minute is
# one the next push to trunk will ask about again.
SETTLES = (6, 5)


def settled(read, shows):
    """What GitHub holds once it shows the act asked of it — or what it still
    holds when the wait runs out, which is the caller's to report.

    The first read is the one that usually answers, so an act GitHub has
    already shown costs one question and no sleep; only the read that is too
    early pays, and it pays in a wait rather than in a wrong answer. The
    predicate is the caller's because what counts as shown differs: a head that
    has moved off the commit it was on, an arming GitHub lists.
    """
    tries, wait = SETTLES
    answer = read()
    for _ in range(tries):
        if shows(answer):
            break
        time.sleep(wait)
        answer = read()
    return answer


def run_coder(pr, task):
    """Start one of `coder.yml`'s passes on a pull request: the dispatch itself.

    Written once because it has two callers — `dispatch` below, on the merge
    that stranded a review request, and `dispatch_pass`, where a person makes
    the same act — and for the reason the task is passed at all: `coder.yml`
    defaults the input to `review`, so a dispatch that dropped it would run the
    pass that answers threads on a branch whose problem is a conflict.
    """
    channel.gh("workflow", "run", "coder.yml", "-f", f"pull_request={pr}",
               "-f", f"task={task}", parse=False)


def dispatch(pulls):
    """Hand back to the coder a pull request this push has left conflicting
    while it was waiting to land (solorepo's DR-133, solorepo's DR-149).

    The other thing a merge on `main` does. A review request is a semaphore
    GitHub holds and reports, and a branch that conflicts has no merge ref, so
    `review.yml`'s `pull_request` trigger has nothing to check out: no run is
    created, GitHub goes on reporting the request as outstanding, and the Job
    it names never learns it was asked. solorepo's #159 and solorepo's #161 each stood that way
    with not one review run between them.

    **Or armed**, which is the same conflict at the other end of the Discipline
    (solorepo's DR-149). The rebase above is what an armed pull request gets
    when it has merely fallen behind, and it is not available here either:
    GitHub refuses `update-branch` on a `CONFLICTING` branch, so on
    solorepo's #201 every push to `main` after solorepo's #194 landed collected
    the same refusal and nothing moved. What the two states share is the fact
    this reading is about — the branch conflicts, and the Job that did the work
    has ended — and what the filter is for is the branch nobody has handed over
    yet, which is neither requested nor armed. A pull request asked for a review is waiting
    on the review; one that is armed is waiting on the merge; one asked for
    neither may still have a Job standing on it, and a dispatched pass would
    force-push under it.

    **Dispatched, not rebased.** The rebase above is not the remedy here and
    cannot be: GitHub refuses to update a branch it reports as `CONFLICTING`,
    and what a conflict needs is the change made again over what landed, which
    is authoring. So what this moves is a Job and not a branch — `coder.yml`'s
    rebase pass, on the pull request, which is the same act the sweep already
    prescribes to a reader (solorepo's DR-129) and the same one that was
    performed by hand on solorepo's #141, solorepo's #150 and solorepo's #156 in one evening.

    Which is also why the filter above stays as it is. Widening it to every
    pull request with a request outstanding would rebase the ones that merely
    fell behind, and those are the ones nothing is wrong with: their merge ref
    exists, so the review runs, and `merge --auto` advances the branch before
    it arms. What the rebase would cost them is the review itself.
    `review.yml` cancels a review in progress on a `synchronize` by anyone but
    the reviewer, so on an evening where `main` merges more often than a review
    takes, every review would be restarted by the next merge and none would
    finish.

    A loop's branch only. A conflict on the solo's own branch is the solo's,
    and the sweep names it for a reader either way.

    **And only a Challenge the loop holds.** The branch shape says which
    Issue and nothing about whose it is (solorepo's DR-142): a `hard` Issue is
    the solo's with a session beside him, and `human` is where a pass that
    could not settle a conflict left it, through `stop`, with the request
    still outstanding and the branch still conflicting — which is this
    reading's four facts exactly, on every push to `main` after it. Without
    this read each of those pushes dispatched a pass that stood down at
    `coder.yml`'s guard and said so on the pull request, one copy per merge,
    until the solo got to the branch. So the Issue's state and level are read
    here, before the dispatch, and a Challenge the loop does not hold is
    named on the way past: the sweep already names a pull request stuck on a
    conflict, requested or armed (solorepo's DR-129, solorepo's DR-149), and
    that is the reader's line, not this one's.

    **And never the lower layer of a stack**, which is the third thing
    solorepo's DR-133 rejected the wider filter for and so a thing this reading
    has to answer too. The armed filter above is what keeps the rebase off a
    stack, because GitHub arms no layer of one (solorepo's DR-100); dropping it
    here would put the bottom layer back in reach, since `layer` and
    `open --on` retarget only the layer above, so the bottom keeps `main` as
    its base and a `claude/issue-<n>` head, a `medium` layer requests review,
    and a merge on `main` is exactly what conflicts it. Rebasing it rewrites
    the commits the layer above is based on, and the harm is silent: the upper
    layer's head never moves, so no event fires and the next reader of it sees
    the lower layer's work shown as its own. Which pull requests those are is
    already in hand — a branch that is another open pull request's base is a
    layer below it — so the answer costs a set comprehension rather than a
    read, and the one it declines is named on the way past rather than
    skipped in silence. A conflicting stack is the solo's: the layers have to
    be resolved from the bottom, and that is a judgement about the stack and
    not about any one of its pull requests.

    **What stands in for the read-back.** GitHub answers a dispatch with no
    content and creates the run afterwards, so there is nothing here to ask it
    for, and a `run list` a moment later answers about a run that may not exist
    yet. Two things carry it instead. `coder.yml` groups the rebase pass by
    pull request with `cancel-in-progress: false`, so two pushes in quick
    succession leave one run standing and one waiting rather than two rebasing
    the same branch. And the pass begins by asking whether the branch is
    current with its base, so a run that arrives after the work is done says so
    and stops — which is what makes a dispatch that was one too many cost a
    minute rather than a mess.
    """
    failed = []
    # Every branch an open pull request is based on, which is the lower layer
    # of every open stack. Read off the list already in hand: `open_now`
    # carries both refs of every open pull request, so no layer has to be
    # asked about a second time.
    below = {pull["baseRefName"] for pull in pulls}
    reviewer_login = channel.role_login("reviewer")
    minutes = check_pr.longest_run() or 30
    now = datetime.datetime.now(datetime.timezone.utc)
    for pull in pulls:
        if not LOOPS_BRANCH.match(pull["headRefName"]):
            continue
        number = str(pull["number"])
        challenge = re.sub(r"^(?:claude|gemini|codex)/issue-", "", pull["headRefName"])
        asked = [r.get("login") or r.get("name") or "someone"
                 for r in pull.get("reviewRequests") or []]
        # What the pull request is waiting on, and so what the conflict is
        # holding up. Both, where the reviewer armed one whose request GitHub
        # still shows outstanding; the line below says which, because that is
        # what the dispatch is repairing.
        waiting = [f"requested of {', '.join(asked)}"] if asked else []
        if pull.get("autoMergeRequest"):
            waiting.append("armed")
        if is_approved_pull(pull, reviewer_login=reviewer_login):
            waiting.append("approved")
        if waiting:
            waits = " and ".join(waiting)
            if pull["headRefName"] in below:
                print(f"left #{number} alone: another open pull request is based on "
                      f"{pull['headRefName']}, so rebasing it would rewrite the commits the "
                      f"layer above is on — a conflicting stack is resolved from the bottom, "
                      f"by the solo — {pull['title']}")
                continue
            try:
                if mergeability(pull) != "CONFLICTING":
                    continue
                # Its own refusal, and not the dispatch's below: an Issue deleted
                # or transferred under its branch fails this read the same way on
                # every push to trunk, and a red sweep each time is the repetition
                # this read exists to stop. `coder.yml` gives the same fact a word
                # on its doors, `unnamed`; here it is a line, and the sweep's.
                try:
                    issue = channel.gh("issue", "view", challenge, "--json", "state,labels")
                except SystemExit:
                    print(f"left #{number} alone: #{challenge} cannot be read, so the conflict "
                          f"is the solo's, and the sweep names it — {pull['title']}")
                    continue
                levels = {l["name"] for l in issue["labels"]} & {"easy", "medium"}
                if issue["state"] != "OPEN" or not levels:
                    print(f"left #{number} alone: #{challenge} is "
                          f"{'closed' if issue['state'] != 'OPEN' else 'at a level no loop takes'}, "
                          f"so the conflict is the solo's, and the sweep names it — "
                          f"{pull['title']}")
                    continue
                run_coder(number, "rebase")
            except SystemExit as exc:
                failed.append(f"#{number} is {waits} and the coder could not be "
                              f"dispatched for it — {exc.code}")
                continue
            print(f"dispatched the coder for #{number}: {waits}, and conflicting with "
                  f"{pull['baseRefName']}, so GitHub builds no merge ref and will not update "
                  f"the branch — {pull['title']}")
        elif is_changes_requested_pull(pull, reviewer_login=reviewer_login):
            # An unanswered review changes request where the webhook was spent or the run crashed.
            # Only re-deliver when the branch does not conflict and has been idle for longer than
            # a run may last, ensuring no active coder run is standing on the branch.
            moved = (datetime.datetime.fromisoformat(pull["updatedAt"].replace("Z", "+00:00"))
                     if pull.get("updatedAt") else None)
            idle = (now - moved).total_seconds() / 60 if moved else float("inf")
            if idle < minutes:
                continue
            try:
                if mergeability(pull) == "CONFLICTING":
                    continue
                try:
                    issue = channel.gh("issue", "view", challenge, "--json", "state,labels")
                except SystemExit:
                    print(f"left #{number} alone: #{challenge} cannot be read, so the review "
                          f"is the solo's, and the sweep names it — {pull['title']}")
                    continue
                levels = {l["name"] for l in issue["labels"]} & {"easy", "medium"}
                if issue["state"] != "OPEN" or not levels:
                    print(f"left #{number} alone: #{challenge} is "
                          f"{'closed' if issue['state'] != 'OPEN' else 'at a level no loop takes'}, "
                          f"so the review is the solo's, and the sweep names it — "
                          f"{pull['title']}")
                    continue
                run_coder(number, "review")
                print(f"dispatched the coder for #{number}: changes requested by reviewer, "
                      f"re-delivering pass — {pull['title']}")
            except SystemExit as exc:
                failed.append(f"#{number} has changes requested and the coder could not be "
                              f"dispatched for it — {exc.code}")
    return failed


# The two states of a review that decide anything. A `COMMENTED` review is what
# every reply on a thread is submitted under and says nothing about the pull
# request; a `DISMISSED` one is a verdict GitHub has already taken back.
VERDICTS = ("APPROVED", "CHANGES_REQUESTED")


def dispatch_pass(pr, task):
    """Start a coder pass on a pull request by hand: the act PR First's third
    step names, as a verb rather than as a command typed at GitHub.

    `coder.yml`'s events do not reach everything the coder is for. A verdict a
    session leaves behind is delivered once and to nobody, because moving the
    Issue back down fires the Issue door and re-delivers no review
    (solorepo's DR-142); and the rebase pass has no event of its own at all,
    which is why `advance` dispatches it above on the merge that caused it
    (solorepo's DR-133). Both gaps were named as the solo's to dispatch by hand,
    and by hand meant `gh workflow run coder.yml`, typed with whatever
    credential `gh` holds and refused by nothing: `GH_WRITES` in
    `.meta/hooks/signed_channel.py` named the CLI's writing verbs one by one and
    this was not among them. Starting a Job is an act GitHub records against an
    account, like a merge (solorepo's DR-075), so it belongs here — and the
    verb is only half of that pattern, which is why the hook now names the raw
    spelling too (solorepo's DR-151). The machine's dispatch was the channel's
    already; now a person's is, and there is no longer a shorter way.

    **The solo's, and the pull request is all that is read.**
    solorepo's DR-142 puts one guard on both of `coder.yml`'s doors and exempts
    exactly one delivery — the dispatch of a review pass, because the solo
    dispatching is the solo deciding. So nothing here reads the Challenge's
    level or its claim, and this verb does not become a second guard in front
    of the door that deliberately has none.

    **What it does refuse** (solorepo's DR-116). A pass with nothing to do, and
    a rebase pass that would do harm — which together are the whole of what the
    pull request can answer.

    The review pass reads the threads and answers a request for changes, so it
    needs one standing: the newest verdict the reviewer's account left, and no
    review outstanding of that account — a request pending is the coder having
    answered already and handed back, which is the reviewer's turn and not a
    pass to run again.

    The rebase pass takes three, and each of them is one `advance`'s own
    dispatch takes, for the reason solorepo's DR-133 gave it there — two off
    its filter, and the stack off the consequence that excludes that case
    directly. What is not here is the other thing that filter reads, a review
    request outstanding: that is what makes the machine's dispatch necessary
    rather than what makes a rebase pass sensible, and the solo dispatching has
    decided the branch needs one already. The
    branch must be one GitHub reports as `CONFLICTING`: that is the state with
    no merge ref, where no review of the head can run and where `gh pr
    update-branch` is refused. A branch that has merely fallen behind is
    waiting on nothing — its merge ref exists, so the review runs on the head
    as it stands, and the branch is brought onto its base when it is armed, by
    `merge --auto` before the arming or by `advance` on the next push to trunk.
    The branch must be `claude/issue-<n>`, because that name is how the pass
    finds the Challenge it would hand back to: `coder.yml` refuses the rest
    itself, but after the dispatch, where the refusal is a red run attached to
    no check — and a name that is nearly the shape, `claude/issue-<n>-followup`,
    does not reach even that: the guard reads it as naming no Challenge, the
    rebase step is skipped, and the run ends green having done nothing at all.
    And the pull request must not be a layer of a stack. Rebasing the bottom
    layer rewrites the commits the layer above is based on and the harm is
    silent, because the upper layer's head never moves and so fires no event;
    a conflicting stack is resolved from the bottom, and that is a judgement
    about the stack rather than about any one of its pull requests, which is
    why this declines a layer wherever it sits rather than asking which.

    **What stands in for the read-back.** Starting a run is asynchronous and returns no immediate run ID, so there is nothing to verify on the remote in the moment: a dispatch returns no content and
    the run is created afterwards, so a `run list` a moment later asks about a
    run that may not exist yet. `coder.yml` groups both passes by pull request
    with `cancel-in-progress: false`, and the review pass takes the verdict's
    own key, so a dispatch that was one too many waits behind the run already
    going rather than racing it. What is printed is where the run will appear.
    """
    pull = channel.gh("pr", "view", str(pr), "--json", f"{ADVANCE},reviews")
    if task == "rebase":
        # The branch's shape first, because it is free and it is the commonest
        # thing this verb is typed against: `advance` never dispatches for the
        # solo's own branch, so the branch this one meets is the one the
        # machine's filter passes over.
        if not LOOPS_BRANCH.match(pull["headRefName"]):
            sys.exit(f"say: #{pr} is on {pull['headRefName']}, which is not a loop branch `(claude|gemini|codex)/issue-<n>`. "
                     "The rebase pass reads the Challenge it would hand back to off the branch "
                     "name, so on any other shape a pass that could not settle the conflict "
                     "has nowhere to stop. `coder.yml` holds that refusal already and holds it "
                     "after the dispatch, where it is a red run attached to no check; a name "
                     "that only nearly fits, `claude/issue-<n>-followup`, does not reach even "
                     "that — the guard reads it as naming no Challenge, the rebase is skipped, "
                     "and the run ends green having done nothing. Rebase it by hand.")
        # Then the stack, which is one read, and then the conflict, which may
        # cost half a minute of polling: a refusal that is certain is not worth
        # waiting for GitHub to compute an answer this verb will not use.
        if stacked(pr):
            sys.exit(f"say: #{pr} is a layer of a stack, and rebasing one moves commits the "
                     "layer above may be based on with no event on it to say so, so the next "
                     "reader of that layer sees this one's work shown as its own "
                     "(solorepo's DR-133). A conflicting stack is resolved from the bottom, "
                     "which is a judgement about the stack and not about any one of its pull "
                     "requests: `advance` declines the same case, and this one is the solo's "
                     "to settle by hand.")
        merges = mergeability(pull) or "UNKNOWN"
        if merges != "CONFLICTING":
            sys.exit(f"say: GitHub reports #{pr} as {merges} against "
                     f"{pull['baseRefName']}, not CONFLICTING, and the rebase pass is for a "
                     "branch GitHub builds no merge ref for — which is the state where no "
                     "review of the head can run and nothing but authoring can fix it. One "
                     "that has merely fallen behind is waiting on nothing and needs no Job: "
                     "its merge ref exists, so a review runs on the head as it stands, and "
                     "the branch comes onto its base when it is armed — `merge --auto` "
                     "advances before it arms, and `advance` sweeps up an armed one on the "
                     "next push to trunk.")
    else:
        reviewer = channel.role_login("reviewer")
        if reviewer in [r.get("login") for r in pull.get("reviewRequests") or []]:
            sys.exit(f"say: GitHub shows a review of #{pr} requested of {reviewer} and not yet "
                     "given, so what stands on it is the reviewer's. The review pass answers a "
                     "verdict; a verdict answered and handed back is not one to answer again.")
        given = [r["state"] for r in pull.get("reviews") or []
                 if (r.get("author") or {}).get("login") == reviewer and r["state"] in VERDICTS]
        if not given or given[-1] != "CHANGES_REQUESTED":
            sys.exit(f"say: the last verdict {reviewer} left on #{pr} is "
                     f"{given[-1] if given else 'nothing'}, and the review pass is for a request "
                     f"for changes: it reads the threads and answers them. `move request-review "
                     f"{pr}` asks for a verdict; this dispatches the pass that answers one.")
    run_coder(pr, task)
    print(f"dispatched the coder's {task} pass for #{pr} — {pull['title']}. GitHub creates the "
          "run after it answers the dispatch, so there is nothing to read back yet: "
          "`gh run list --workflow coder.yml` names it once it exists.")


def advance(pr=None, held=False):
    """Bring armed pull requests that have fallen behind their base back onto it,
    and, on the push to trunk, give the coder back the ones that merge left
    unreviewable.

    An armed merge does not update its own branch, and `main` requires a pull
    request to be current before it merges. So when two are green at once the
    first lands and the second goes behind, armed, waiting for a Job that ended
    when it armed — and nobody is told, because there is nobody left to tell
    (solorepo's #93). This is the step that moves it. `merge --auto` runs it before
    arming, since a branch can be behind before it is armed as easily as
    after; the other edge is `.github/workflows/advance.yml`, which runs this
    on every push to trunk, the one event that puts a pull request in that
    state (solorepo's DR-113). Both edges are covered, so nobody should have to type this
    — it takes a pull request number for the day one is behind for a reason
    neither edge saw.

    **Armed or approved, and not another open pull request's base** (solorepo's DR-133, solorepo's DR-161).
    A pull request nobody has asked to land is not waiting on anything, and the
    rebase below rewrites commits under whatever session still holds the branch.
    Arming was historically the last act of the Job that did the work (solorepo's DR-112);
    with a standing merge manager (solorepo's DR-161), reviewer approval is what frees
    a pull request to land. Both are swept, but crucially excluding any branch
    that is another open pull request's base: as solorepo's DR-133 noted, rebasing a lower layer
    rewrites the commits the layer above is based on, causing it to conflict.
    Excluding bases keeps the stack intact while keeping ready pull requests
    current with their base. The filter used to be the sweep's
    alone and the explicit argument rebased whatever it was handed — which left
    the property holding on the path nothing calls and not on the one
    `merge --auto` uses (solorepo's #98).

    `held` is the one exemption, and it is the caller saying which branch it is
    standing on: `merge --auto` is the Job that did the work, arming in a moment,
    so for that call the question the arming answers is already answered. It is
    an argument of the function and not of the verb, because what a caller can
    pass a typed command can pass wrongly, and by hand this is only ever wanted
    for a pull request that stalled — which is to say an armed or approved one.

    **By rebase, not by a merge commit.** GitHub authors the merge commit
    itself and it carries no `Actor` Trailer, so A19 would turn the required
    check red on the very branch this is unblocking — the fix would be the
    defect wearing a new coat. A rebase writes no new commit: the branch's own
    commits move onto the base with their messages, and so with their Trailers,
    intact.

    Read back from GitHub afterwards: we must verify that the remote branch has actually been updated, and that auto-merge is still armed if it was. Three things are asked, and they are asked independently.
    Whether the head is current now — the base can move again while this runs,
    and a second push is a second run's business, not a silent pass. Whether
    the arming survived the head moving: GitHub drops auto-merge on some pushes
    to a head branch, and an update that disarmed what it was unblocking would
    leave the pull request exactly where it was found, with the sole witness
    gone. The second used to hang off the first as an `elif`, so the one state
    it exists to repair — moved, disarmed, and behind again — was the one state
    it never looked at (solorepo's #98). And whether re-arming took, which is the same
    question `merge --auto` asks of its own arming and the one this path was
    still answering from an exit code.

    **And "afterwards" is waited for** (solorepo's DR-158). `gh pr
    update-branch --rebase` returns when GitHub has taken the rebase, not when
    it has performed it, so the read that followed it answered about the head
    the branch still had — every `advance` on 2026-09-11 concluded failure
    while doing its work correctly, and a workflow that is always red cannot
    report the one case it exists to catch. The head moving off the commit it
    was on is the rebase landing, so that is what the read-back waits for,
    bounded by `SETTLES`; both of the questions above are then asked of a pull
    request GitHub has finished moving. A head that has not moved when the wait
    runs out is its own line, because it is a different fact from a branch that
    is behind: the rebase may still land, and dropping the arming as it does.

    **And the commit the head questions are about is read beside them, not off
    the sweep's opening list.** "Behind" and "moved" are both facts about a
    named commit, and the one that matters is the commit GitHub is handed. The
    list this sweep opens with is as old as every pull request ahead of this one
    in `found` — each of which may have paid `MERGEABILITY`'s poll or `SETTLES`'
    wait — so a push to this branch inside that window moves the head before
    this run asks anything of it, and both questions asked of the listed commit
    answer about one GitHub is no longer on. The wait is satisfied by the push
    rather than by the rebase, and answers with the pre-rebase pull request:
    behind by what it was behind by, which is reported as a rebase that did not
    take, and carrying an arming the rebase is about to drop, which is the
    arming never restored. And the decision to rebase is taken on how far behind
    an orphaned commit was, so a push that brought the branch current is
    rebased anyway — `update-branch` on nothing, and then whatever GitHub does
    with that read as the rebase that did not land. A `pr view` beside the call
    answers both questions about the commit GitHub is on, needs no answer about
    what GitHub does with a no-op rebase because it stops asking for one, and
    makes the `advanced #N: N commit(s) behind` line say a number that is true
    when it is printed.

    **And "beside" means after the poll, not before it.** `mergeability` stands
    between the two, and on this trigger it is a wait and not a question:
    `MERGEABILITY`'s own reasoning is that the push to trunk invalidates every
    cached answer, so the listed `mergeable` reads `UNKNOWN` for every pull
    request waiting on one and the poll sleeps five seconds at least and thirty
    at most. A read taken above it and used below it would leave a window of
    that length, on exactly the pull requests this runs for. So the reading is
    taken twice: once at the top, which costs the one read the sweep was always
    going to pay and says whether there is work here and what the `left #N`
    line counts; and once after the poll has answered, which is the one the
    rebase is decided on and measured against. The second costs a `pr view` on
    the branches being rebased and on no others, and with nothing between it
    and `update-branch` the window that is left is the round trip.

    **One pull request's refusal is not the sweep's.** `gh()` reports by ending
    the process, so a branch GitHub will not rebase, or will not arm, used to
    take every other pull request down with it and swallow what had already been
    collected. Each is caught where it happens and joins `failed`, which is what
    the accumulator was for.

    **And the armed are not everything a merge on trunk leaves behind.** A pull
    request waiting on its first review cannot be armed — GitHub refuses
    auto-merge on a stacked one, and request-then-arm is not the order the
    Discipline gives — so nothing above this paragraph is about it, and a merge
    can leave it conflicting with the request still outstanding and nobody
    able to answer. That one is handed to the coder rather than rebased here,
    which is `dispatch` below and solorepo's DR-133. It runs on the sweep only,
    and it is why the list is filtered into `found` rather than over itself:
    what the rebase may touch is the armed, and what the dispatch reads is
    every open pull request.

    **And a rebase is not what an armed pull request that conflicts needs
    either** (solorepo's DR-149). GitHub refuses `update-branch` on a branch it
    reports as `CONFLICTING`, so on the sweep that branch is left to the
    dispatch, which now takes an armed pull request as well as a requested
    one; the rebase attempted anyway is a refusal known before it is made, and
    it took `advance.yml` red on every push to trunk while the branch
    conflicted (solorepo's #201). Only on the sweep, because only there is
    there a dispatch behind the skip. A typed `advance <pr>` and
    `merge --auto`'s call are somebody asking about one branch, and to them
    GitHub's refusal is the answer.
    """
    if pr is not None:
        open_now = [channel.gh("pr", "view", pr, "--json", ADVANCE)]
        bases = {p.get("baseRefName") for p in channel.gh("pr", "list", "--state", "open", "--json", "baseRefName") if p.get("baseRefName")}
    else:
        open_now = channel.gh("pr", "list", "--state", "open", "--json", ADVANCE)
        bases = {p.get("baseRefName") for p in open_now if p.get("baseRefName")}
    reviewer_login = channel.role_login("reviewer")
    found = open_now if held else [
        p for p in open_now
        if (p.get("autoMergeRequest") or is_approved_pull(p, reviewer_login=reviewer_login)) and p.get("headRefName") not in bases
    ]
    # `left` is counted out of the summary below and not into `moved`: a branch
    # left to the dispatch is neither advanced nor current with its base, and the
    # line that says how many were current is the one place this run says
    # nothing happened. It has already said what happened to that one.
    moved, left, failed = 0, 0, []
    if not found:
        # Two answers, and only one of them is "nothing to do". A sweep with
        # nothing armed open did its whole job and exits 0. A named pull request
        # that is not armed is a *refusal* — the caller asked for one thing and
        # the verb declined it — and every other refusal in this file exits
        # non-zero. `main()` passes no `held`, so for a typed `advance <pr>`
        # this is the terminal answer; sharing an exit code with the sweep is
        # how `move advance 92 && <next>` carries on as though the branch
        # had moved.
        if pr is not None:
            pull = open_now[0]
            if pull.get("headRefName") in bases:
                sys.exit(f"say: #{pr} is the base of another open pull request; rebasing it would conflict the stack (solorepo's DR-133)")
            sys.exit(f"say: #{pr} is not armed or approved; nothing has asked it to land")
        print("advance: nothing armed or approved is open")
    else:
        for pull in found:
            number = str(pull["number"])
            try:
                # Read here rather than taken off the `pr list` this sweep
                # opened with: that list is as old as every pull request ahead
                # of this one in `found`, each of which may have waited on
                # `mergeability` or on `settled`, and a push to this branch
                # inside that window moves the head before this run asks
                # anything of it. It costs one read per pull request the sweep
                # selected, and it answers the two cheap questions: whether
                # there is anything to do here at all, and what the `left #N`
                # line below counts.
                before, behind = head_now(number)
                if not behind:
                    continue
                if pr is None and mergeability(pull) == "CONFLICTING":
                    # Left to the dispatch below (solorepo's DR-149). GitHub
                    # refuses `update-branch` on a branch it reports as
                    # `CONFLICTING`, so the call would be a refusal known in
                    # advance, collected into `failed` and exited on — which is
                    # `advance.yml` red on every push to trunk for as long as
                    # the branch conflicts, and a red that says nothing is how
                    # the next refusal goes unread. Said on the way past rather
                    # than skipped in silence, because the dispatch may decline
                    # it for a reason of its own and then nothing else would —
                    # and named for the dispatch rather than for the coder,
                    # since in every case that sentence anticipates there is no
                    # coder, and a line claiming a handoff that did not happen
                    # is worse in the log than no line at all.
                    print(f"left #{number} to the dispatch below: {behind} commit(s) behind "
                          f"{pull['baseRefName']} and conflicting with it, which GitHub "
                          f"will not rebase — {pull['title']}")
                    left += 1
                    continue
                # And asked again, because what stands between the read above
                # and the call below is a poll rather than a round trip.
                # `mergeability` sleeps `MERGEABILITY` — five seconds at least
                # and thirty at most — whenever the value it is handed reads
                # `UNKNOWN`, and its own constant says that is the normal state
                # on this trigger and not a corner: the push to trunk this
                # sweep runs on invalidates every cached answer, so the listed
                # `mergeable` is `UNKNOWN` for every pull request waiting on
                # one. A push landing inside that sleep is the whole defect
                # again — the rebase asked for on a commit GitHub has moved
                # off, and asked for at all on a branch the push brought
                # current — so the reading the call is made against is the one
                # taken after the waiting is over. It costs a second `pr view`
                # on the branches actually being rebased, and on those alone,
                # and it is what makes the residual window a round trip.
                before, behind = head_now(number)
                if not behind:
                    continue
                channel.gh("pr", "update-branch", number, "--rebase", parse=False)
                moved += 1
                print(f"advanced #{number}: {behind} commit(s) behind {pull['baseRefName']} "
                      f"— {pull['title']}")
                # The head moving is the rebase happening, so it is what this
                # waits for rather than asks about once (solorepo's DR-158).
                # Both questions below are about a pull request GitHub has
                # finished rebasing, and asked of one it has not they read the
                # state it is being moved out of: how far behind the old head
                # was, and the arming that head still carries.
                after = settled(lambda: channel.gh("pr", "view", number, "--json", ADVANCE),
                                lambda now: now["headRefOid"] != before["headRefOid"])
                if after["headRefOid"] == before["headRefOid"]:
                    failed.append(f"#{number} is on the head it was before the update and "
                                  "GitHub has not moved it within the wait, so whether the "
                                  "rebase drops the arming is unread — and dropped, it is "
                                  "out of reach of every later sweep")
                elif behind_by(after):
                    failed.append(f"#{number} is still behind {pull['baseRefName']} "
                                  "after the update")
                # And this one is anchored to the sweep's own reading rather
                # than to `before`, deliberately. The question above is which
                # commit the rebase moved the branch off, and only the read
                # taken beside the call answers it. The question here is
                # whether the pull request ends armed, and what it was armed at
                # is what the sweep selected it on: a push that dropped the
                # arming inside the window is the same solorepo's #93 the
                # rebase would have left, and reading `before` would leave it
                # there on the ground that this run was not the one that
                # dropped it.
                if pull.get("autoMergeRequest") and not after.get("autoMergeRequest") and after.get("state") != "MERGED":
                    arm(number, f"{pull['title']} (#{number})")
                    # Read back, like the two above and for the same reason. This
                    # was the one act in the function whose outcome was `gh`'s exit
                    # status: `gh pr merge --auto` exits 0, the enablement does not
                    # stick, and the line below claimed an arming GitHub does not
                    # hold. That leaves the pull request rebased and unarmed, which
                    # is solorepo's #93 — and unreachable by any later sweep, because the sweep
                    # filters on `autoMergeRequest` and there is no longer one to
                    # filter on. Waited for, like the read above and unlike it on
                    # no measurement: what an early read here would produce is the
                    # false report's mirror, a branch GitHub is holding armed
                    # called unarmed, and the wait costs a sleep only on the
                    # branch this is about to report as broken anyway.
                    # And an arming that took is not the only end to the wait.
                    # Arming is an intent GitHub holds until it acts on it, so
                    # the checks going green in this window merge the pull
                    # request and clear the `autoMergeRequest` that did it —
                    # which is the arming having worked, read a moment too late
                    # to see. Waited for on the predicate alone, that is the
                    # full bound spent and then the line below on a pull request
                    # that is on trunk: `merge` reads `MERGED` for the same
                    # reason and says so, and this is the same state reached
                    # from the other side.
                    now = settled(lambda: channel.gh("pr", "view", number, "--json", ADVANCE),
                                  lambda seen: seen.get("autoMergeRequest")
                                  or seen["state"] == "MERGED")
                    if now["state"] == "MERGED":
                        print(f"merged #{number}: re-armed after the update, and green")
                    elif not now.get("autoMergeRequest"):
                        failed.append(f"#{number} lost its arming to the update and GitHub "
                                      "does not show it armed after the call that re-armed it")
                    else:
                        print(f"armed #{number} again: moving the head had dropped it")
            except SystemExit as exc:
                failed.append(f"#{number}: {exc.code}")
        if not moved and not failed and len(found) > left:
            print(f"advance: {len(found) - left} pull request(s) current with their base")
    # The second reading, and the sweep's alone. `merge --auto` calls this with
    # one pull request and its own branch in hand, and a typed `advance <pr>`
    # names a branch somebody is asking about; neither is the push to trunk
    # that leaves a review request unanswerable, which is what `dispatch`
    # answers. Its refusals join the same accumulator, so a pull request the
    # coder could not be dispatched for is reported with the rest and takes
    # none of them down with it.
    if pr is None:
        failed += dispatch(open_now)
    if failed:
        sys.exit("say: " + "; ".join(failed))


def merge(pr, stack=False, auto=False):
    """Merge as the Role, label trunk with the pull request's title, and report
    what GitHub holds afterwards. With `stack`, merge every layer up to and
    including this one, atomically, and let GitHub rebase the rest.

    Not an utterance, and still the channel's. Merging is an act by the Role —
    solorepo's DR-072 puts it in an agent's hands and solorepo's DR-075 puts the act through here — so
    it is the Role that GitHub should record as having done it, and the squash
    commit that lands on trunk carries that account rather than the solo's.

    The subject is passed rather than left to GitHub. Left to it, GitHub labels
    the squash from the commits, and solorepo's #27 landed on `main` under a subject that
    was not its title (solorepo's #26), which is the label the index carries — and a label
    on trunk cannot be rewritten. The body is left to GitHub, so the Trailers on
    the branch's commits ride into the squash as before (solorepo's DR-062).

    `--delete-branch` is not used. It makes `gh` check out `main` locally after
    the merge, which fails from a worktree because `main` is already checked out
    elsewhere — and it fails *after* the merge, so the exit code said the act
    had failed when it had not. The remote branch is deleted here instead, and
    the local checkout is left alone — unless the repository deletes head
    branches itself, which this one does. The first run of this verb (solorepo's #46)
    deleted a ref GitHub had already removed, and exited 1 on a merge that had
    landed, which is the defect it was written to remove wearing a new coat. So
    the setting is read, and the verb deletes nothing the repository will.

    The outcome is read back from GitHub to verify whether the branch was successfully merged or armed, independent of the CLI exit code.

    `--auto` is "when green" (solorepo's #79). A merge refused for pending checks was one
    somebody had to remember to retry, and on solorepo's #76 the retry came thirty-six
    minutes after the checks passed. GitHub holds the intent instead: the
    squash and its subject are handed over now, and the merge happens the
    moment the ruleset is satisfied, watched or not. Not on a layer of a stack:
    a layer's base is the layer below, and armed early it would merge into
    that branch the moment it was green rather than into trunk after it.
    """
    before = channel.gh("pr", "view", pr, "--json", "title,state,headRefName")
    if before["state"] != "OPEN":
        sys.exit(f"say: #{pr} is {before['state'].lower()}, not open")
    subject = f"{before['title']} (#{pr})"
    if auto:
        if stack or stacked(pr):
            # The bottom included: GitHub refuses auto-merge on any stacked
            # pull request ("Auto-merge is not supported for stacked pull
            # requests"), so a stack lands by `merge --stack`, by hand, when
            # its bottom is green (solorepo's #117).
            sys.exit(f"say: #{pr} is in a stack, and GitHub does not arm a stacked pull request, "
                     "bottom included. Merge it with --stack when it is green, and GitHub "
                     "retargets the layers above as it lands.")
        if not channel.gh("api", f"repos/{channel.repo()}").get("allow_auto_merge"):
            sys.exit("say: this repository does not allow auto-merge; that is a setting on "
                     "GitHub, not a line here")
        # Arming a branch that is already behind arms something that cannot
        # merge, and the push to trunk that would have advanced it has already
        # happened (solorepo's #93). The other edge — falling behind after arming — is
        # the workflow's. `held`, because this is the Job that did the work and
        # the branch is its own; nothing else may rebase an unarmed branch.
        #
        # And the arming happens whether or not that worked. `advance` ends in
        # `sys.exit` on a read-back that failed and on any refusal `gh` made,
        # and outside this `try` every one of those exits left the branch
        # rebased and never armed — the state of solorepo's #93, reached by the
        # fix for it, with no second run coming because arming is where the Job
        # ends (solorepo's #98).
        # Armed and behind is the recoverable half: the next push to trunk
        # sweeps it up, precisely because it is armed. So the stall is carried
        # to the end and reported there, after the arming it must not prevent —
        # and it is carried as a *reason*, not as a state. What state the pull
        # request ended in is asked of GitHub at each of the three places
        # below, because the stall is the exit code of a verb that makes four
        # or five calls and says nothing about which of them refused.
        stalled = None
        try:
            advance(pr, held=True)
        except SystemExit as exc:
            stalled = str(exc.code)
        try:
            arm(pr, subject)
        except SystemExit as exc:
            # Already mergeable: GitHub refuses to arm what it could just do,
            # in these words, and the plain merge below is the right act. A
            # stall recorded above goes no further from here, and cannot
            # survive: clean is GitHub saying the branch is current, which is
            # the opposite of what stalled would claim.
            if "clean status" not in str(exc.code):
                raise
        else:
            after = channel.gh("pr", "view", pr, "--json", "state,mergeCommit,autoMergeRequest")
            if after["state"] == "MERGED":
                # A stall recorded above is moot here and dies with this branch.
                # Not every refusal `advance` collects is a branch that is
                # genuinely behind — an API blip on a `pr view` or a `compare`
                # is one too — and GitHub having merged the pull request is the
                # end of the question either way. Reported here it would print
                # `merged #<n> as <sha>` and then exit 1 saying the pull request
                # is armed and not current with its base, both clauses false:
                # the defect of solorepo's #46 wearing a new coat, which is what
                # this verb was written to remove.
                print(f"merged #{pr} as {after['mergeCommit']['oid'][:7]} — {before['title']}")
            elif after.get("autoMergeRequest"):
                print(f"armed: #{pr} merges as a squash when green — {before['title']}")
                # Armed and behind is the one state the message describes, and
                # reaching this branch establishes only its first half:
                # `after.get("autoMergeRequest")` is GitHub saying it is armed,
                # and nothing since `advance` failed has asked whether the head
                # is current. `stalled` cannot answer it — it is every refusal
                # `advance` collected, and most of them say nothing about the
                # head: a `gh` blip on the read-back `compare`, one HTTP error
                # away out of the four or five calls that verb makes, or an
                # arming that did not stick and that the `arm` above has since
                # made take. Both leave the branch armed and current, and the
                # exit code here is the last thing the Job says — a non-zero
                # over a pull request GitHub is holding correctly armed tells
                # the loop the landing failed when it did not. So the currency
                # is re-asked, one `compare`, and the exit is conditional on
                # the answer rather than on how the stall was reached.
                if stalled:
                    try:
                        current = channel.gh("pr", "view", pr, "--json", ADVANCE)
                        behind = behind_by(current)
                    except SystemExit as exc:
                        sys.exit(f"say: #{pr} is armed, and advancing it did not finish — "
                                 f"{stalled}. GitHub would not say whether it is current "
                                 f"either — {exc.code}")
                    if behind:
                        sys.exit(f"say: #{pr} is armed and {behind} commit(s) behind "
                                 f"{current['baseRefName']} — {stalled}")
                    # Armed and current is the state the Job was for, so the
                    # stall is reported and not exited on: it is a reason
                    # something took two attempts, not a landing that failed.
                    print(f"#{pr} is armed and current with {current['baseRefName']}; "
                          f"advancing it did not finish — {stalled}")
            else:
                sys.exit(f"say: GitHub shows #{pr} neither merged nor armed after the call")
            return
    if stack:
        # GitHub's stack merge: everything up to and including this layer, all
        # or nothing, and the layers above are rebased by GitHub rather than by
        # hand (solorepo's DR-100). It takes no subject; trunk's label rests on the
        # repository's squash-title setting, which is why the label is read
        # back below rather than assumed.
        channel.gh("stack", "merge", pr, "--squash", "--yes", parse=False)
    elif stacked(pr):
        sys.exit(f"say: #{pr} is a layer of a stack; the legacy merge cannot take it. "
                 "Pass --stack to merge everything up to it.")
    else:
        channel.gh("pr", "merge", pr, "--squash", "--subject", subject, parse=False)
    after = channel.gh("pr", "view", pr, "--json", "state,mergeCommit")
    if after["state"] != "MERGED":
        sys.exit(f"say: #{pr} is {after['state'].lower()} after the merge call; not deleting the branch")
    print(f"merged #{pr} as {after['mergeCommit']['oid'][:7]} — {before['title']}")
    branch = before["headRefName"]
    if channel.gh("repo", "view", "--json", "deleteBranchOnMerge")["deleteBranchOnMerge"]:
        print(f"GitHub deletes origin/{branch} on merge; nothing to do here")
    else:
        channel.gh("api", "-X", "DELETE", f"repos/{channel.repo()}/git/refs/heads/{branch}", parse=False)
        print(f"deleted origin/{branch}")


SUPERSEDER = re.compile(r"^(?:#?(\d+)|[Dd][Rr]-0*(\d+))$")

# The status an entry gives itself, matched in the entry's own text rather than
# parsed out of it: these programs run under plain `python3` and the channel
# imports nothing but the standard library, where `.meta/gate` and
# `.meta/dereference.py` take their `pyyaml` from a `uvx` shebang.
STATUS = re.compile(r"^\s+status:\s*(\S+)\s*$", re.M)


def entry_status(raw):
    """The status a Decision's entry gives itself, or None where the text is
    not one entry with one status in it.

    What the match assumes — one entry to a file, one `status` in it — is what
    every entry in the record is, and `channel status probes` holds it against
    `yaml` over all of them, so an entry written some other way makes that
    probe red and makes this None. None is not a status: the caller refuses
    loudly rather than reading whichever line matched.
    """
    found = STATUS.findall(raw)
    return found[0] if len(found) == 1 else None


def superseder(what):
    """What `--by` names, and whether it has landed: a merged pull request, or
    a Decision the record on the trunk adopted. The name to print, and the line
    to cite it by.

    `supersede` claims the tree already holds another answer, and this is where
    that claim is checked rather than taken. A pull request still open is not
    another answer yet — it is a second one in flight, and which of two in
    flight is the wrong one is not settled by closing the other. A Decision is
    read off the trunk for the same reason: an entry on a branch is one that
    branch is proposing (solorepo's DR-164).

    For a Decision the entry is read and not the listing, because the listing
    cannot tell an answer from a hole. A number written back into the record as
    WITHDRAWN is a file at that path like any other — which is how a
    reservation nobody spent is closed (solorepo's DR-128), including the ones
    this verb names as it closes — so a listing answers `mint`'s question,
    whether the number is taken, and not this one. `decision supersession` puts the
    distinction in the repository's own words: withdrawn and superseded are
    different states, and a hole is not a replacement. So the status is asked
    for, and only ADOPTED is an answer the tree holds: PROPOSED and RECOMMENDED
    are decisions nobody has taken yet, and SUPERSEDED is one the tree has
    already replaced.
    """
    found = SUPERSEDER.match(what.strip())
    if not found:
        sys.exit(f"say: --by takes a pull request, as `nnn` or `#nnn`, or a Decision, as "
                 f"`DR-nnn`; {what!r} is neither")
    if found.group(2):
        name = f"DR-{int(found.group(2)):03d}"
        entry = f"{DECISIONS.relative_to(ROOT)}/{name}.yaml"
        if int(found.group(2)) not in numbers_on("main"):
            sys.exit(f"say: the record on main holds no {name}, so it is not an answer anything "
                     "has been given yet. A Decision supersedes once its entry has landed; "
                     "until then it is a second answer in flight.")
        status = entry_status(channel.gh("api", "-H", "Accept: application/vnd.github.raw",
                                        f"repos/{channel.repo()}/contents/{entry}?ref=main",
                                        parse=False))
        if status is None:
            sys.exit(f"say: main holds {entry} and no status can be read out of it, where every "
                     "entry in the record is one entry with one `status` in it. Read the entry "
                     "and name what it says: a Decision supersedes once it is adopted.")
        if status.upper() != "ADOPTED":
            sys.exit(f"say: the record on main has {name} as {status.lower()}, not adopted, so "
                     "it holds the number and not an answer. A hole is not a replacement, and "
                     "an entry still proposed is a second answer in flight. Name the Decision "
                     "that was adopted, or the pull request that landed it.")
        return name, f"[{name}](https://github.com/{channel.repo()}/blob/main/{entry})"
    number = found.group(1)
    if kind(number) != "pull request":
        sys.exit(f"say: #{number} is an Issue. A Challenge does not supersede a pull request; "
                 "the change that answered it does. Name that pull request, or the Decision "
                 "it landed.")
    pull = channel.gh("pr", "view", number, "--json", "state,title")
    if pull["state"] != "MERGED":
        sys.exit(f"say: #{number} is {pull['state'].lower()}, not merged, so the tree does not "
                 "hold its answer yet. Two open pull requests are two answers in flight, and "
                 "which of them is the wrong one is not settled by closing the other.")
    return f"#{number}", f"#{number} — {pull['title']}"


def minted_for(branch):
    """The Decision numbers reserved for a branch that the record on the trunk
    does not hold: numbers spent on a decision nobody took.

    A hole in the sequence is a reservation somebody is still keeping or an
    entry somebody dropped, and `decision numbering` tells those apart without
    knowing whose the reservation is. Here the branch is known, so the tag's
    message answers it: `mint` writes `DR-nnn reserved for <branch>.` into the
    annotation, and that is the only record of who took a number.

    Only the holes are read, which is the numbers in flight and no more. A
    lightweight ref carries no message and so names no branch; `mint` writes an
    annotated tag and nothing else here writes one at all, so one that is not
    annotated is not this verb's to attribute. Nor is a number minted before
    the branch existed, which records `reserved for main` (solorepo's DR-128).
    """
    mine = []
    for number in sorted(reserved() - numbers_on("main")):
        name = f"DR-{number:03d}"
        ref = channel.gh("api", f"repos/{channel.repo()}/git/ref/tags/{name}")["object"]
        if ref["type"] != "tag":
            continue
        message = channel.gh("api", f"repos/{channel.repo()}/git/tags/{ref['sha']}").get("message") or ""
        if message.startswith(f"{name} reserved for {branch}."):
            mine.append(name)
    return mine


def supersede(pr, by, reason):
    """Close a pull request another answer to its Challenge has overtaken: the
    one exit that is not a merge (solorepo's DR-164).

    PR First's tenth step is *merged, never abandoned*, and the channel holds
    it by construction — there is no `close` verb, so `merge` is how a pull
    request ends. The step is written for a change that was tried and did not
    work: merging records the attempt, and the record is worth the diff. It
    assumes merging is available and merely unappealing, and that is what fails
    here. A change the tree has already answered elsewhere cannot merge at all
    — the diff would install a second mechanism over a working one — so step
    ten cannot be followed, and without this verb nothing else can be either,
    which leaves the act to `gh pr close` typed by hand, unsigned, which is the
    defect solorepo's DR-069 exists to make unrepresentable.

    What makes this an exception rather than a repeal is the refusals, and each
    is a read rather than a question to the caller. The pull request is open.
    What `--by` names has landed: a merged pull request, or a Decision the
    record on the trunk adopted rather than merely holds a number for. And the
    body closes a Challenge, and every Challenge it closes is closed already —
    which is the whole of what tells superseded from abandoned, since the
    Challenge being closed is the evidence that another answer landed. A change
    nobody superseded still has merge as its only exit.

    The body closing none is refused for the same reason and not waved through
    it. The form allows "None." and means it as a question, so that shape
    reaches here; what the verb would have established about such a pull
    request is that it is open, since `--by` is satisfied by any merged pull
    request in the repository and says nothing about this one. Closing it would
    be the general `close` step ten refuses to have, reached through a heading.

    The order is `stop`'s, and for the same reason: the comment before the
    state, so the record carries an account of why whatever fails next. The
    reason is the caller's and arrives on stdin; what the verb renders beside
    it is what it read — where the answer landed, which Challenges are closed,
    and which Decision numbers this branch minted and will never redeem. Those
    are not released: the tag is the allocation, so deleting it would let a
    number be issued twice while a citation of the first minting stands in a
    closed pull request's body, and solorepo's DR-128 closes such a hole by
    writing the number back into the record as WITHDRAWN. It also says nothing
    prompts that; this is the moment somebody knows the number will never be
    redeemed, so the prompt goes here.
    """
    before = channel.gh("pr", "view", str(pr), "--json",
                        "state,title,headRefName,closingIssuesReferences")
    if before["state"] not in ("OPEN", "CLOSED"):
        sys.exit(f"say: #{pr} is {before['state'].lower()}, not open or closed")
    # Nothing here refuses a pull request named as its own superseder, because
    # nothing can reach that state: this one is open, and `superseder` takes
    # only what has landed.
    name, cited = superseder(by)
    # The Challenges the body closes, and each one's state. `gh pr view` does
    # not report the state with the reference — it gives the number, the
    # repository and the url and nothing else — so it is asked for, per
    # Challenge, and there are never many.
    closes = [c["number"] for c in before["closingIssuesReferences"]]
    if not closes:
        sys.exit(f"say: #{pr} closes no Challenge, so there is nothing here another answer "
                 "could have overtaken. A Challenge that is closed already is the whole of "
                 "what tells superseded from abandoned, and what `--by` names says nothing "
                 f"about #{pr} — any merged pull request in the repository would satisfy it — "
                 "so this would be the general `close` PR First's tenth step refuses to have. "
                 f"If there is a Challenge, name it in the body with `move revise {pr}`; if "
                 "there is not, merge is still the only exit.")
    still_open = [n for n in closes
                  if channel.gh("api", f"repos/{channel.repo()}/issues/{n}",
                                "--jq", ".state", parse=False).upper() == "OPEN"]
    if still_open:
        listed = ", ".join(f"#{n}" for n in still_open)
        sys.exit(f"say: #{pr} closes {listed}, still open, so nothing has answered that "
                 "Challenge yet. Merged, never abandoned: a Challenge with no other answer "
                 "has this pull request as the only one it has, and closing it here would "
                 "abandon the need rather than record that it was met elsewhere.")

    answered = ", ".join(f"#{n}" for n in closes)
    said = [reason.rstrip("\n"), "",
            f"**Superseded by {cited}.** Closed rather than merged, which is PR First's "
            f"tenth step and its one exception: {answered} "
            f"{'is' if len(closes) == 1 else 'are'} answered already, so this diff would "
            "install a second answer over the one the tree holds."]
    if unredeemed := minted_for(before["headRefName"]):
        said += ["", f"**Minted here and never landed:** {', '.join(unredeemed)}. The tag "
                 "stays, so nothing issues the number twice; each is closed by writing it "
                 "back into the record as WITHDRAWN, not by releasing it (solorepo's DR-128)."]
    channel.sibling("post").conversation_comment(pr, channel.signed("\n".join(said)))
    channel.gh("pr", "close", str(pr), parse=False)
    # Read back: the act is what GitHub shows afterwards, not what `gh`
    # returned. A close that did not take leaves a pull request this Job has
    # already announced dead, with the comment saying so standing on it.
    after = channel.gh("pr", "view", str(pr), "--json", "state")["state"]
    if after != "CLOSED":
        sys.exit(f"say: GitHub shows #{pr} {after.lower()} after the call, not closed")
    print(f"superseded #{pr} by {name} — {before['title']}")
    for hole in unredeemed:
        print(f"{hole} was minted here and never landed; write it back as WITHDRAWN")


def request_review(pr, to):
    """The handoff: request review from the next Role's account.

    A semaphore, not a message. GitHub holds the request and reports it, so the
    arriving Job finds its work by asking what has been requested of its login.
    Read back from GitHub afterwards to verify the request was successfully updated on the remote, independent of the CLI exit code.

    A request already pending is withdrawn first. GitHub emits no event for
    a reviewer it already lists, so a Job whose run answered nothing left the
    request standing and a second ask went nowhere (solorepo's #87). Withdrawing and
    asking again is the same semaphore raised twice, and the event fires.

    **Refused on a branch GitHub reports as `CONFLICTING`** (solorepo's DR-145).
    The semaphore is raised and nothing can answer it: GitHub builds
    no merge ref for a branch that conflicts, `review.yml` runs on
    `pull_request`, and so the request creates no run while GitHub goes on
    reporting it as outstanding — which reads, from the pull request and from
    a watch alike, exactly like a review in progress. `coder.yml`'s hand-back step reads `mergeable` for this reason
    already (solorepo's DR-129) and the verb a session types did not, so
    solorepo's #192 was opened conflicting, requested three minutes later, and
    answered by nobody until the solo looked. The remedy is the one the
    hand-back step names: the branch rebased onto its own base, which is not
    always `main`, and pushed — a `synchronize` on a head that merges is what
    starts the review.

    Only `CONFLICTING`, for the reason the hand-back step gives: `UNKNOWN` is
    GitHub still computing, and refusing on that would refuse on timing. Which
    is what the wait is for, and it is a wait: a push is what invalidates the
    cached answer and a request follows a push, so the read this verb makes is
    the one GitHub's reference says to poll. Bounded at half a minute by
    `mergeability`, and it is the branch being asked about rather than the
    checks, which a handoff does not wait for (solorepo's #102).
    """
    login = channel.role_login(to)
    pull = channel.gh("pr", "view", pr, "--json", ADVANCE)
    if mergeability(pull) == "CONFLICTING":
        sys.exit(f"say: #{pr}'s branch {pull['headRefName']} conflicts with its base, "
                 f"{pull['baseRefName']}. GitHub builds no merge ref for one that does, "
                 "review.yml runs on pull_request, and so a review requested on it would "
                 f"create no run and be answered by nobody. Rebase {pull['headRefName']} "
                 f"onto {pull['baseRefName']}, push, and the request can be made")

    def asked():
        return [r.get("login") for r in channel.gh("pr", "view", pr, "--json", "reviewRequests")["reviewRequests"]]

    again = login in asked()
    if again:
        channel.gh("pr", "edit", pr, "--remove-reviewer", login, parse=False)
    channel.gh("pr", "edit", pr, "--add-reviewer", login, parse=False)
    if login not in asked():
        sys.exit(f"say: GitHub shows {asked() or 'nobody'} requested on #{pr} after the call, not {login}")
    print(f"{'requested again' if again else 'requested'} review of #{pr} from {login}")


# --- A Decision's number: issued once, by GitHub, and reserved from then on.

ROOT = channel.HERE.parent.parent
DECISIONS = ROOT / ".meta" / "assertions" / "decisions"
ENTRY = re.compile(r"^DR-(\d+)$")
RESERVATION = re.compile(r"^refs/tags/DR-(\d+)$")
# Enough to outlast a burst of sessions minting at once and no more: each turn
# of the loop is a refusal GitHub made, so a hundred would be a hundred writes
# against a repository that is answering "taken" to every one.
ATTEMPTS = 20


def numbers_here():
    """The numbers the record in this working tree holds."""
    return {int(m.group(1)) for path in DECISIONS.glob("DR-*.yaml")
            if (m := ENTRY.match(path.stem))}


def numbers_on(branch):
    """The numbers the record holds on a branch of the remote.

    Asked because this working tree is not the record: a branch cut a week ago
    has main's entries as they were, and a number issued from it would be one
    main has already used. The listing is one call and it is the truth about
    the trunk at this moment, which is what the number has to clear.
    """
    where = DECISIONS.relative_to(ROOT)
    listing = channel.gh("api", f"repos/{channel.repo()}/contents/{where}?ref={branch}")
    return {int(m.group(1)) for entry in listing
            if (m := ENTRY.match(pathlib.Path(entry["name"]).stem))}


def reserved():
    """The numbers GitHub holds a tag for: every number issued and not yet
    withdrawn, whether its pull request has landed or is still open.

    All of them, in one call. `GET /repos/{owner}/{repo}/git/matching-refs/{ref}`
    does not paginate: its reference lists an `accept` header and three path
    parameters under "Parameters for 'List matching references'" and no query
    parameters at all, where a listing beside it that does paginate — `GET
    /repos/{owner}/{repo}/tags` — lists "per_page ... The number of results per
    page (max 100). Default: 30" and `page`. So the thirty-first reservation is
    returned like the first, which is what `mint` below means by the tags being
    the authoritative source (solorepo's #152).
    """
    refs = channel.gh("api", f"repos/{channel.repo()}/git/matching-refs/tags/DR-")
    return {int(m.group(1)) for ref in refs if (m := RESERVATION.match(ref["ref"]))}


def branch_here():
    """The branch a reservation is taken for, or that there was no branch.

    `symbolic-ref`, not `rev-parse --abbrev-ref HEAD`, which prints `HEAD` and
    exits 0 on a detached checkout — so the fallback was unreachable in the one
    state it names, and a mint from a detached HEAD wrote `reserved for HEAD`
    into a tag nothing ever deletes. `symbolic-ref -q` exits non-zero there,
    which is the question being asked (solorepo's #152).
    """
    found = subprocess.run(["git", "-C", str(ROOT), "symbolic-ref", "-q", "--short", "HEAD"],
                           capture_output=True, text=True)
    return found.stdout.strip() if not found.returncode else "an unnamed branch"


def mint():
    """Issue the next Decision number and reserve it on GitHub, as a tag
    (solorepo's DR-128).

    A number is fixed the moment it is first cited (solorepo's DR-125), and
    citations in pull request bodies, Issues and commits are never rewritten.
    Until this verb the number was chosen by reading the record on a branch,
    which is a read of a value two branches read alike: on one evening in
    September 2026 four open pull requests took two numbers between them, and
    the repair was a rebase with conflicts, two renames and a body edit on
    every pull request that had cited one.

    So the number is issued by the one participant both branches share.
    `POST /git/refs` fails with "Reference already exists" when the ref is
    held — GitHub's REST reference says so, and it is the same 422 whichever
    session asks second — so creating `refs/tags/DR-nnn` is a compare-and-set
    over the number, and the loser is told, in the one call, that it lost. It
    then asks for the next one.

    The candidate clears three sources before the first attempt: the record in
    this tree, the record on the trunk, and the tags. The first two are the
    numbers already spent, the last is the numbers spent or promised, and only
    the last is authoritative — the other two are there because the tags begin
    where this verb does, and everything below that was issued by hand.

    The tag is annotated rather than lightweight, and stays after the entry
    lands. The object records who issued the number and when; the message
    records which branch it was issued for, which is what a reader needs when
    they find a reservation nobody redeemed. Deleting it at merge would save a
    ref and lose the only evidence that the number was ever issued, which is
    what a reservation is for (solorepo's DR-125).
    """
    branch = branch_here()
    taken = numbers_here() | numbers_on("main") | reserved()
    at = max(taken, default=0) + 1
    # The trunk's head, because a tag object has to point at something and the
    # commit the entry will be written in does not exist yet. What it points at
    # says when the number was issued, which is the only thing being recorded.
    head = channel.gh("api", f"repos/{channel.repo()}/commits/main", "--jq", ".sha", parse=False)
    for number in range(at, at + ATTEMPTS):
        name = f"DR-{number:03d}"
        message = (f"{name} reserved for {branch}.\n\nThe number is fixed the moment it is "
                   "first cited, and this tag is what fixes it. It outlives the entry: "
                   "nothing issues this number again, and a reservation whose pull request "
                   "never merges is withdrawn as an entry, not by deleting the tag.")
        # The tag object first, which never conflicts, then the ref, which is
        # the act: two calls because the object carries the tagger and the
        # message, and a lightweight tag would carry neither. An object whose
        # ref was refused is unreachable and git collects it, so a number lost
        # to another session costs nothing that lasts.
        tag = channel.gh("api", f"repos/{channel.repo()}/git/tags",
                         "-f", f"tag={name}", "-f", f"message={message}",
                         "-f", f"object={head}", "-f", "type=commit")
        try:
            channel.gh("api", f"repos/{channel.repo()}/git/refs",
                       "-f", f"ref=refs/tags/{name}", "-f", f"sha={tag['sha']}", parse=False)
        except SystemExit as exc:
            if "already exists" not in str(exc.code).lower():
                raise
            print(f"{name} is taken; asking for the next", file=sys.stderr)
            continue
        # Read back from GitHub afterwards to verify the tag actually points to
        # our commit. A ref created and pointing elsewhere is a reservation
        # somebody else's, and this Job would otherwise go and write the entry under it.
        now = channel.gh("api", f"repos/{channel.repo()}/git/ref/tags/{name}")["object"]["sha"]
        if now != tag["sha"]:
            sys.exit(f"say: GitHub shows tag {name} at {now[:7]} after the call, not {tag['sha'][:7]}")
        print(f"minted {name}, reserved for {branch}; write it as "
              f".meta/assertions/decisions/{name}.yaml")
        return number
    sys.exit(f"say: {ATTEMPTS} numbers from DR-{at:03d} are all reserved already; "
             "something is minting faster than this can read")



MERGE_MANAGER_FIELDS = (
    "number,title,headRefName,baseRefName,headRefOid,isDraft,mergeable,"
    "mergeStateStatus,latestReviews,reviewRequests,closingIssuesReferences,"
    "additions,deletions,statusCheckRollup,body"
)

THREADS_QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      reviewThreads(first: 100) {
        nodes {
          isResolved
          isOutdated
        }
      }
    }
  }
}
"""


def parse_waits_on(body):
    """The blockers an Issue or PR declares: a list of numbers."""
    if not body:
        return []
    m = re.search(r"^\*\*Waits on\.\*\*\s*(.*?)\s*$", body, re.M) or \
        re.search(r"\*\*What it waits on\.\*\*\s*(.*?)(?:\n\s*\n|\Z)", body, re.S)
    if not m:
        return []
    text = m.group(1).strip()
    if text.lower().rstrip(".") in ("nothing", "none", ""):
        return []
    return [int(n) for n in re.findall(r"#(\d+)", text)]


def issue_blockers(issue):
    """Numbers that block an Issue: native blockedBy first, then body prose (solorepo's DR-170)."""
    native = [n["number"] for n in (issue.get("blockedBy") or {}).get("nodes", []) if "number" in n]
    return native if native else parse_waits_on(issue.get("body"))


deduplicate_checks = check_pr.deduplicate_checks


def check_green(pull):
    """Whether every check on the head has concluded and none failed."""
    contexts = deduplicate_checks(pull.get("statusCheckRollup") or [])
    if not contexts:
        return False, "checks pending (no checks concluded)"
    green_states = {"SUCCESS", "NEUTRAL", "SKIPPED"}
    failed = []
    pending = []
    for c in contexts:
        state = (c.get("conclusion") or c.get("state") or c.get("status") or "").upper()
        name = c.get("name") or c.get("context") or "check"
        if state not in green_states:
            if state in ("PENDING", "IN_PROGRESS", "QUEUED", ""):
                pending.append(name)
            else:
                failed.append(f"{name}:{state.lower()}")
    if failed:
        return False, f"checks failing ({', '.join(failed[:3])})"
    if pending:
        return False, f"checks pending ({', '.join(pending[:3])})"
    return True, "checks green"


def check_reviewer_approval(pull, reviewer_login):
    """Whether the reviewer account has approved."""
    reviews = pull.get("latestReviews") or pull.get("reviews") or []
    matching = [r for r in reviews if (r.get("author") or {}).get("login") == reviewer_login]
    if not matching:
        reqs = [r.get("login") if isinstance(r, dict) else r for r in pull.get("reviewRequests") or []]
        if reviewer_login in reqs:
            return False, f"waiting on review from {reviewer_login}"
        return False, f"no review from {reviewer_login}"
    latest = matching[-1]
    state = latest.get("state")
    if state == "APPROVED":
        return True, "approved by reviewer"
    if state == "CHANGES_REQUESTED":
        return False, f"changes requested by {reviewer_login}"
    return False, f"review from {reviewer_login} is {state.lower()}"


def check_threads(pull, owner, name):
    """Whether all review conversations are resolved."""
    threads = pull.get("reviewThreads")
    if threads is None:
        try:
            res = channel.graphql(THREADS_QUERY, owner=owner, name=name, number=int(pull["number"]))
            repo_data = res.get("data", {}).get("repository")
            if not repo_data:
                return False, "could not read conversations (no repository data)"
            pr_data = repo_data.get("pullRequest")
            if not pr_data:
                return False, "could not read conversations (no pull request data)"
            threads = pr_data.get("reviewThreads", {}).get("nodes", [])
        except (Exception, SystemExit) as exc:
            return False, f"could not read conversations ({type(exc).__name__})"
    unresolved = [t for t in threads if not t.get("isResolved")]
    if unresolved:
        return False, f"{len(unresolved)} unresolved conversation(s)"
    return True, "0 unresolved conversations"


def check_mergeable_clean(pull):
    """Whether branch is mergeable and not behind or dirty."""
    mergeable = pull.get("mergeable")
    status = pull.get("mergeStateStatus")
    if mergeable == "CONFLICTING":
        return False, "branch conflicts with base"
    if status == "BEHIND":
        return False, "branch is behind base"
    if status == "DIRTY":
        return False, "branch has dirty merge state"
    if mergeable not in (None, "MERGEABLE"):
        return False, f"mergeable is {mergeable}"
    return True, "mergeable clean"


def evaluate_pr(pull, reviewer_login, owner, name):
    """Evaluate a pull request against all semaphores (solorepo's DR-161)."""
    if pull.get("isDraft"):
        return False, ["draft"]
    reasons = []
    if pull.get("baseRefName") and pull.get("baseRefName") != "main":
        reasons.append(f"base is {pull.get('baseRefName')}, not main")
    clean_ok, clean_msg = check_mergeable_clean(pull)
    if not clean_ok:
        reasons.append(clean_msg)
    green_ok, green_msg = check_green(pull)
    if not green_ok:
        reasons.append(green_msg)
    rev_ok, rev_msg = check_reviewer_approval(pull, reviewer_login)
    if not rev_ok:
        reasons.append(rev_msg)
    if pull.get("reviewThreads") is not None or not reasons:
        threads_ok, threads_msg = check_threads(pull, owner, name)
        if not threads_ok:
            reasons.append(threads_msg)
    if reasons:
        return False, reasons
    return True, ["eligible"]


def merge_manager(dry_run=False):
    """Evaluate open pull requests against semaphores, rank eligible candidates
    by leverage, assert choices and deferrals out loud, and squash-merge the top
    candidate (solorepo's DR-161).
    """
    try:
        repo = channel.repo()
        owner, name = repo.split("/")
        reviewer_login = f"{owner}-{name}-reviewer"
    except Exception:
        owner, name, reviewer_login = "owner", "repo", "reviewer"

    pulls = channel.gh("pr", "list", "--state", "open", "--limit", "100", "--json", MERGE_MANAGER_FIELDS)
    if not pulls:
        print("merge-manager: idle — no open pull requests")
        return

    evaluations = {}
    eligible = []
    for pull in pulls:
        num = pull["number"]
        ok, reasons = evaluate_pr(pull, reviewer_login, owner, name)
        evaluations[num] = (ok, reasons)
        if ok:
            eligible.append(pull)

    if not eligible:
        print(f"merge-manager: idle — 0 of {len(pulls)} open pull request(s) eligible")
        for pull in pulls:
            num = pull["number"]
            _, reasons = evaluations[num]
            print(f"  #{num} ({pull.get('title', '')[:50]}): {'; '.join(reasons)}")
        return

    try:
        issues = channel.gh("issue", "list", "--state", "open", "--limit", "100",
                            "--json", "number,title,body,blockedBy")
    except Exception:
        issues = []

    metrics = {}
    for pull in eligible:
        num = pull["number"]
        is_base = any(other.get("baseRefName") == pull.get("headRefName")
                      for other in pulls if other.get("number") != num)
        targets = {num} | {ref["number"] for ref in (pull.get("closingIssuesReferences") or [])}
        unblocks_issues = sum(1 for iss in issues if any(t in targets for t in issue_blockers(iss)))
        unblocks_prs = sum(1 for other in pulls if other.get("baseRefName") == pull.get("headRefName")
                           or any(t in targets for t in parse_waits_on(other.get("body"))))
        total_unblocks = unblocks_issues + unblocks_prs
        churn = (pull.get("additions") or 0) + (pull.get("deletions") or 0)
        metrics[num] = {
            "is_base": is_base,
            "unblocks": total_unblocks,
            "churn": churn,
        }

    def leverage_key(pull):
        m = metrics[pull["number"]]
        return (1 if m["is_base"] else 0, m["unblocks"], m["churn"], -pull["number"])

    eligible.sort(key=leverage_key, reverse=True)
    winner = eligible[0]
    deferred = eligible[1:]

    wm = metrics[winner["number"]]
    print(f"merge-manager: evaluated {len(eligible)} eligible candidate(s)")
    print(f"chosen: #{winner['number']} — {winner['title']} "
          f"(unblocks: {wm['unblocks']}, base: {wm['is_base']}, churn: +{winner.get('additions', 0)}/-{winner.get('deletions', 0)})")
    for d in deferred:
        dm = metrics[d["number"]]
        print(f"deferred: #{d['number']} — {d['title']} "
              f"(lower leverage: unblocks: {dm['unblocks']}, base: {dm['is_base']}, churn: +{d.get('additions', 0)}/-{d.get('deletions', 0)})")

    if dry_run:
        print(f"merge-manager: dry run — not merging #{winner['number']}")
        return

    print(f"merge-manager: merging #{winner['number']}...")
    merge(str(winner["number"]), stack=stacked(winner["number"]), auto=False)


def build_parser():
    """The parser alone, so a probe can check what each verb accepts without
    running what it dispatches to (solorepo's #95)."""
    ap = channel.parser(__doc__)
    sub = ap.add_subparsers(dest="verb", required=True)

    # An Issue's life: filed, its difficulty moved, claimed, or handed back.
    p = sub.add_parser("file"); p.add_argument("--title", required=True)
    what = p.add_mutually_exclusive_group(required=True)
    what.add_argument("--difficulty", choices=DIFFICULTIES, dest="level", help="a Challenge, at this level")
    what.add_argument("--roadmap", action="store_true", help="a roadmap Issue: intended and deferred")
    p = sub.add_parser("triage"); p.add_argument("issue"); p.add_argument("level", choices=DIFFICULTIES)
    p = sub.add_parser("difficulty"); p.add_argument("issue"); p.add_argument("level", choices=DIFFICULTIES)
    p = sub.add_parser("claim"); p.add_argument("issue")
    p = sub.add_parser("stop"); p.add_argument("issue")
    p = sub.add_parser("milestone"); p.add_argument("issue")
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--set", dest="title", help="the Milestone's title; created if new")
    target.add_argument("--clear", action="store_true", help="take the Issue out of its Milestone")

    # A pull request's: opened, layered, revised, merged, advanced, handed off.
    p = sub.add_parser("open"); p.add_argument("--title", required=True)
    where = p.add_mutually_exclusive_group()
    where.add_argument("--base", default="main")
    where.add_argument("--on", help="open as a layer on this pull request, and link the stack")
    p = sub.add_parser("layer"); p.add_argument("pr"); p.add_argument("--on", required=True)
    p = sub.add_parser("revise"); p.add_argument("number"); p.add_argument("--title")
    p = sub.add_parser("merge"); p.add_argument("pr"); p.add_argument("--stack", action="store_true")
    p.add_argument("--auto", action="store_true", help="arm GitHub to merge when green")
    p = sub.add_parser("merge-manager")
    p.add_argument("--dry-run", action="store_true", help="evaluate eligibility and leverage order without merging")
    p = sub.add_parser("advance")
    p.add_argument("pr", nargs="?", help="one pull request; every armed one by default")
    p = sub.add_parser("dispatch"); p.add_argument("pr")
    # Required, and with no default, although `coder.yml` defaults its own
    # input to `review`: the two passes do opposite things to a branch, and a
    # default here would make the commoner mistake the silent one.
    p.add_argument("--task", required=True, choices=("review", "rebase"),
                   help="which pass: `review` answers a verdict that stands, `rebase` puts a "
                        "conflicting branch back where a review can run")
    # The one exit that is not a merge. `--by` is required because the closing
    # comment cites it — a close that names nowhere the answer landed is the
    # `close` verb step ten refuses to have — and not because it is the
    # evidence: any merged pull request satisfies it and it says nothing about
    # the one being closed, so the Challenge the body closes is read too
    # (solorepo's DR-164).
    p = sub.add_parser("supersede"); p.add_argument("pr")
    p.add_argument("--by", required=True,
                   help="what answered the Challenge already: a merged pull request, or a "
                        "landed Decision as DR-nnn")
    p = sub.add_parser("request-review"); p.add_argument("pr"); p.add_argument("--to", default="reviewer")

    # A Decision's: the number, issued by GitHub and reserved from then on. It
    # takes nothing — a number a caller could pass is a number a caller could
    # pass wrongly, which is the read of a shared value this verb exists to
    # replace.
    sub.add_parser("mint")
    return ap


def main():
    args = build_parser().parse_args()
    channel.speak_as(args.role)

    if args.verb == "triage":
        triage(args.issue, args.level)
    elif args.verb == "difficulty":
        difficulty(args.issue, args.level)
    elif args.verb == "claim":
        claim(args.issue)
    elif args.verb == "milestone":
        milestone(args.issue, args.title, clear=args.clear)
    elif args.verb == "layer":
        layer(args.pr, args.on)
    elif args.verb == "merge":
        merge(args.pr, stack=args.stack, auto=args.auto)
    elif args.verb == "merge-manager":
        merge_manager(dry_run=args.dry_run)
    elif args.verb == "advance":
        advance(args.pr)
    elif args.verb == "dispatch":
        dispatch_pass(args.pr, args.task)
    elif args.verb == "request-review":
        request_review(args.pr, args.to)
    elif args.verb == "mint":
        mint()
    elif args.verb == "revise":
        # A title says everything it has to say in an argument, so the body
        # is optional here and nowhere else; reading a body a rename will not
        # use turned a rename into a refusal, twice.
        text = channel.piped()
        revise(args.number, body=channel.signed(text) if text else None, title=args.title)
    elif args.verb == "file":
        file_issue(args.title, channel.signed(channel.stdin_body()), level=args.level, roadmap=args.roadmap)
    elif args.verb == "stop":
        stop(args.issue, channel.signed(channel.stdin_body()))
    elif args.verb == "supersede":
        # Signed after the body is assembled rather than here: the Trailer
        # block closes the comment, and what this verb renders from the record
        # goes between the caller's reason and it.
        supersede(args.pr, args.by, channel.stdin_body())
    elif args.verb == "open":
        open_pull_request(args.title, channel.signed(channel.stdin_body()), base=args.base, on=args.on)


if __name__ == "__main__":
    main()
