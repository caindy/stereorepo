#!/usr/bin/env python3
"""Commit staged changes under this Actor with composed trailers (solorepo's DR-062, solorepo's DR-117).

Usage:
    .meta/say/commit -m <subject> [--allow-empty] [< body]

Composes Actor and Agent attribution trailers directly from the channel
environment rather than an ambient hook. Configures git commit signing when
speaking under a role credential with an SSH signing key.

History in commit.history.md (solorepo's DR-171).
"""
import argparse
import os
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import channel


def commit(subject: str, allow_empty: bool = False) -> None:
    """Executes git commit with composed attribution trailers and role SSH signing.

    Parameters:
        subject: The commit message subject line.
        allow_empty: Whether to record an empty commit with a tree identical to
            its parent when nothing is staged, such as a seed commit before
            implementation (solorepo's DR-269).

    Raises:
        SystemExit: Propagates the git commit exit code.
    """
    body = channel.piped()
    message = f"{subject}\n\n{body}\n" if body else f"{subject}\n"
    message += f"\n{channel.trailers()}\n"
    signing_args = []
    key = channel.role_signing_key()
    if key:
        signing_args = [
            "-c", "gpg.format=ssh",
            "-c", f"user.signingkey={key}",
            "-c", "commit.gpgsign=true",
        ]
    elif channel.role_credential():
        print("say: speaking as role without signing key; commit is cryptographically unsigned",
              file=sys.stderr)
    cmd = ["git", *signing_args, "commit"]
    if allow_empty:
        cmd.append("--allow-empty")
    cmd.extend(["-F", "-"])
    out = subprocess.run(cmd,
                         check=False, input=message, text=True,
                         env={**os.environ, **channel.role_identity()})
    sys.exit(out.returncode)


def build_parser() -> argparse.ArgumentParser:
    """Builds the argument parser for the commit tool."""
    ap = channel.parser(__doc__)
    ap.add_argument("-m", "--message", required=True, help="the subject: a label, not an account (A14)")
    ap.add_argument("--allow-empty", action="store_true",
                    help="record an empty commit, such as a seed commit before implementation "
                         "(solorepo's DR-269)")
    return ap


def main() -> None:
    """Parses arguments and commits staged changes with signed trailers."""
    args = build_parser().parse_args()
    channel.speak_as(args.role)
    commit(args.message, allow_empty=args.allow_empty)


if __name__ == "__main__":
    main()
