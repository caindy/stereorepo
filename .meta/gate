#!/usr/bin/env -S uvx --python 3.13 --with pyyaml python
"""Portfolio and project gate runner streaming Article 21 structured reports.

Reads declared projects, products, and gate commands from
`.meta/assertions/structure.yaml` (solorepo's DR-104). Executes gate commands
from repository root, streams and re-prefixes structured step reports adhering to
Article 21 (solorepo's DR-092), and enforces clean exit and non-empty step assertions.

History in gate.history.md (solorepo's DR-171).
"""
import concurrent.futures
import io
import pathlib
import re
import subprocess
import sys
import threading
from typing import Any

import yaml

META = pathlib.Path(__file__).parent
ROOT = META.parent
STRUCTURE = META / "assertions" / "structure.yaml"

OK = re.compile(r"^ok (?P<step>\S.*?)(?: — (?P<scope>.*))?$")
"""Matches passing step reports under Article 21 with optional scope details."""

X = re.compile(r"^x  (?P<step>\S.*) \((?P<count>\d+)\)$")
"""Matches failing step reports under Article 21 with failure count."""

COULD_NOT = re.compile(r"^\?  (?P<step>\S[^:]*): (?P<why>.*)$")
"""Matches unexecutable step reports under Article 21 with explanatory reason."""

PROBLEM = re.compile(r"^     (?P<problem>.+)$")
"""Matches indented problem diagnostics beneath a failing step report."""


def structure() -> tuple[dict[str, dict[str, Any]], dict[str, dict[str, Any]]]:
    """Loads declared projects and products from structure.yaml.

    Returns:
        tuple: A pair of (projects_dict, products_dict) keyed by object identifier.
    """
    data = yaml.safe_load(STRUCTURE.read_text()) or {}
    projects = {p["id"]: p for p in data.get("projects") or []}
    products = {p["id"]: p for p in data.get("products") or []}
    return projects, products


def short(ident: str) -> str:
    """Extracts the terminal identifier segment from a CURIE string.

    Args:
        ident: CURIE identifier string (for example, 'work:project/meta').

    Returns:
        str: Terminal component of the identifier ('meta').
    """
    return ident.rsplit("/", 1)[-1]


def select(
    word: str | None,
    projects: dict[str, dict[str, Any]],
    products: dict[str, dict[str, Any]],
) -> list[dict[str, Any]]:
    """Resolves target projects from a command-line selector or defaults to all projects.

    Args:
        word: Target project name, product name, or CURIE, or None for all projects.
        projects: Mapping of project identifiers to declared project configurations.
        products: Mapping of product identifiers to declared product configurations.

    Returns:
        list[dict[str, Any]]: List of matching project configuration dictionaries.

    Raises:
        SystemExit: If the specified word matches no declared project or product,
            or if a product references an undeclared project.
    """
    if word is None:
        return list(projects.values())
    for ident, project in projects.items():
        if word in (ident, short(ident), project.get("name")):
            return [project]
    for ident, product in products.items():
        if word in (ident, short(ident), product.get("name")):
            chosen = []
            for ref in product.get("built_from") or []:
                if ref not in projects:
                    sys.exit(f"gate: {ident} is built from {ref}, which is not a Project here")
                if projects[ref] not in chosen:
                    chosen.append(projects[ref])
            return chosen
    known = [short(i) for i in (*projects, *products)]
    sys.exit(f"gate: nothing is called '{word}'. Projects and Products: {', '.join(known)}")


def _emit(text: str, *, file: Any = sys.stdout, lock: "threading.Lock | None" = None) -> None:
    """Emits output line-buffered and thread-safe when a lock is provided."""
    if lock is not None:
        with lock:
            print(text, file=file)
    else:
        print(text, file=file)


def run(
    project: dict[str, Any],
    print_lock: "threading.Lock | None" = None,
) -> tuple[list[tuple[str, str, str]], int | None]:
    """Executes a project gate command and streams parsed step reports.

    Args:
        project: Project configuration dictionary containing 'id' and 'gate'.
        print_lock: Optional threading lock ensuring atomic report streaming.

    Returns:
        tuple: A pair containing a list of (mark, step, detail) report triples
        and the process exit code (or None if no gate is asserted).
    """
    name = short(project["id"])
    command = project.get("gate")
    if not command:
        _emit(f"?  {name}: no gate asserted", lock=print_lock)
        return [], None
    proc = subprocess.Popen(command, shell=True, cwd=ROOT, text=True,
                            stdout=subprocess.PIPE, stderr=sys.stderr)
    steps: list[tuple[str, str, str]] = []
    assert proc.stdout is not None
    for line in iter(proc.stdout.readline, ""):
        line = line.rstrip("\n")
        if (m := X.match(line)):
            steps.append(("x", m["step"], m["count"]))
        elif (m := COULD_NOT.match(line)):
            steps.append(("?", m["step"], m["why"]))
        elif (m := OK.match(line)):
            steps.append(("ok", m["step"], m["scope"] or ""))
        elif PROBLEM.match(line) and steps and steps[-1][0] == "x":
            _emit(line, lock=print_lock)
            continue
        else:
            _emit(line, file=sys.stderr, lock=print_lock)
            continue
        _emit(line.replace(m["step"], f"{name}/{m['step']}", 1), lock=print_lock)
    return steps, proc.wait()


def main(argv: list[str]) -> int:
    """CLI entrypoint for running gates across selected projects or products.

    Args:
        argv: Command-line arguments starting with the script name.

    Returns:
        int: 0 if all selected gates report green and exit cleanly, 1 on failure.
    """
    if isinstance(sys.stdout, io.TextIOWrapper):
        sys.stdout.reconfigure(line_buffering=True)
    word = argv[1] if len(argv) > 1 else None
    projects, products = structure()
    chosen = select(word, projects, products)
    if not chosen:
        what = (f"no Project is asserted in {STRUCTURE.relative_to(ROOT)}" if word is None
                else f"{word} is built from no Project")
        sys.exit(f"gate: {what}, so there is no gate to run. A gate over nothing is not green.")

    if len(chosen) == 1:
        results = [(chosen[0], run(chosen[0]))]
    else:
        lock = threading.Lock()
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(chosen)) as executor:
            futures = {executor.submit(run, project, lock): project for project in chosen}
            outcomes: dict[str, tuple[list[tuple[str, str, str]], int | None]] = {}
            for future in concurrent.futures.as_completed(futures):
                p = futures[future]
                outcomes[p["id"]] = future.result()
            results = [(p, outcomes[p["id"]]) for p in chosen]

    failures = []
    total = 0
    for project, (steps, code) in results:
        name = short(project["id"])
        total += len(steps)
        found = [step for mark, step, _ in steps if mark == "x"]
        if not steps:
            failures.append(f"{name}: the gate printed no step in A21's shape (exit {code})")
        elif found:
            failures.append(f"{name}: {', '.join(found)}")
        elif code:
            failures.append(f"{name}: every step reported ok or ? and the gate exited {code}")
    label = word or "portfolio"
    if failures:
        print(f"x  {label} ({len(failures)})")
        for failure in failures:
            print(f"     {failure}")
        return 1
    print(f"ok {label} — {total} steps across {len(chosen)} project{'s' if len(chosen) != 1 else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
