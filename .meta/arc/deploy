#!/usr/bin/env -S uvx --python 3.13 --with pyyaml python
"""Actions Runner Controller and runner scale set Helm deployer.

Idempotently deploys or upgrades the GitHub Actions Runner Controller operator
and associated autoscaling runner scale sets targeting the active Kubernetes context.
Applies GitHub registration secrets and local developer Gemini credentials.

History in deploy.history.md (solorepo's DR-171).
"""
import argparse
import contextlib
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time

import yaml

HERE = pathlib.Path(__file__).resolve().parent
TOKEN_ENV = pathlib.Path("~/.config/solorepo/arc-runner.env").expanduser()
TOKEN_VAR = "ARC_GITHUB_TOKEN"

CHART_VERSION = "0.14.2"
"""Pinned Actions Runner Controller Helm chart version ensuring deterministic deployment across environments."""

CONTROLLER_CHART = "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller"
CONTROLLER_RELEASE = "arc"
CONTROLLER_NAMESPACE = "arc-systems"

RUNNERSET_CHART = "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set"
RUNNERSET_RELEASE = "arc-runner-set"
RUNNER_NAMESPACE = "arc-runners"
SECRET_NAME = "arc-github-token"
GEMINI_SECRET_NAME = "arc-gemini-credentials"
COPILOT_SECRET_NAME = "arc-copilot-credentials"
COPILOT_TOKEN_ENV = "COPILOT_GITHUB_TOKEN"
COPILOT_TOKEN_FILE = pathlib.Path("~/.config/solorepo/copilot.env").expanduser()
CODEX_SECRET_NAME = "arc-codex-credentials"
CODEX_AUTH_FILE = pathlib.Path("~/.codex/auth.json").expanduser()


def find_gemini_dir() -> pathlib.Path | None:
    """Discovers the developer's .gemini configuration directory across macOS,
    Linux, and WSL2 Windows mounts."""
    candidates = [
        pathlib.Path("~/.gemini").expanduser(),
    ]
    wsl_mount = pathlib.Path("/mnt/c/Users")
    if wsl_mount.exists():
        for user_dir in sorted(wsl_mount.iterdir()):
            if user_dir.is_dir() and not user_dir.name.startswith(("$", "Default", "Public", "All Users")):
                candidates.append(user_dir / ".gemini")

    for candidate in candidates:
        if candidate.exists() and (
            (candidate / "oauth_creds.json").exists()
            or (candidate / "antigravity-cli" / "antigravity-oauth-token").exists()
        ):
            return candidate
    return None


def require(*tools: str) -> None:
    """Verifies that all specified CLI executable tools exist on PATH or exits with instructions."""
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        sys.exit(f"arc: {', '.join(missing)} not on PATH — install "
                 f"{'it' if len(missing) == 1 else 'them'} first "
                 f"(.meta/arc/README.md has the steps)")


def token() -> str:
    """Reads the GitHub personal access token used for runner registration.

    Returns:
        str: Personal access token with repo scope.

    Raises:
        SystemExit: If ARC_GITHUB_TOKEN is unset, the credential file is missing,
            has insecure file permissions, or lacks the token key.
    """
    found = os.environ.get(TOKEN_VAR)
    if found:
        print(f"arc: speaking with {TOKEN_VAR} from the environment", file=sys.stderr)
        return found
    if not TOKEN_ENV.exists():
        sys.exit(f"arc: no {TOKEN_VAR} in the environment and no {TOKEN_ENV}. "
                 f"Create a classic PAT with repo scope (.meta/arc/README.md has the "
                 f"steps) and either export {TOKEN_VAR} or write it there as "
                 f"{TOKEN_VAR}=<token>.")
    mode = TOKEN_ENV.stat().st_mode
    if mode & 0o077:
        sys.exit(f"arc: {TOKEN_ENV} is readable by others (mode {mode & 0o777:o}); "
                 f"refusing to use it. chmod 600 it.")
    for line in TOKEN_ENV.read_text().splitlines():
        line = line.strip().removeprefix("export ").strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() == TOKEN_VAR:
            value = value.strip().strip("\"'")
            if not value:
                break
            print(f"arc: speaking with the credential in {TOKEN_ENV}", file=sys.stderr)
            return value
    sys.exit(f"arc: {TOKEN_ENV} has no {TOKEN_VAR}")


def current_context() -> str:
    """Returns the active kubectl context name or exits if none is configured."""
    out = subprocess.run(["kubectl", "config", "current-context"],
                         check=False, capture_output=True, text=True)
    if out.returncode:
        sys.exit("arc: no kubectl context is set — point kubectl at a cluster first "
                 "(`.meta/arc/cluster` for a local one, or `kubectl config use-context`)")
    return out.stdout.strip()


def apply_secret(pat: str) -> None:
    """Applies the GitHub runner registration Secret into the runner namespace.

    Args:
        pat: GitHub personal access token passed via process stdin.
    """
    manifest = subprocess.run(["kubectl", "create", "namespace", RUNNER_NAMESPACE,
                               "--dry-run=client", "-o", "yaml"],
                              capture_output=True, text=True, check=True).stdout
    subprocess.run(["kubectl", "apply", "-f", "-"], input=manifest, text=True, check=True)
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": SECRET_NAME, "namespace": RUNNER_NAMESPACE},
        "type": "Opaque",
        "stringData": {"github_token": pat},
    }
    subprocess.run(["kubectl", "apply", "-f", "-"], input=yaml.safe_dump(secret),
                   text=True, check=True)


def apply_gemini_secret() -> None:
    """Applies local Gemini subscription credentials as a Secret in the runner namespace."""
    gemini_dir = find_gemini_dir()
    if not gemini_dir:
        print(f"arc: notice: no .gemini directory with credentials found; skipping {GEMINI_SECRET_NAME}", file=sys.stderr)
        return
    files = {
        "oauth_creds.json": gemini_dir / "oauth_creds.json",
        "jetski-standalone-oauth-token": gemini_dir / "jetski-standalone-oauth-token",
        "google_accounts.json": gemini_dir / "google_accounts.json",
        "antigravity-oauth-token": gemini_dir / "antigravity-cli" / "antigravity-oauth-token",
        "settings.json": gemini_dir / "antigravity-cli" / "settings.json",
    }
    string_data = {}
    for key, path in files.items():
        if path.exists():
            with contextlib.suppress(OSError, ValueError):
                string_data[key] = path.read_text(encoding="utf-8")
    if not string_data:
        print(f"arc: notice: no readable credential files in {gemini_dir}; skipping {GEMINI_SECRET_NAME}", file=sys.stderr)
        return
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": GEMINI_SECRET_NAME, "namespace": RUNNER_NAMESPACE},
        "type": "Opaque",
        "stringData": string_data,
    }
    subprocess.run(["kubectl", "apply", "-f", "-"], input=yaml.safe_dump(secret),
                   text=True, check=True)
    print(f"arc: applied {GEMINI_SECRET_NAME} ({len(string_data)} files)", file=sys.stderr)


def copilot_token() -> str | None:
    """Read the Copilot CLI token from the environment or its mode-600 configuration file."""
    found = os.environ.get(COPILOT_TOKEN_ENV)
    if found:
        return found
    if not COPILOT_TOKEN_FILE.exists():
        print(f"arc: notice: no {COPILOT_TOKEN_ENV} or {COPILOT_TOKEN_FILE}; "
              f"skipping {COPILOT_SECRET_NAME}", file=sys.stderr)
        return None
    mode = COPILOT_TOKEN_FILE.stat().st_mode
    if mode & 0o077:
        sys.exit(f"arc: {COPILOT_TOKEN_FILE} is readable by others (mode {mode & 0o777:o}); "
                 "refusing to use it. chmod 600 it.")
    for line in COPILOT_TOKEN_FILE.read_text(encoding="utf-8").splitlines():
        line = line.strip().removeprefix("export ").strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() == COPILOT_TOKEN_ENV and (value := value.strip().strip("\"'")):
            return value
    sys.exit(f"arc: {COPILOT_TOKEN_FILE} has no {COPILOT_TOKEN_ENV}")


def apply_copilot_secret() -> None:
    """Apply the Copilot CLI token as a Secret in the runner namespace."""
    if not (credential := copilot_token()):
        return
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": COPILOT_SECRET_NAME, "namespace": RUNNER_NAMESPACE},
        "type": "Opaque",
        "stringData": {COPILOT_TOKEN_ENV: credential},
    }
    subprocess.run(["kubectl", "apply", "-f", "-"], input=yaml.safe_dump(secret),
                   text=True, check=True)
    print(f"arc: applied {COPILOT_SECRET_NAME}", file=sys.stderr)


def find_codex_auth() -> pathlib.Path | None:
    """Find Codex's file-backed ChatGPT login on Linux, macOS, or WSL2."""
    candidates = [CODEX_AUTH_FILE]
    wsl_mount = pathlib.Path("/mnt/c/Users")
    if wsl_mount.exists():
        candidates.extend(
            user_dir / ".codex" / "auth.json"
            for user_dir in sorted(wsl_mount.iterdir())
            if user_dir.is_dir() and not user_dir.name.startswith(
                ("$", "Default", "Public", "All Users")
            )
        )
    return next((path for path in candidates if path.is_file()), None)


def codex_chatgpt_auth() -> str | None:
    """Read only a file-backed Codex ChatGPT login for the ARC credential Secret."""
    auth_file = find_codex_auth()
    if not auth_file:
        print(f"arc: notice: no file-backed Codex login at {CODEX_AUTH_FILE}; "
              f"skipping {CODEX_SECRET_NAME}", file=sys.stderr)
        return None
    mode = auth_file.stat().st_mode
    if mode & 0o077:
        sys.exit(f"arc: {auth_file} is readable by others (mode {mode & 0o777:o}); "
                 "refusing to use it. chmod 600 it.")
    try:
        auth = json.loads(auth_file.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        sys.exit(f"arc: cannot read Codex ChatGPT login from {auth_file}: {exc}")
    if not isinstance(auth, dict) or auth.get("auth_mode") != "chatgpt" or \
            not isinstance(auth.get("tokens"), dict):
        sys.exit(f"arc: {auth_file} is not a ChatGPT-authenticated Codex login; "
                 "API-key credentials are not accepted")
    return auth_file.read_text(encoding="utf-8")


def apply_codex_secret() -> None:
    """Apply the local Codex ChatGPT login as a Kubernetes Secret."""
    if not (credential := codex_chatgpt_auth()):
        return
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": CODEX_SECRET_NAME, "namespace": RUNNER_NAMESPACE},
        "type": "Opaque",
        "stringData": {"auth.json": credential},
    }
    subprocess.run(["kubectl", "apply", "-f", "-"], input=yaml.safe_dump(secret),
                   text=True, check=True)
    print(f"arc: applied {CODEX_SECRET_NAME}", file=sys.stderr)


def helm_upgrade(release: str, namespace: str, chart: str | pathlib.Path, values: pathlib.Path) -> None:
    """Installs or upgrades a Helm release chart with specified values in the target namespace."""
    subprocess.run([
        "helm", "upgrade", "--install", release,
        "--namespace", namespace, "--create-namespace",
        "--version", CHART_VERSION,
        "-f", str(values), chart,
    ], check=True)


STALE_EXCEPTIONS = (
    "RunnerScaleSetNotFoundException",
    "RunnerScaleSetSessionConflictException",
)


def is_registration_stale(since_seconds: float | int = 120) -> bool:
    """Checks whether recent controller or listener logs contain stale scale set registration errors.

    Args:
        since_seconds: Window in seconds to inspect container logs. Defaults to 120.

    Returns:
        bool: True if 404 or 409 scale set exceptions are present in logs, False otherwise.
    """
    scale_set = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "get", "autoscalingrunnerset",
        RUNNERSET_RELEASE, "-o", "jsonpath={.metadata.annotations.runner-scale-set-id}",
    ], check=False, capture_output=True, text=True)
    if scale_set.returncode != 0 or not scale_set.stdout.strip():
        return False

    since_arg = f"--since={max(60, int(since_seconds))}s"
    for label, ns in [("app.kubernetes.io/component=runner-scale-set-listener", CONTROLLER_NAMESPACE),
                      ("app.kubernetes.io/component=controller-manager", CONTROLLER_NAMESPACE)]:
        logs = subprocess.run([
            "kubectl", "-n", ns, "logs", "-l", label, since_arg, "--tail=50",
        ], check=False, capture_output=True, text=True)
        if logs.returncode == 0 and any(exc in logs.stdout for exc in STALE_EXCEPTIONS):
            return True

    return False


def is_listener_ready() -> bool:
    """Checks whether a runner scale set listener pod is running and ready.

    Returns:
        bool: True if a ready listener pod exists in the controller namespace, False otherwise.
    """
    out = subprocess.run([
        "kubectl", "-n", CONTROLLER_NAMESPACE, "get", "pods",
        "-l", "app.kubernetes.io/component=runner-scale-set-listener",
        "-o", "json",
    ], check=False, capture_output=True, text=True)
    if out.returncode != 0:
        return False
    try:
        items = json.loads(out.stdout).get("items", [])
    except (json.JSONDecodeError, AttributeError):
        return False
    for pod in items:
        if pod.get("metadata", {}).get("deletionTimestamp"):
            continue
        status = pod.get("status", {})
        if status.get("phase") != "Running":
            continue
        statuses = status.get("containerStatuses", [])
        if statuses and all(c.get("ready", False) for c in statuses):
            return True
    return False


def active_runners() -> tuple[list[str], bool]:
    """Inspects ephemeral runner custom resources for active execution.

    Returns:
        tuple[list[str], bool]: Tuple containing list of active runner names and a boolean
            indicating whether the cluster inspection succeeded.
    """
    out = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "get", "ephemeralrunners", "-o", "json",
    ], check=False, capture_output=True, text=True)
    if out.returncode != 0:
        return [], False
    try:
        items = json.loads(out.stdout).get("items", [])
    except (json.JSONDecodeError, AttributeError):
        return [], False
    active = []
    for r in items:
        phase = r.get("status", {}).get("phase", "")
        if phase == "Running":
            active.append(r["metadata"]["name"])
        elif phase not in ("PodFailed", "Failed", "Succeeded"):
            name = r["metadata"]["name"]
            pod = subprocess.run([
                "kubectl", "-n", RUNNER_NAMESPACE, "get", "pod", name,
                "-o", "jsonpath={.status.phase}",
            ], check=False, capture_output=True, text=True)
            if pod.returncode == 0:
                if pod.stdout.strip() in ("Pending", "Running"):
                    active.append(name)
            elif "NotFound" in pod.stderr or "not found" in pod.stderr.lower():
                pass
            else:
                active.append(name)
    return active, True


def _wait_active_runners_drain() -> bool:
    """Waits for active runner jobs to finish before modifying runner sets.

    Returns:
        bool: True if active runners drained successfully, False if timed out.
    """
    deadline = time.time() + 600
    while time.time() < deadline:
        active, ok = active_runners()
        if ok and not active:
            return True
        busy = active or ["(unverified runner)"]
        print(f"arc: waiting for active runner(s) {', '.join(busy)} to finish before reset...",
              file=sys.stderr)
        time.sleep(5)
    active, ok = active_runners()
    if not ok or active:
        busy = active or ["(unverified runner)"]
        print(f"arc: active runner(s) {', '.join(busy)} still running after 10m; "
              "aborting stale registration reset to protect active jobs.",
              file=sys.stderr)
        return False
    return True


def _delete_stuck_child_crs() -> None:
    """Deletes stuck child CRs that bind dead runnerScaleSetId in their spec."""
    for kind, ns in [("ephemeralrunnerset", RUNNER_NAMESPACE),
                     ("autoscalinglistener", CONTROLLER_NAMESPACE),
                     ("ephemeralrunner", RUNNER_NAMESPACE)]:
        del_cmd = subprocess.run([
            "kubectl", "-n", ns, "delete", kind, "--all",
            "--ignore-not-found", "--timeout", "30s",
        ], check=False, capture_output=True, text=True)
        if del_cmd.returncode != 0:
            print(f"arc: {kind} did not finish deleting in 30s — "
                  f"`kubectl get {kind} -n {ns} -o yaml` will show what it is waiting on",
                  file=sys.stderr)


def _wait_listener_ready() -> None:
    """Waits for controller to re-register and replacement listener to become ready."""
    print(f"arc: waiting up to 30s for replacement listener in {CONTROLLER_NAMESPACE} to become ready...",
          file=sys.stderr)
    post_deadline = time.time() + 30
    while time.time() < post_deadline:
        if is_listener_ready():
            return
        time.sleep(2)
    print(f"arc: replacement listener did not become ready in 30s — "
          f"`kubectl get pods -n {CONTROLLER_NAMESPACE}` will show its status",
          file=sys.stderr)


def reset_stale_registration(start_time: float | None = None) -> None:
    """Clears cached scale set metadata from an AutoscalingRunnerSet custom resource.

    Args:
        start_time: Optional deployment start epoch timestamp used to calibrate
            log inquiry windows. Defaults to None.
    """
    since_seconds = (time.time() - start_time + 60) if start_time else 120
    if not is_registration_stale(since_seconds):
        print("arc: waiting up to 25s for listener to start or report registration error...",
              file=sys.stderr)
        deadline = time.time() + 25
        while time.time() < deadline:
            if is_registration_stale(since_seconds=60):
                break
            if is_listener_ready():
                return
            time.sleep(2)
        else:
            if not is_registration_stale(since_seconds=60):
                return

    print("arc: detected stale runner scale set registration on GitHub; resetting...",
          file=sys.stderr)

    if not _wait_active_runners_drain():
        return

    out = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "patch", "autoscalingrunnerset",
        RUNNERSET_RELEASE, "--type=merge",
        "-p", '{"metadata": {"annotations": {"actions.github.com/values-hash": null, "runner-scale-set-id": null}}}',
    ], check=False, capture_output=True, text=True)
    if out.returncode != 0:
        print(f"arc: failed to patch {RUNNERSET_RELEASE}: {out.stderr.strip()}",
              file=sys.stderr)
        return

    _delete_stuck_child_crs()
    _wait_listener_ready()


def main() -> None:
    """CLI entry point for deploying the Actions Runner Controller and runner scale sets."""
    argparse.ArgumentParser(description=__doc__,
                            formatter_class=argparse.RawDescriptionHelpFormatter).parse_args()
    require("kubectl", "helm")
    context = current_context()
    print(f"arc: deploying to kubectl context '{context}'", file=sys.stderr)
    start_time = time.time()
    pat = token()
    helm_upgrade(CONTROLLER_RELEASE, CONTROLLER_NAMESPACE, CONTROLLER_CHART,
                 HERE / "values-controller.yaml")
    apply_secret(pat)
    apply_gemini_secret()
    apply_copilot_secret()
    apply_codex_secret()
    helm_upgrade(RUNNERSET_RELEASE, RUNNER_NAMESPACE, RUNNERSET_CHART,
                 HERE / "values-runnerset.yaml")
    reset_stale_registration(start_time)
    print(f"arc: done. `kubectl get pods -n {CONTROLLER_NAMESPACE}` and "
          f"GitHub's Settings → Actions → Runners on caindy/solorepo should show "
          f"'{RUNNERSET_RELEASE}'.", file=sys.stderr)


if __name__ == "__main__":
    main()
