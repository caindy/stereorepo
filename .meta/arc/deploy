#!/usr/bin/env -S uvx --with pyyaml python
"""The self-hosted runner: layer two of two, and the one that matters.

    .meta/arc/deploy

Installs GitHub's Actions Runner Controller — the operator, then the runner
scale set `runs-on: arc-runner-set` targets — against whatever cluster
`kubectl config current-context` already names. Never `kind`-specific, which
is the whole point: the same command is what a `kind` cluster from
`.meta/arc/cluster` runs against today and what a machine with its own
cluster runs against tomorrow, `kubectl config use-context` being the only
thing that changes between them.

`helm upgrade --install` both times, so running this again after a values
file changes, or after nothing changed at all, is the same command and does
the same thing either way.

`helm upgrade` preserves custom resource annotations across runs. If a runner
scale set was deregistered on GitHub (for example, by `teardown` running on
another machine), an existing `AutoscalingRunnerSet` here would otherwise
continue holding the stale `runner-scale-set-id` annotation — a 404 from
GitHub on JIT config generation that the controller never recovers from on its
own. `deploy` clears that cached ID and any stuck ephemeral runners on upgrade
so the controller re-verifies registration with GitHub and adopts the live ID.

The GitHub token ARC registers runners with is never a command-line argument
and never a file this repository holds. It comes from `$ARC_GITHUB_TOKEN` in
the environment, or from `~/.config/solorepo/arc-runner.env` — outside the
tree, per machine, mode 600 — the same shape `.meta/say/channel.py` holds a
Role's credential in (solorepo's DR-073), though this is not a Role's: nothing
here posts to GitHub as anyone, it only tells ARC how to ask GitHub for
runner registrations.
"""
import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time

import yaml

HERE = pathlib.Path(__file__).resolve().parent
TOKEN_ENV = pathlib.Path("~/.config/solorepo/arc-runner.env").expanduser()
TOKEN_VAR = "ARC_GITHUB_TOKEN"

# Pinned, like every other tool this repository provisions (`actions/checkout@v7.0.1`):
# `helm upgrade --install` is idempotent for a given chart version, not across
# "whatever `latest` resolves to today" — two machines running this a month
# apart, or the same machine before and after an unrelated `helm repo update`,
# would otherwise land different controller and runner-set versions from a
# command that changed nothing. An upgrade is an edit to this file, not a side
# effect of the calendar.
CHART_VERSION = "0.14.2"

CONTROLLER_CHART = "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller"
CONTROLLER_RELEASE = "arc"
CONTROLLER_NAMESPACE = "arc-systems"

RUNNERSET_CHART = "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set"
RUNNERSET_RELEASE = "arc-runner-set"
RUNNER_NAMESPACE = "arc-runners"
SECRET_NAME = "arc-github-token"


def require(*tools):
    """Verifies that all specified CLI executable tools exist on PATH or exits with instructions."""
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        sys.exit(f"arc: {', '.join(missing)} not on PATH — install "
                 f"{'it' if len(missing) == 1 else 'them'} first "
                 f"(.meta/arc/README.md has the steps)")


def token():
    """The PAT ARC uses to register runners, read the way a Role's is: fail
    loud rather than fall back to something that looks like success."""
    found = os.environ.get(TOKEN_VAR)
    if found:
        print(f"arc: speaking with {TOKEN_VAR} from the environment", file=sys.stderr)
        return found
    if not TOKEN_ENV.exists():
        sys.exit(f"arc: no {TOKEN_VAR} in the environment and no {TOKEN_ENV}. "
                 f"Create a classic PAT with repo scope (.meta/arc/README.md has the "
                 f"steps) and either export {TOKEN_VAR} or write it there as "
                 f"{TOKEN_VAR}=<token>.")
    mode = TOKEN_ENV.stat().st_mode
    if mode & 0o077:
        sys.exit(f"arc: {TOKEN_ENV} is readable by others (mode {mode & 0o777:o}); "
                 f"refusing to use it. chmod 600 it.")
    for line in TOKEN_ENV.read_text().splitlines():
        line = line.strip().removeprefix("export ").strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() == TOKEN_VAR:
            value = value.strip().strip("\"'")
            if not value:
                break
            print(f"arc: speaking with the credential in {TOKEN_ENV}", file=sys.stderr)
            return value
    sys.exit(f"arc: {TOKEN_ENV} has no {TOKEN_VAR}")


def current_context():
    """Returns the active kubectl context name or exits if none is configured."""
    out = subprocess.run(["kubectl", "config", "current-context"],
                         capture_output=True, text=True)
    if out.returncode:
        sys.exit("arc: no kubectl context is set — point kubectl at a cluster first "
                 "(`.meta/arc/cluster` for a local one, or `kubectl config use-context`)")
    return out.stdout.strip()


def apply_secret(pat):
    """The registration Secret, applied as a manifest over stdin so the token
    is never a process argument (`ps` would show it) or a shell history line."""
    manifest = subprocess.run(["kubectl", "create", "namespace", RUNNER_NAMESPACE,
                               "--dry-run=client", "-o", "yaml"],
                              capture_output=True, text=True, check=True).stdout
    subprocess.run(["kubectl", "apply", "-f", "-"], input=manifest, text=True, check=True)
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": SECRET_NAME, "namespace": RUNNER_NAMESPACE},
        "type": "Opaque",
        "stringData": {"github_token": pat},
    }
    subprocess.run(["kubectl", "apply", "-f", "-"], input=yaml.safe_dump(secret),
                   text=True, check=True)


def helm_upgrade(release, namespace, chart, values):
    """Installs or upgrades a Helm release chart with specified values in the target namespace."""
    subprocess.run([
        "helm", "upgrade", "--install", release,
        "--namespace", namespace, "--create-namespace",
        "--version", CHART_VERSION,
        "-f", str(values), chart,
    ], check=True)


def is_registration_stale(since_seconds=120):
    """Whether ARC has encountered a 404 from GitHub for a dead runner scale set ID."""
    scale_set = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "get", "autoscalingrunnerset",
        RUNNERSET_RELEASE, "-o", "jsonpath={.metadata.annotations.runner-scale-set-id}",
    ], capture_output=True, text=True)
    if scale_set.returncode != 0 or not scale_set.stdout.strip():
        return False

    since_arg = f"--since={max(60, int(since_seconds))}s"
    for label, ns in [("app.kubernetes.io/component=runner-scale-set-listener", CONTROLLER_NAMESPACE),
                      ("app.kubernetes.io/component=controller-manager", CONTROLLER_NAMESPACE)]:
        logs = subprocess.run([
            "kubectl", "-n", ns, "logs", "-l", label, since_arg, "--tail=50",
        ], capture_output=True, text=True)
        if logs.returncode == 0 and "RunnerScaleSetNotFoundException" in logs.stdout:
            return True

    return False


def active_runners():
    """Names of EphemeralRunners that are actively executing or starting a job.

    Returns (runners, True) on a clean inspection, or ([], False) if kubectl
    failed or the response was unparseable. Fails closed: callers must not
    treat an error as 'no runners active'.
    """
    out = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "get", "ephemeralrunners", "-o", "json",
    ], capture_output=True, text=True)
    if out.returncode != 0:
        return [], False
    try:
        items = json.loads(out.stdout).get("items", [])
    except Exception:
        return [], False
    active = []
    for r in items:
        phase = r.get("status", {}).get("phase", "")
        if phase == "Running":
            active.append(r["metadata"]["name"])
        elif phase not in ("PodFailed", "Failed", "Succeeded"):
            name = r["metadata"]["name"]
            pod = subprocess.run([
                "kubectl", "-n", RUNNER_NAMESPACE, "get", "pod", name,
                "-o", "jsonpath={.status.phase}",
            ], capture_output=True, text=True)
            if pod.returncode == 0:
                if pod.stdout.strip() in ("Pending", "Running"):
                    active.append(name)
            else:
                active.append(name)
    return active, True


def reset_stale_registration(start_time=None):
    """Clear cached scale set metadata from an existing AutoscalingRunnerSet.

    `helm upgrade` preserves existing annotations on custom resources. If a
    runner scale set was deregistered on GitHub (e.g. by `teardown` running on
    another machine), the AutoscalingRunnerSet in this cluster continues to
    hold the stale `runner-scale-set-id` annotation. The controller never clears
    that annotation on 404 and fails every JIT config generation.

    We only reset if the registration is actually stale (evidenced by a 404
    `RunnerScaleSetNotFoundException` from GitHub in recent listener or controller
    logs). When detected, we wait for any active jobs to finish, clean up stuck
    child resources with bounded timeouts, and patch the custom resource so the
    controller re-verifies registration with GitHub and adopts a live ID.
    """
    since_seconds = (time.time() - start_time + 60) if start_time else 120
    if not is_registration_stale(since_seconds):
        return

    print("arc: detected stale runner scale set registration on GitHub; resetting...",
          file=sys.stderr)

    # Wait for any active jobs to finish before touching runner sets.
    deadline = time.time() + 600
    while time.time() < deadline:
        active, ok = active_runners()
        if ok and not active:
            break
        busy = active or ["(unverified runner)"]
        print(f"arc: waiting for active runner(s) {', '.join(busy)} to finish before reset...",
              file=sys.stderr)
        time.sleep(5)
    else:
        active, ok = active_runners()
        if not ok or active:
            busy = active or ["(unverified runner)"]
            print(f"arc: active runner(s) {', '.join(busy)} still running after 10m; "
                  "aborting stale registration reset to protect active jobs.",
                  file=sys.stderr)
            return

    out = subprocess.run([
        "kubectl", "-n", RUNNER_NAMESPACE, "patch", "autoscalingrunnerset",
        RUNNERSET_RELEASE, "--type=merge",
        "-p", '{"metadata": {"annotations": {"actions.github.com/values-hash": null, "runner-scale-set-id": null}}}',
    ], capture_output=True, text=True)
    if out.returncode != 0:
        print(f"arc: failed to patch {RUNNERSET_RELEASE}: {out.stderr.strip()}",
              file=sys.stderr)
        return

    # Delete stuck child CRs that bind the dead runnerScaleSetId in their spec.
    for kind, ns in [("ephemeralrunnerset", RUNNER_NAMESPACE),
                     ("autoscalinglistener", CONTROLLER_NAMESPACE),
                     ("ephemeralrunner", RUNNER_NAMESPACE)]:
        del_cmd = subprocess.run([
            "kubectl", "-n", ns, "delete", kind, "--all",
            "--ignore-not-found", "--timeout", "30s",
        ], capture_output=True, text=True)
        if del_cmd.returncode != 0:
            print(f"arc: {kind} did not finish deleting in 30s — "
                  f"`kubectl get {kind} -n {ns} -o yaml` will show what it is waiting on",
                  file=sys.stderr)


def main():
    """CLI entry point for deploying the Actions Runner Controller and runner scale sets."""
    argparse.ArgumentParser(description=__doc__,
                            formatter_class=argparse.RawDescriptionHelpFormatter).parse_args()
    require("kubectl", "helm")
    context = current_context()
    print(f"arc: deploying to kubectl context '{context}'", file=sys.stderr)
    start_time = time.time()
    pat = token()
    helm_upgrade(CONTROLLER_RELEASE, CONTROLLER_NAMESPACE, CONTROLLER_CHART,
                 HERE / "values-controller.yaml")
    apply_secret(pat)
    helm_upgrade(RUNNERSET_RELEASE, RUNNER_NAMESPACE, RUNNERSET_CHART,
                 HERE / "values-runnerset.yaml")
    reset_stale_registration(start_time)
    print(f"arc: done. `kubectl get pods -n {CONTROLLER_NAMESPACE}` and "
          f"GitHub's Settings → Actions → Runners on caindy/solorepo should show "
          f"'{RUNNERSET_RELEASE}'.", file=sys.stderr)


if __name__ == "__main__":
    main()
