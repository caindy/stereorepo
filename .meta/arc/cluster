#!/usr/bin/env python3
"""Local Kubernetes cluster provisioner for Actions Runner Controller.

Idempotently provisions a local kind cluster named `solorepo-arc` for hosting
Actions Runner Controller runners when no existing cluster context is configured.
"""
import shutil
import subprocess
import sys

CLUSTER = "solorepo-arc"


def existing_clusters() -> list[str]:
    """Retrieves names of active kind clusters on the local system.

    Returns:
        list[str]: Names of currently discovered kind clusters.

    Raises:
        SystemExit: If the `kind` executable is missing from PATH or execution fails.
    """
    if not shutil.which("kind"):
        sys.exit("arc-cluster: kind is not on PATH — install it, or point kubectl "
                 "at a cluster you already have and run `just arc` directly")
    out = subprocess.run(["kind", "get", "clusters"], check=False, capture_output=True, text=True)
    if out.returncode:
        sys.exit(f"arc-cluster: kind could not list clusters — {out.stderr.strip()}")
    return [line.strip() for line in out.stdout.splitlines() if line.strip()]


def main() -> None:
    """CLI entrypoint for creating the local kind cluster if absent."""
    if CLUSTER in existing_clusters():
        print(f"arc-cluster: {CLUSTER} already exists; nothing to do", file=sys.stderr)
        return
    subprocess.run(["kind", "create", "cluster", "--name", CLUSTER], check=True)


if __name__ == "__main__":
    main()
