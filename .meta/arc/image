#!/usr/bin/env python3
"""Build and load runner container images for Actions Runner Controller.

Builds the single-source runner container image defined in .meta/arc/Dockerfile,
tagging both the local repository and the GitHub Container Registry (GHCR) target.
Optionally loads the built image into a local Kind Kubernetes cluster.
"""
import argparse
import base64
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

HERE = pathlib.Path(__file__).resolve().parent
IMAGE_REPO = "ghcr.io/caindy/solorepo-runner"
LOCAL_REPO = "solorepo-runner"
DEFAULT_CLUSTER = "solorepo-arc"


def default_tag() -> str:
    """Extracts default image tag pinned in values-runnerset.yaml."""
    values_path = HERE / "values-runnerset.yaml"
    if values_path.exists():
        match = re.search(r"ghcr\.io/caindy/solorepo-runner:([a-zA-Z0-9_.-]+)",
                          values_path.read_text(encoding="utf-8"))
        if match:
            return match.group(1)
    return "latest"


def require(*tools: str) -> None:
    """Verifies that all specified CLI tools exist on PATH or exits with an error."""
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        sys.exit(f"arc-image: {', '.join(missing)} not on PATH — install "
                 f"{'it' if len(missing) == 1 else 'them'} first.")


def verify_ghcr_image(tag: str, token: str | None = None) -> bool:
    """Verifies whether the container image manifest exists on GitHub Container Registry (GHCR).

    Args:
        tag: Pinned container image tag.
        token: Optional GitHub token for authentication.

    Returns:
        bool: True if manifest exists on GHCR.
    """
    url = f"https://ghcr.io/v2/caindy/solorepo-runner/manifests/{tag}"
    accept = (
        "application/vnd.docker.distribution.manifest.v2+json, "
        "application/vnd.oci.image.manifest.v1+json, "
        "application/vnd.docker.distribution.manifest.list.v2+json, "
        "application/vnd.oci.image.index.v1+json"
    )
    if token:
        req = urllib.request.Request(
            url,
            headers={"Accept": accept, "Authorization": f"Bearer {token}"},
            method="HEAD",
        )
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                return bool(resp.status == 200)
        except urllib.error.HTTPError as err:
            if err.code != 401:
                return bool(err.code == 200)
        except (urllib.error.URLError, TimeoutError):
            pass

    token_url = "https://ghcr.io/token?service=ghcr.io&scope=repository:caindy/solorepo-runner:pull"
    t_req = urllib.request.Request(token_url)
    if token:
        auth_bytes = base64.b64encode(f":{token}".encode("ascii")).decode("ascii")
        t_req.add_header("Authorization", f"Basic {auth_bytes}")

    bearer = None
    try:
        with urllib.request.urlopen(t_req, timeout=10) as t_resp:
            token_data = json.loads(t_resp.read().decode("utf-8"))
            bearer = token_data.get("token")
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, KeyError):
        pass

    req2 = urllib.request.Request(url, headers={"Accept": accept}, method="HEAD")
    if bearer:
        req2.add_header("Authorization", f"Bearer {bearer}")

    try:
        with urllib.request.urlopen(req2, timeout=15) as resp2:
            return bool(resp2.status == 200)
    except urllib.error.HTTPError as err2:
        return bool(err2.code == 200)
    except (urllib.error.URLError, TimeoutError):
        return False


def main() -> None:
    """Builds runner container image and optionally loads it into Kind."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--tag",
        default=default_tag(),
        help="Runner image tag (defaults to tag from values-runnerset.yaml)",
    )
    parser.add_argument(
        "--check-ghcr",
        metavar="TAG",
        help="Verify that runner image with specified TAG exists on GHCR",
    )
    parser.add_argument(
        "--load",
        action="store_true",
        help=f"Pre-load built image into local Kind cluster (default: {DEFAULT_CLUSTER})",
    )
    parser.add_argument(
        "--cluster",
        default=DEFAULT_CLUSTER,
        help=f"Kind cluster name to load image into (default: {DEFAULT_CLUSTER})",
    )
    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Do not use cache when building container image",
    )
    args = parser.parse_args()

    if args.check_ghcr:
        token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
        tag = args.check_ghcr
        print(f"arc-image: checking GHCR for {IMAGE_REPO}:{tag}...", file=sys.stderr)
        if verify_ghcr_image(tag, token=token):
            print(f"arc-image: verified {IMAGE_REPO}:{tag} on GHCR", file=sys.stderr)
            return
        sys.exit(f"arc-image: {IMAGE_REPO}:{tag} not found on GHCR")

    require("docker")
    if args.load:
        require("kind")

    tag = args.tag
    image_target = f"{IMAGE_REPO}:{tag}"
    local_target = f"{LOCAL_REPO}:{tag}"

    dockerfile = HERE / "Dockerfile"
    if not dockerfile.exists():
        sys.exit(f"arc-image: Dockerfile not found at {dockerfile}")

    build_cmd = ["docker", "build", "-t", image_target, "-t", local_target]
    if args.no_cache:
        build_cmd.append("--no-cache")
    build_cmd.extend(["-f", str(dockerfile), str(HERE)])

    print(f"arc-image: building {image_target}...", file=sys.stderr)
    try:
        subprocess.run(build_cmd, check=True)
    except subprocess.CalledProcessError as exc:
        sys.exit(f"arc-image: docker build failed with code {exc.returncode}")

    print(f"arc-image: successfully built {image_target}", file=sys.stderr)

    if args.load:
        print(f"arc-image: loading {image_target} into Kind cluster '{args.cluster}'...",
              file=sys.stderr)
        load_cmd = ["kind", "load", "docker-image", image_target, "--name", args.cluster]
        try:
            subprocess.run(load_cmd, check=True)
        except subprocess.CalledProcessError as exc:
            sys.exit(f"arc-image: kind load failed with code {exc.returncode}")
        print(f"arc-image: loaded {image_target} into Kind cluster '{args.cluster}'",
              file=sys.stderr)


if __name__ == "__main__":
    main()
