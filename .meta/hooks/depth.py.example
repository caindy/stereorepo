"""Example programmatic depth hook for specialized portfolios (solorepo's DR-188).

To activate this hook in a specialized portfolio, copy or rename this file to
`.meta/hooks/depth.py`. The 4-layer template method pipeline in `.meta/depth.py`
evaluates this module at Layer 3 if present.

The hook must expose an `evaluate_depth` function matching this signature:
    def evaluate_depth(pr_meta: dict, files: list[str], diff_patch: str) -> DepthConfig | None

If `evaluate_depth` returns a `DepthConfig`, that configuration sets the reviewer
model, effort, agent concurrency, and timeouts. If it returns `None`, evaluation
falls through to Layer 4 (the standard Sonnet baseline).
"""

from __future__ import annotations

import typing


class DepthConfig(typing.NamedTuple):
    """Reviewer execution parameters returned to the review workflow."""

    model: str
    gemini_model: str
    effort: str
    turns: int
    minutes: int
    agents: int


# Built-in presets matching solorepo's depth tiers (solorepo's DR-188, DR-189)
DEEP = DepthConfig(
    model="claude-opus-5",
    gemini_model="gemini-3.8-flash",
    effort="high",
    turns=120,
    minutes=45,
    agents=3,
)

STANDARD = DepthConfig(
    model="claude-sonnet-5",
    gemini_model="gemini-3.8-flash",
    effort="medium",
    turns=120,
    minutes=15,
    agents=1,
)


def evaluate_depth(
    pr_meta: dict[str, typing.Any],
    files: list[str],
    diff_patch: str,
) -> DepthConfig | None:
    """Evaluates whether a pull request requires deep or custom reviewer auditing.

    Args:
        pr_meta: GitHub PR metadata (e.g. title, body, labels).
        files: Relative file paths modified in the cumulative or incremental diff.
        diff_patch: The full git diff patch text.

    Returns:
        A DepthConfig instance to override review parameters, or None to fall
        through to standard baseline heuristics.
    """
    # Example 1: Check PR labels for explicit reviewer depth overrides
    labels = [
        lbl.get("name") if isinstance(lbl, dict) else str(lbl)
        for lbl in pr_meta.get("labels", [])
    ]
    if "deep-review" in labels:
        return DEEP

    # Example 2: Inspect file paths for domain boundaries (e.g., migrations, auth)
    if any(
        f.startswith("migrations/") or "auth" in f.lower() or f.endswith(".sql")
        for f in files
    ):
        return DEEP

    # Example 3: Inspect diff size or keywords in diff_patch
    if len(files) > 20 or "SECURITY_CRITICAL" in diff_patch:
        return DEEP

    # Return None to allow Layer 4 fallback to standard review depth
    return None
