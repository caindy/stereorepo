{
  "permissions": {
    "deny": [
      "Bash(gh api:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh stack link:*)",
      "Bash(gh stack merge:*)",
      "Bash(gh stack submit:*)",
      "Bash(gh stack unstack:*)",
      "Bash(gh stack sync:*)",
      "Bash(gh stack push:*)"
    ],
    "allow": [
      "Bash(.meta/say/post:*)",
      "Bash(.meta/say/move:*)",
      "Bash(.meta/say/commit:*)",
      "Bash(.meta/say/whoami)",
      "Bash(.meta/say/whoami:*)",
      "Bash(python3 .meta/check_pr.py:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh stack view:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.meta/hooks/signed_channel.py"
          }
        ]
      }
    ]
  }
}
