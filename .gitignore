__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# Tokens live outside the tree. Nothing here should ever hold one.
.env

# Gemini CLI scratch and settings.
.gemini/

# Virtual environments
.venv/

# APM installation runtime artifacts (stereorepo's DR-172)
apm.yml
# The portfolio's own package manifest is a render output the meta gate reads,
# so a checkout that has never rendered must already hold it.
!/.meta/apm.yml
apm.lock.yaml
# APM dependencies
apm_modules/

# Multi-harness compiled target directories (stereorepo's DR-172)
.agents/
.codex/


# The pair loop's runtime state and its worktree: the Issue underway, the turn
# log, each seat's output, and the checkout the seats work in.
.pair/
worktrees/
