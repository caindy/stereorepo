__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# The reviewer's scratch. `.github/workflows/review.yml` writes the pull
# request's diff, the head's version of the six paths it restores from trunk,
# and the constraints every agent reads here before the session starts, so a
# reviewer reads a path instead of paging a command's output. Ignored so that
# `git status` in that container stays the pull request's.
.review/

# Tokens live outside the tree — see .meta/say/channel.py, which reads
# ~/.config/solorepo/coder.env. Nothing here should ever hold one.
.env

# Gemini CLI scratch and settings.
.gemini/

# Virtual environments
.venv/

# APM installation runtime artifacts (solorepo's DR-172, solorepo's #430)
apm.yml
apm.lock.yaml
# APM dependencies
apm_modules/

# Multi-harness compiled target directories (solorepo's DR-172, solorepo's #430)
.agents/
.codex/

